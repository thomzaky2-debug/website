@model CatalogViewModel
@{ViewData["Title"] = Localizer["Nav_Shop"];}
<section class="hero"><div><span class="eyebrow">BubbleThemeShop / @Localizer["Nav_Shop"]</span><h1>@Localizer["Hero_Title"]</h1><p>@Localizer["Hero_Tag"]</p><a class="primary-button" href="#collection">@Localizer["Nav_Shop"] →</a></div><img src="/assets/img/slider/slider0.jpg" alt="@Localizer["Featured"]"/></section><section id="collection"><div class="section-head"><h2>@Localizer["Latest"]</h2><form method="get" class="search-form"><input name="q" value="@Model.Search" placeholder="@Localizer["Search"]" aria-label="@Localizer["Search"]" maxlength="100"/><select name="category" aria-label="@Localizer["Categories"]"><option value="">@Localizer["All"]</option>@foreach(var c in Model.Categories){<option value="@c.Slug" selected="@(Model.Category==c.Slug)">@c.Name</option>}</select><button class="primary-button">@Localizer["Search"]</button></form></div><div class="product-grid">@foreach(var p in Model.Products){<partial name="_ProductCard" model="p"/>}</div>@if(!Model.Products.Any()){<p class="empty">@Localizer["Empty"]</p>}<div class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Search" asp-route-category="@Model.Category">@Localizer["Previous"]</a>}@if(Model.Page<Model.TotalPages){<a asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Search" asp-route-category="@Model.Category">@Localizer["Next"]</a>}</div></section>@if(Model.Featured.Any()){<section><h2>@Localizer["Featured"]</h2><div class="product-grid">@foreach(var p in Model.Featured){<partial name="_ProductCard" model="p"/>}</div></section>}