@model LandingViewModel
@{ViewData["Title"] = Localizer["Nav_Home"];}
<section class="hero home-hero"><div><span class="eyebrow"><bdi>Chic &amp; Unique</bdi> · @Localizer["Home_Welcome"]</span><h1>@Localizer["Hero_Title"]</h1><p>@Localizer["Hero_Tag"]</p><a class="primary-button" asp-action="Shop">@Localizer["Explore_Collection"] →</a></div><img src="@Model.HeroImageUrl" alt="@Localizer["Featured"]" fetchpriority="high"/></section>
<partial name="_OffersStrip" />
<section class="home-category-section animate-on-scroll"><div class="section-head"><div><span class="eyebrow">@Localizer["Home_Discover"]</span><h2>@Localizer["Shop_By_Category"]</h2></div><a asp-action="Shop">@Localizer["View_Category"] →</a></div><div class="home-category-grid">@foreach(var group in Model.Categories){<a class="home-category-tile" asp-action="Shop" asp-route-category="@group.Category.Slug"><img src="@(group.Products.FirstOrDefault()?.ImageUrl??"/assets/img/product-placeholder.svg")" alt="" loading="lazy"/><div><strong>@group.Category.Name</strong><small>@group.Count @Localizer["Products"]</small></div></a>}</div></section>
<section class="animate-on-scroll"><div class="section-head"><div><span class="eyebrow"><bdi>Chic &amp; Unique</bdi> · @Localizer["Home_Picks"]</span><h2>@Localizer["Featured"]</h2></div><a asp-action="Shop">@Localizer["Nav_Shop"] →</a></div><div class="product-grid">@foreach(var product in Model.Featured){<partial name="_ProductCard" model="product"/>}</div></section>
<section class="animate-on-scroll"><div class="section-head"><div><h2>@Localizer["Latest"]</h2><p class="muted">@Localizer["Home_New_Arrivals"]</p></div><a asp-action="Shop" asp-route-sort="latest">@Localizer["View_Category"] →</a></div><div class="product-grid">@foreach(var product in Model.Latest){<partial name="_ProductCard" model="product"/>}</div></section>
<section class="recently-viewed-section" id="recentlyViewed" style="display:none"></section>
<div class="home-shop-invite panel"><div><h2>@Localizer["Home_Browse_Title"]</h2><p class="muted">@Localizer["Shop_Intro"]</p></div><a class="primary-button" asp-action="Shop">@Localizer["Nav_Shop"] →</a></div>
