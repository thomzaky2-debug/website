@model CatalogViewModel
@{ViewData["Title"] = Localizer["Nav_Shop"]; var selectedCategory=Model.Categories.FirstOrDefault(c=>c.Slug==Model.Category);}
<section id="collection" class="catalog-section"><div class="section-head"><div><h1>@(selectedCategory?.Name ?? Localizer[Model.GroupByCategory?"Shop_By_Category":"Latest"].Value)</h1></div></div><div class="catalog-toolbar"><nav class="category-browse-nav" aria-label="@Localizer["Categories"]"><a asp-controller="Home" asp-action="Shop" asp-fragment="collection" asp-route-q="@Model.Search" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="@Model.Sort" asp-route-inStock="@Model.InStock" aria-current="@(string.IsNullOrWhiteSpace(Model.Category)?"page":null)">@Localizer["All"]</a>@foreach(var item in Model.Categories){<a asp-controller="Home" asp-action="Shop" asp-route-category="@item.Slug" asp-route-q="@Model.Search" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="@Model.Sort" asp-route-inStock="@Model.InStock" asp-fragment="collection" aria-current="@(Model.Category==item.Slug?"page":null)">@item.Name</a>}</nav><form asp-controller="Home" asp-action="Shop" asp-fragment="collection" method="get" class="catalog-filters panel" data-async-form><div class="field search-field"><label for="catalog-search">@Localizer["Search"]</label><div class="search-input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="catalog-search" name="q" value="@Model.Search" placeholder="@Localizer["Search_Placeholder"]" maxlength="100" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggestions" data-suggest-url="@Url.Action("Suggestions","Home")"/><button type="button" class="search-clear" aria-label="@Localizer["Clear_Search"]" hidden>×</button></div><ul id="search-suggestions" role="listbox" aria-label="@Localizer["Search_Suggestions"]" hidden></ul><span class="sr-only" id="search-feedback" role="status" data-none="@Localizer["Search_No_Suggestions"]" data-found="@Localizer["Search_Suggestions"]"></span></div><input name="category" type="hidden" value="@Model.Category"/><div class="field price-range"><label>@Localizer["Price"] (EGP)</label><div><input name="minPrice" type="number" min="0" step="0.01" value="@Model.MinPrice" placeholder="@Localizer["Price_Min"]" aria-label="@Localizer["Price_Min"]"/><span>–</span><input name="maxPrice" type="number" min="0" step="0.01" value="@Model.MaxPrice" placeholder="@Localizer["Price_Max"]" aria-label="@Localizer["Price_Max"]"/></div></div><div class="field sort-field"><label for="catalog-sort">@Localizer["Sort"]</label><select id="catalog-sort" name="sort">@foreach(var option in new[]{"relevance","latest","price-low","price-high"}){<option value="@option" selected="@(Model.Sort==option)">@Localizer[option=="relevance"?"Sort_Relevance":option=="price-low"?"Sort_Low":option=="price-high"?"Sort_High":"Sort_Latest"]</option>}</select></div><label class="filter-check"><input type="checkbox" name="inStock" value="true" checked="@Model.InStock"/>@Localizer["Label_InStock"]</label><button class="primary-button">@Localizer["Search"]</button></form></div><div class="skeleton-grid" id="shopSkeletons" hidden><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>@if(Model.GroupByCategory){<div class="category-product-groups">@foreach(var group in Model.CategoryGroups){<section class="category-product-group animate-on-scroll"><div class="section-head"><div><h3>@group.Category.Name <span class="category-count">@group.Count</span></h3></div><a asp-controller="Home" asp-action="Shop" asp-route-category="@group.Category.Slug" asp-fragment="collection">@Localizer["View_Category"] →</a></div><div class="product-grid">@foreach(var product in group.Products){<partial name="_ProductCard" model="product"/>}</div>@if(group.Count==0){<p class="panel muted">@Localizer["Category_Empty"]</p>}</section>}</div>}else{<div class="search-results-meta"><p><strong>@Model.TotalMatches</strong> @Localizer["Search_Results"] @if(!string.IsNullOrWhiteSpace(Model.Search)){<span>· "@Model.Search"</span>}</p><a asp-controller="Home" asp-action="Shop" asp-fragment="collection">@Localizer["Reset_Filters"]</a></div><div class="product-grid">@foreach(var p in Model.Products){<partial name="_ProductCard" model="p"/>}</div>@if(!Model.Products.Any()){<div class="panel empty"><h3>@Localizer["Search_No_Results"]</h3><p>@Localizer["Search_Try_Again"]</p><a asp-controller="Home" asp-action="Shop" asp-fragment="collection">@Localizer["Reset_Filters"]</a></div>}<div class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Search" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="@Model.Sort" asp-route-inStock="@Model.InStock">@Localizer["Previous"]</a>}@if(Model.Page<Model.TotalPages){<a asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Search" asp-route-category="@Model.Category" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="@Model.Sort" asp-route-inStock="@Model.InStock">@Localizer["Next"]</a>}</div>}</section>
<section class="recently-viewed-section" id="recentlyViewed" style="display:none"></section>
