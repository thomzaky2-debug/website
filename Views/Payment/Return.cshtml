@model Order
@{ViewData["Title"] = Localizer["Payment_Check"]; var gateway=ViewData["GatewayStatus"] as string; var terminal=gateway is "EXPIRED" or "CANCELLED" or "FAILED"; var pending=Model.PaymentStatus=="Unpaid"; var cancelled=Model.Status==OrderStatuses.Cancelled;}
<div class="status-page"><span class="eyebrow">NileShop · @Localizer["Payment_Gateway"]</span><div class="status-card panel"><div class="status-icon @(Model.PaymentStatus=="Paid"?"is-paid":"")" aria-hidden="true">@(Model.PaymentStatus=="Paid"?"✓":"◷")</div><h1>@Localizer[Model.PaymentStatus=="Refunded"?"Refunded":Model.PaymentStatus=="Paid"?"Payment_Paid":cancelled?"Cancelled":"Payment_Pending"]</h1>@if(pending){<p class="muted">@Localizer[terminal||cancelled?"Payment_Expired":"Payment_Explain"]</p>}<div class="status-facts"><div><span>@Localizer["Orders"]</span><strong>@Model.OrderNumber</strong></div><div><span>@Localizer["Total"]</span><strong>@Model.TotalAmount.ToString("N2") EGP</strong></div><div><span>@Localizer["InstaPay_Username"]</span><strong dir="ltr">@Model.InstaPaySenderHandle</strong></div></div><div class="status-actions">@if(pending){if(!terminal&&Model.Status!=OrderStatuses.Cancelled){<form asp-action="Pay" method="post"><input type="hidden" name="token" value="@Model.PaymentAccessToken"/><button class="primary-button">@Localizer["Payment_Pay"]</button></form>}<form asp-action="Check" method="post"><input type="hidden" name="token" value="@Model.PaymentAccessToken"/><button>@Localizer["Payment_Check"]</button></form>}<a class="action-link" asp-controller="Orders" asp-action="Track" asp-route-token="@Model.PaymentAccessToken">@Localizer["Track_Order"]</a></div><a asp-controller="Home" asp-action="Shop">← @Localizer["Nav_Shop"]</a></div></div>
@if(Model.PaymentStatus=="Unpaid"&&!terminal&&!cancelled){<form id="payment-status-form" asp-action="Status" method="post" hidden><input type="hidden" name="token" value="@Model.PaymentAccessToken"/></form>}
