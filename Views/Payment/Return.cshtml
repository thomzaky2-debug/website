@model Order
@{
    ViewData["Title"] = Localizer["Payment_Check"];
    var gateway = ViewData["GatewayStatus"] as string;
    var terminal = gateway is "EXPIRED" or "CANCELLED" or "FAILED";
    var pending = Model.PaymentStatus == "Unpaid";
    var settled = Model.PaymentStatus is "Paid" or "Overpaid";
    var isOverpaid = Model.PaymentStatus == "Overpaid";
    var isUnderpaid = Model.PaymentStatus == "Underpaid";
    var cancelled = Model.Status == OrderStatuses.Cancelled;
    var remainingSeconds = (int)(ViewData["RemainingSeconds"] ?? 0);
    var expiresAt = ViewData["ExpiresAt"] as string ?? "";
    var lifetimeMinutes = (int)(ViewData["LifetimeMinutes"] ?? 15);
    var excessCredited = isOverpaid && Model.DetectedAmountEgp.HasValue
        ? Math.Max(0m, Model.DetectedAmountEgp.Value - Model.PayableAmount)
        : 0m;
}
<div class="status-page">
    <span class="eyebrow">Chic & Unique · @Localizer["Payment_Heading"]</span>
    <div class="status-card panel">
        <div class="status-icon @(settled ? "is-paid" : "")" aria-hidden="true">@(settled ? "✓" : isUnderpaid ? "!" : "◷")</div>
        <h1>@Localizer[Model.PaymentStatus == "Refunded" ? "Refunded" : isOverpaid ? "Payment_Overpaid_Title" : Model.PaymentStatus == "Paid" ? "Payment_Paid" : isUnderpaid ? "Payment_Underpaid_Title" : gateway=="EXPIRED" ? "Order_Payment_Expired" : gateway=="CANCELLED" ? "Order_Payment_Cancelled" : gateway=="FAILED" ? "Order_Payment_Failed" : cancelled ? "Cancelled" : "Payment_Pending"]</h1>
        
        @if (isOverpaid)
        {
            <p class="muted">@Localizer["Payment_Overpaid_Note"]</p>
        }
        else if (isUnderpaid)
        {
            <p class="muted">@Localizer["Payment_Underpaid_Note"]</p>
        }
        else if (pending)
        {
            <p class="muted">@Localizer[terminal || cancelled ? "Payment_Expired" : "Payment_Explain"]</p>
        }

        @if (pending && !terminal && !cancelled)
        {
            var initMins = remainingSeconds / 60;
            var initSecs = remainingSeconds % 60;
            var initDisplay = remainingSeconds > 0 ? $"{(initMins < 10 ? "0" : "")}{initMins}:{(initSecs < 10 ? "0" : "")}{initSecs}" : "00:00";
            var initPct = lifetimeMinutes > 0 ? Math.Max(0, Math.Min(100, (remainingSeconds / (double)(lifetimeMinutes * 60)) * 100)) : 0;
            <div class="session-timer-card" id="sessionTimerWrap" data-remaining="@remainingSeconds" data-total="@(lifetimeMinutes * 60)" data-expired-text="@Localizer["Payment_Session_Expired"]">
                <div class="timer-dial">
                    <span class="timer-pulse-dot" id="timerPulse" aria-hidden="true" style="@(remainingSeconds <= 0 ? "display:none;" : "")"></span>
                    <div class="timer-content">
                        <span class="timer-label" id="timerLabel">@Localizer[remainingSeconds <= 0 ? "Payment_Session_Expired" : "Payment_Session_Expires_In"]</span>
                        <strong class="timer-digits @(remainingSeconds <= 0 ? "is-expired" : "")" id="timerDigits">@initDisplay</strong>
                    </div>
                </div>
                <div class="timer-progress-bar">
                    <div class="timer-progress-fill" id="timerBar" style="width: @(initPct.ToString("0.##", CultureInfo.InvariantCulture))%;"></div>
                </div>
            </div>
        }

        <div class="status-facts">
            <div><span>@Localizer["Orders"]</span><strong dir="ltr">@Model.OrderNumber</strong></div>
            <div><span>@Localizer["Total"]</span><strong>@Model.TotalAmount.ToString("N2") EGP</strong></div>
            @if (Model.WalletAmountUsed > 0)
            {
                <div><span>@Localizer["Wallet_Credit_Applied"]</span><strong>−@Model.WalletAmountUsed.ToString("N2") EGP</strong></div>
                <div><span>@Localizer["Remaining_To_Pay"]</span><strong>@Model.PayableAmount.ToString("N2") EGP</strong></div>
            }
            @if (Model.DetectedAmountEgp.HasValue && (isOverpaid || isUnderpaid))
            {
                <div><span>@Localizer["Detected_Transfer"]</span><strong>@Model.DetectedAmountEgp.Value.ToString("N2") EGP</strong></div>
            }
            @if (isOverpaid && excessCredited > 0)
            {
                <div class="wallet-credit-fact"><span>@Localizer["Credited_To_Wallet"]</span><strong>+@excessCredited.ToString("N2") EGP</strong></div>
            }
            @if (isUnderpaid && Model.DetectedAmountEgp.HasValue)
            {
                <div class="wallet-credit-fact"><span>@Localizer["Credited_To_Wallet"]</span><strong>+@Model.DetectedAmountEgp.Value.ToString("N2") EGP</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.InstaPaySenderHandle))
            {
                <div><span>@Localizer["InstaPay_Username"]</span><strong dir="ltr">@Model.InstaPaySenderHandle</strong></div>
            }
        </div>

        @if (pending && !terminal && !cancelled && !string.IsNullOrWhiteSpace(Model.InstaPaySenderHandle))
        {
            <div class="transfer-reference-panel panel">
                <h4>@Localizer["Payment_Instructions"]</h4>
                <div class="reference-fields">
                    <div class="ref-field">
                        <span>@Localizer["InstaPay_Username"] (From)</span>
                        <strong dir="ltr">@Model.InstaPaySenderHandle</strong>
                    </div>
                    <div class="ref-field">
                        <span>@Localizer["Reference_Note"]</span>
                        <div class="copy-input-group">
                            <code dir="ltr" id="orderRefCode">Order #@Model.OrderNumber</code>
                            <button type="button" class="btn-copy-sm" id="btnCopyRef" data-copy-text="Order #@Model.OrderNumber" data-copied-text="@Localizer["Copied"]">@Localizer["Copy"]</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.Items.Count > 0)
        {
            <div class="order-items-preview panel">
                <h3>@Localizer["Order_Items"]</h3>
                <div class="order-items-list">
                    @foreach(var item in Model.Items)
                    {
                        <div class="order-item-row">
                            <div class="item-meta">
                                <strong>@item.ProductName</strong>
                                @if(!string.IsNullOrWhiteSpace(item.SelectedSize) || !string.IsNullOrWhiteSpace(item.SelectedColor))
                                {
                                    <small class="muted">@item.SelectedSize @item.SelectedColor</small>
                                }
                            </div>
                            <div class="item-qty-price">
                                <span class="muted">×@item.Quantity</span>
                                <strong>@((item.UnitPrice * item.Quantity).ToString("N2")) EGP</strong>
                            </div>
                        </div>
                    }
                </div>
                <div class="order-subtotals">
                    <div class="subtotal-row"><span>@Localizer["Subtotal"]</span><strong>@((Model.TotalAmount - Model.ShippingFee + Model.DiscountAmount).ToString("N2")) EGP</strong></div>
@if(Model.DiscountAmount>0){<div class="subtotal-row"><span>@Localizer["Order_Discount"]</span><strong>−@Model.DiscountAmount.ToString("N2") EGP</strong></div>}
                    <div class="subtotal-row"><span>@Localizer["Shipping_Fee"] (@Model.ShippingMethodName)</span><strong>@Model.ShippingFee.ToString("N2") EGP</strong></div>
                    @if (Model.WalletAmountUsed > 0)
                    {
                        <div class="subtotal-row wallet"><span>@Localizer["Wallet_Credit_Applied"]</span><strong>−@Model.WalletAmountUsed.ToString("N2") EGP</strong></div>
                    }
                    <div class="subtotal-row total"><span>@Localizer["Total"]</span><strong>@Model.PayableAmount.ToString("N2") EGP</strong></div>
                </div>
            </div>
        }

        <div class="status-actions">
            @if (pending)
            {
                if (!terminal && Model.Status != OrderStatuses.Cancelled)
                {
                    <form asp-action="Pay" method="post"><input type="hidden" name="token" value="@Model.PaymentAccessToken"/><button class="primary-button">@Localizer["Payment_Pay"]</button></form>
                }
                <form asp-action="Check" method="post" data-async-form><input type="hidden" name="token" value="@Model.PaymentAccessToken"/><button>@Localizer["Payment_Check"]</button></form>
            }
            @if ((isOverpaid || isUnderpaid) && !string.IsNullOrWhiteSpace(Model.CustomerUserId))
            {
                <a class="primary-button" asp-controller="Account" asp-action="Wallet">@Localizer["View_Wallet"] →</a>
            }
            <a class="action-link" asp-controller="Orders" asp-action="Track" asp-route-token="@Model.PaymentAccessToken">@Localizer["Track_Order"]</a>
        </div>
        <a asp-controller="Home" asp-action="Shop">← @Localizer["Nav_Shop"]</a>
    </div>
</div>

@if (Model.PaymentStatus == "Unpaid" && !terminal && !cancelled)
{
    <form id="payment-status-form" asp-action="Status" method="post" hidden><input type="hidden" name="token" value="@Model.PaymentAccessToken"/></form>
}