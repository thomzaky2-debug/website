@model Order
@{
    ViewData["Title"] = Localizer["Payment_Check"];
    var gateway = ViewData["GatewayStatus"] as string;
    var terminal = gateway is "EXPIRED" or "CANCELLED" or "FAILED";
    var pending = Model.PaymentStatus == "Unpaid";
    var settled = Model.PaymentStatus is "Paid" or "Overpaid";
    var isOverpaid = Model.PaymentStatus == "Overpaid";
    var isUnderpaid = Model.PaymentStatus == "Underpaid";
    var cancelled = Model.Status == OrderStatuses.Cancelled;
    var excessCredited = isOverpaid && Model.DetectedAmountEgp.HasValue
        ? Math.Max(0m, Model.DetectedAmountEgp.Value - Model.PayableAmount)
        : 0m;
}
<div class="status-page">
    <span class="eyebrow">NileShop · @Localizer["Payment_Gateway"]</span>
    <div class="status-card panel">
        <div class="status-icon @(settled ? "is-paid" : "")" aria-hidden="true">@(settled ? "✓" : isUnderpaid ? "!" : "◷")</div>
        <h1>@Localizer[Model.PaymentStatus == "Refunded" ? "Refunded" : isOverpaid ? "Payment_Overpaid_Title" : Model.PaymentStatus == "Paid" ? "Payment_Paid" : isUnderpaid ? "Payment_Underpaid_Title" : cancelled ? "Cancelled" : gateway=="EXPIRED" ? "Order_Payment_Expired" : gateway=="CANCELLED" ? "Order_Payment_Cancelled" : gateway=="FAILED" ? "Order_Payment_Failed" : "Payment_Pending"]</h1>
        @if (isOverpaid)
        {
            <p class="muted">@Localizer["Payment_Overpaid_Note"]</p>
        }
        else if (isUnderpaid)
        {
            <p class="muted">@Localizer["Payment_Underpaid_Note"]</p>
        }
        else if (pending)
        {
            <p class="muted">@Localizer[terminal || cancelled ? "Payment_Expired" : "Payment_Explain"]</p>
        }

        <div class="status-facts">
            <div><span>@Localizer["Orders"]</span><strong>@Model.OrderNumber</strong></div>
            <div><span>@Localizer["Total"]</span><strong>@Model.TotalAmount.ToString("N2") EGP</strong></div>
            @if (Model.WalletAmountUsed > 0)
            {
                <div><span>@Localizer["Wallet_Credit_Applied"]</span><strong>−@Model.WalletAmountUsed.ToString("N2") EGP</strong></div>
                <div><span>@Localizer["Remaining_To_Pay"]</span><strong>@Model.PayableAmount.ToString("N2") EGP</strong></div>
            }
            @if (Model.DetectedAmountEgp.HasValue && (isOverpaid || isUnderpaid))
            {
                <div><span>@Localizer["Detected_Transfer"]</span><strong>@Model.DetectedAmountEgp.Value.ToString("N2") EGP</strong></div>
            }
            @if (isOverpaid && excessCredited > 0)
            {
                <div class="wallet-credit-fact"><span>@Localizer["Credited_To_Wallet"]</span><strong>+@excessCredited.ToString("N2") EGP</strong></div>
            }
            @if (isUnderpaid && Model.DetectedAmountEgp.HasValue)
            {
                <div class="wallet-credit-fact"><span>@Localizer["Credited_To_Wallet"]</span><strong>+@Model.DetectedAmountEgp.Value.ToString("N2") EGP</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.InstaPaySenderHandle))
            {
                <div><span>@Localizer["InstaPay_Username"]</span><strong dir="ltr">@Model.InstaPaySenderHandle</strong></div>
            }
        </div>

        <div class="status-actions">
            @if (pending)
            {
                if (!terminal && Model.Status != OrderStatuses.Cancelled)
                {
                    <form asp-action="Pay" method="post"><input type="hidden" name="token" value="@Model.PaymentAccessToken"/><button class="primary-button">@Localizer["Payment_Pay"]</button></form>
                }
                <form asp-action="Check" method="post" data-async-form><input type="hidden" name="token" value="@Model.PaymentAccessToken"/><button>@Localizer["Payment_Check"]</button></form>
            }
            @if ((isOverpaid || isUnderpaid) && !string.IsNullOrWhiteSpace(Model.CustomerUserId))
            {
                <a class="primary-button" asp-controller="Account" asp-action="Wallet">@Localizer["View_Wallet"] →</a>
            }
            <a class="action-link" asp-controller="Orders" asp-action="Track" asp-route-token="@Model.PaymentAccessToken">@Localizer["Track_Order"]</a>
        </div>
        <a asp-controller="Home" asp-action="Shop">← @Localizer["Nav_Shop"]</a>
    </div>
</div>
@if (Model.PaymentStatus == "Unpaid" && !terminal && !cancelled)
{
    <form id="payment-status-form" asp-action="Status" method="post" hidden><input type="hidden" name="token" value="@Model.PaymentAccessToken"/></form>
}
