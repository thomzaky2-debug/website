@model Order
@{ViewData["Title"] = Localizer["Track_Order"];}
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Orders"]</span><h1>@Localizer["Track_Order"]</h1><p class="muted">@Model.OrderNumber</p></div><a asp-controller="Home" asp-action="Shop">← @Localizer["Nav_Shop"]</a></div>
<div class="tracking-layout"><div><section class="panel"><h2>@Localizer["Status"]</h2><div class="order-state-strip"><span class="status-pill @(OrderStatusPresentation.IsWarning(Model)?"off":"")">@Localizer[OrderStatusPresentation.Key(Model)]</span><span class="status-pill @(Model.PaymentStatus is "Unpaid" or "Underpaid"?"off":"")">@Localizer[Model.PaymentStatus]</span></div><ol class="timeline">@foreach(var update in Model.Updates.OrderBy(u=>u.CreatedAt)){<li><strong>@Localizer[update.Status]</strong><time>@update.CreatedAt.ToString("g")</time></li>}</ol>@if(!string.IsNullOrEmpty(Model.TrackingNumber)){<div class="tracking-carrier"><strong>@Localizer["Carrier"]: @Model.Carrier</strong><p>@Localizer["Tracking_Number"]: @Model.TrackingNumber</p>@if(!string.IsNullOrEmpty(Model.TrackingUrl)){<a href="@Model.TrackingUrl" rel="noreferrer noopener" target="_blank">@Localizer["Carrier_Tracking"] ↗</a>}</div>}</section><section class="panel"><h2>@Localizer["Orders"]</h2><div class="order-items">@foreach(var item in Model.Items){<div><span>@item.ProductName <small>@item.SelectedSize @item.SelectedColor · ×@item.Quantity</small></span><strong>@((item.UnitPrice*item.Quantity).ToString("N2")) EGP</strong></div>}</div></section></div><aside class="panel"><h2>@Localizer["Order_Summary"]</h2><div class="order-total-row"><span>@Localizer["Shipping_Area"]</span><strong>@Model.ShippingMethodName</strong></div><div class="order-total-row"><span>@Localizer["Shipping_Fee"]</span><strong>@Model.ShippingFee.ToString("N2") EGP</strong></div>@if(Model.WalletAmountUsed>0){<div class="order-total-row"><span>@Localizer["Wallet_Credit_Applied"]</span><strong>−@Model.WalletAmountUsed.ToString("N2") EGP</strong></div>}<div class="order-total-row"><span>@Localizer["Business_Days"]</span><strong>@Model.DeliveryMinDays–@Model.DeliveryMaxDays</strong></div><div class="order-total-row grand"><span>@Localizer["Total"]</span><strong>@Model.TotalAmount.ToString("N2") EGP</strong></div><a class="action-link" asp-controller="Payment" asp-action="Return" asp-route-token="@Model.PaymentAccessToken">@Localizer["Payment_Check"]</a></aside></div>
