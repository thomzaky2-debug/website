@{ViewData["Title"] = Localizer["Track_Order"];}
<div class="status-page"><span class="eyebrow">Chic & Unique · @Localizer["Orders"]</span><section class="panel status-card tracking-find"><div class="store-empty-icon"><partial name="_StoreIcon" model='@("delivery")'/></div><h1>@Localizer["Track_Order"]</h1><p class="muted">@Localizer["Track_Link_Help"]</p><form asp-action="Track" method="get" class="field" data-async-form><label for="token">@Localizer["Private_Token"]</label><input id="token" name="token" required minlength="64" maxlength="64" pattern="[a-fA-F0-9]{64}" autocomplete="off" autocapitalize="none" spellcheck="false" dir="ltr"/><button class="primary-button">@Localizer["Track_Order"]</button></form></section></div>

<partial name="_StoreSupport"/>
