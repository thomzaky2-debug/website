@model List<ClientNotification>
@{ var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"; ViewData["Title"] = Localizer["Notifications"]; var read = (List<int>)ViewBag.ReadIds; int page = ViewBag.Page; }
<section class="notification-section">
<header class="notification-head">
    <p class="notification-eyebrow">@(ar ? "شيك آند يونيك · حسابي" : "CHIC & UNIQUE · ACCOUNT")</p>
    <h1>@Localizer["Notifications"]</h1>
    <p class="notification-sub">@(ar ? "رسائل المتجر وتحديثات طلباتك في مكان واحد." : "Store messages and order updates in one place.")</p>
</header>
@if(Model.Count == 0){
<div class="notification-empty">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
    <p>@(ar ? "لا توجد إشعارات حتى الآن." : "You're all caught up.")</p>
    <small>@(ar ? "رسائل المتجر الجديدة هتظهر هنا." : "New store messages will appear here.")</small>
</div>}
<div class="notification-list">
@foreach(var item in Model.Take(20)){
<article class="notification-card @(read.Contains(item.Id) ? "is-read" : "is-unread")">
<div class="notification-card-head">
    <h2>@item.Title</h2>
    @if(!read.Contains(item.Id)){<span class="notification-new">@(ar ? "جديد" : "New")</span>}
    <time dir="ltr" datetime="@DateTime.SpecifyKind(item.CreatedAt, DateTimeKind.Utc).ToString("o")">@CairoTime.Fmt(item.CreatedAt, "dd/MM/yyyy HH:mm")</time>
</div>
<p class="notification-body">@item.Body</p>
@if(!read.Contains(item.Id)) {<form action="/Account/Notifications/Read" method="post" data-notification-read class="notification-read-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><button type="submit" class="notification-read-btn">@(ar ? "تحديد كمقروء" : "Mark as read")</button><span role="status" class="notification-read-status"></span></form>}
</article>
}
</div>
<nav class="notification-pagination" aria-label="@(ar ? "الصفحات" : "Pages")">
@if(page > 1){<a href="?page=@(page - 1)">@(ar ? "السابق" : "Previous")</a>}
@if(Model.Count > 20){<a href="?page=@(page + 1)">@(ar ? "التالي" : "Next")</a>}
</nav>
</section>
