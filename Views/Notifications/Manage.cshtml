@model ComposeNotification
@{var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"; ViewData["Title"] = Localizer["Notifications"];}
<section class="notification-section notification-admin">
<header><p class="notification-eyebrow">@(ar ? "تواصل مع عملائك" : "CUSTOMER MESSAGES")</p><h1>@Localizer["Notifications"]</h1><p>@(ar ? "اختر المستلم، اكتب رسالتك، ثم أرسلها إلى صندوق إشعاراته." : "Choose your audience, write a message, and send it to their inbox.")</p></header>
<div class="notification-workspace">
<form action="/Admin/Notifications" method="post" class="notification-card notification-compose" data-notification-compose>
@Html.AntiForgeryToken()
<div asp-validation-summary="All" role="alert"></div><input asp-for="SendKey" type="hidden"/>
<fieldset><legend>1 · @(ar ? "إلى من؟" : "Who is this for?")</legend>
<div class="notification-audiences">
<label><input asp-for="Audience" type="radio" value="customer"/> <span>@(ar ? "اختر عميلاً" : "Choose a customer")<small>@(ar ? "رسالة خاصة لعميل واحد" : "A private message to one person")</small></span></label>
<label><input asp-for="Audience" type="radio" value="everyone"/> <span>@(ar ? "جميع العملاء" : "Everyone")<small>@(ar ? "إعلان لجميع العملاء" : "An announcement for all customers")</small></span></label>
</div>
<div data-customer-picker>
<label for="customer-search">@(ar ? "البحث بالاسم أو البريد الإلكتروني" : "Find by name or email")</label>
<input id="customer-search" type="search" maxlength="100" autocomplete="off" placeholder="@(ar ? "ابدأ كتابة اسم العميل…" : "Start typing a customer's name…")" aria-controls="customer-results"/>
<div id="customer-results" class="notification-results" aria-live="polite"></div>
<label asp-for="RecipientEmail">@(ar ? "العميل المختار" : "Selected customer")</label><input asp-for="RecipientEmail" type="email" maxlength="254" placeholder="@(ar ? "اختر نتيجة أو أدخل البريد" : "Choose a result or enter an email")"/>
</div>
<p data-broadcast-note hidden>@(ar ? "سيظهر هذا الإعلان لجميع العملاء، بما في ذلك الحسابات الجديدة." : "This announcement will be visible to everyone, including future customers.")</p>
</fieldset>
<fieldset><legend>2 · @(ar ? "رسالتك" : "Your message")</legend>
<label asp-for="Title">@(ar ? "العنوان" : "Title")</label><input asp-for="Title" maxlength="160" required placeholder="@(ar ? "مثال: وصلت مجموعتنا الجديدة" : "For example, our new collection is here")"/>
<label asp-for="Body">@(ar ? "الرسالة" : "Message")</label><textarea asp-for="Body" maxlength="2000" rows="5" required placeholder="@(ar ? "ما الذي تود إخبار عميلك به؟" : "What would you like your customer to know?")"></textarea><small data-message-count>0 / 2000</small>
</fieldset>
<button type="submit" class="notification-send">@(ar ? "إرسال الإشعار" : "Send notification")</button>
</form>
<aside class="notification-card notification-preview"><p class="notification-eyebrow">@(ar ? "معاينة مباشرة" : "LIVE PREVIEW")</p><p data-preview-recipient>@(ar ? "اختر المستلم" : "Choose a recipient")</p><h2 data-preview-title>@(ar ? "عنوان الإشعار" : "Your notification title")</h2><p class="notification-body" data-preview-body>@(ar ? "ستظهر رسالتك هنا أثناء الكتابة." : "Your message will appear here as you type.")</p><small>@(ar ? "إشعار داخل الموقع" : "Delivered to the website inbox")</small></aside>
</div>
<h2>@(ar ? "آخر الإشعارات المرسلة" : "Recently sent")</h2>
@if(((List<ClientNotification>)ViewBag.History).Count > 0){<div class="notification-history-toolbar"><input id="notification-history-search" type="search" maxlength="100" placeholder="@(ar ? "ابحث في الإشعارات…" : "Search notifications…")" aria-label="@(ar ? "ابحث في الإشعارات" : "Search notifications")"/><div class="notification-chips" role="group" aria-label="@(ar ? "تصفية حسب الجمهور" : "Filter by audience")"><button type="button" class="notification-chip is-active" data-audience-filter="all">@(ar ? "الكل" : "All")</button><button type="button" class="notification-chip" data-audience-filter="everyone">@(ar ? "جميع العملاء" : "Everyone")</button><button type="button" class="notification-chip" data-audience-filter="customer">@(ar ? "رسائل خاصة" : "Private")</button></div></div>
<p class="notification-empty-filter" hidden data-empty-filter>@(ar ? "لا توجد نتائج مطابقة." : "No matching notifications.")</p>}
@if(((List<ClientNotification>)ViewBag.History).Count == 0){<p>@(ar ? "لم ترسل أي إشعارات بعد." : "No messages sent yet. Your sent messages will appear here.")</p>}
@{var readCounts = (Dictionary<int, int>)ViewBag.ReadCounts; var customerCount = (int)ViewBag.CustomerCount;}
@foreach(var item in (List<ClientNotification>)ViewBag.History){var reads = readCounts.GetValueOrDefault(item.Id); var audienceKind = item.RecipientId == null ? "everyone" : "customer";<article class="notification-card" data-audience="@audienceKind" data-search="@((item.Title + " " + item.Body).ToLowerInvariant())"><h3>@item.Title</h3><small>@(item.RecipientId == null ? (ar ? "جميع العملاء" : "Everyone") : (((Dictionary<string, string>)ViewBag.Recipients).GetValueOrDefault(item.RecipientId) ?? (ar ? "رسالة خاصة" : "Private message"))) · <bdi dir="ltr">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC</bdi></small><p class="notification-body">@item.Body</p><p class="notification-stats">@(item.RecipientId == null ? (ar ? $"قرأها {reads} من أصل {customerCount} عميل" : $"Read by {reads} of {customerCount} customers") : (reads > 0 ? (ar ? "قرأها العميل" : "Read by the customer") : (ar ? "لم تُقرأ بعد" : "Unread")))</p><div class="notification-actions"><a class="notification-action-link" href="/Admin/Notifications?audience=@audienceKind&title=@Uri.EscapeDataString(item.Title)&body=@Uri.EscapeDataString(item.Body)">@(ar ? "إعادة الإرسال" : "Resend")</a><form action="/Admin/Notifications/Delete" method="post" onsubmit="return confirm('@(ar ? "حذف هذا الإشعار نهائياً؟" : "Delete this notification permanently?")');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><button type="submit" class="notification-danger-btn">@(ar ? "حذف" : "Delete")</button></form></div></article>}
<script nonce="@Context.Items["CspNonce"]">
(function(){
  var search = document.getElementById('notification-history-search');
  if (!search) return;
  var chips = Array.prototype.slice.call(document.querySelectorAll('[data-audience-filter]'));
  var cards = Array.prototype.slice.call(document.querySelectorAll('article[data-audience]'));
  var empty = document.querySelector('[data-empty-filter]');
  var audience = 'all';
  function apply(){
    var q = search.value.trim().toLowerCase();
    var shown = 0;
    cards.forEach(function(card){
      var ok = (audience === 'all' || card.getAttribute('data-audience') === audience) && (!q || card.getAttribute('data-search').indexOf(q) !== -1);
      card.hidden = !ok;
      if (ok) shown++;
    });
    if (empty) empty.hidden = shown !== 0;
  }
  search.addEventListener('input', apply);
  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      audience = chip.getAttribute('data-audience-filter');
      chips.forEach(function(c){ c.classList.toggle('is-active', c === chip); });
      apply();
    });
  });
})();
</script>
</section>
