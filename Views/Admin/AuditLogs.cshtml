@model AdminAuditViewModel
@{ViewData["Title"]=Localizer["Logs"];}
<section id="logs" class="admin-section"><div class="section-head"><div><span class="eyebrow">@Localizer["Nav_Dashboard"]</span><h1>@Localizer["Logs"]</h1></div><form asp-action="ClearOldLogs" method="post" data-confirm data-async-form><button>@Localizer["ClearLogs"]</button></form></div><div class="panel"><form method="get" class="operation-filters" data-async-form><div class="field"><label for="audit-query">@Localizer["FilterLogs"]</label><input id="audit-query" name="q" value="@Model.Search" maxlength="100" placeholder="@Localizer["FilterLogs"]"/></div><button class="primary-button">@Localizer["FilterLogs"]</button></form><div tabindex="0" role="region" aria-label="@Localizer["Scrollable_Table"]" class="table-scroll admin-data-table"><table id="audit-table"><thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Email"]</th><th>@Localizer["Actions"]</th><th>@Localizer["Details"]</th></tr></thead><tbody>@foreach(var l in Model.Logs){<tr><td>@l.Timestamp.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture)</td><td>@l.UserEmail</td><td>@l.Action</td><td>@l.Details</td></tr>}</tbody></table></div></div></section>
<div class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Search">@Localizer["Previous"]</a>}@if(Model.Page<Model.TotalPages){<a asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Search">@Localizer["Next"]</a>}</div>
