@model ProductFormViewModel
<input asp-for="Id" type="hidden"/><input asp-for="OriginalStockQuantity" type="hidden"/>
<div asp-validation-summary="All" class="validation"></div>
<div class="product-editor-columns">
<div class="editor-main-column">
<section class="editor-section editor-basics"><h2>@Localizer["Product_Basics"]</h2><div class="editor-grid"><div class="field"><label asp-for="Slug">@Localizer["Slug"]</label><input asp-for="Slug"/><span asp-validation-for="Slug"></span></div><div class="field"><label asp-for="CategoryId">@Localizer["CategoryId"]</label><select asp-for="CategoryId">@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select><span asp-validation-for="CategoryId"></span></div><div class="field"><label asp-for="Price">@Localizer["Price"] (EGP)</label><input asp-for="Price" type="number" step="0.01" min="0"/><span asp-validation-for="Price"></span></div><div class="field"><label asp-for="OldPrice">@Localizer["OldPrice"] (EGP)</label><input asp-for="OldPrice" type="number" step="0.01" min="0"/><span asp-validation-for="OldPrice"></span></div><div class="field"><label asp-for="StockQuantity">@Localizer["StockQuantity"]</label><input asp-for="StockQuantity" type="number" min="0"/><span asp-validation-for="StockQuantity"></span></div></div></section>
<section class="editor-section editor-content"><h2>@Localizer["Product_Content"]</h2><div class="bilingual"><fieldset dir="ltr"><legend>English</legend><div class="field"><label asp-for="NameEn">@Localizer["NameEn"]</label><input asp-for="NameEn"/><span asp-validation-for="NameEn"></span></div><div class="field"><label asp-for="ShortDescriptionEn">@Localizer["ShortDescriptionEn"]</label><textarea asp-for="ShortDescriptionEn" rows="3"></textarea><span asp-validation-for="ShortDescriptionEn"></span></div><div class="field"><label asp-for="FullDescriptionEn">@Localizer["FullDescriptionEn"]</label><textarea asp-for="FullDescriptionEn" rows="6"></textarea><span asp-validation-for="FullDescriptionEn"></span></div></fieldset><fieldset dir="rtl"><legend>العربية</legend><div class="field"><label asp-for="NameAr">@Localizer["NameAr"]</label><input asp-for="NameAr"/><span asp-validation-for="NameAr"></span></div><div class="field"><label asp-for="ShortDescriptionAr">@Localizer["ShortDescriptionAr"]</label><textarea asp-for="ShortDescriptionAr" rows="3"></textarea><span asp-validation-for="ShortDescriptionAr"></span></div><div class="field"><label asp-for="FullDescriptionAr">@Localizer["FullDescriptionAr"]</label><textarea asp-for="FullDescriptionAr" rows="6"></textarea><span asp-validation-for="FullDescriptionAr"></span></div></fieldset></div></section>
</div>
<aside class="editor-side-column">
<section class="editor-section editor-media"><h2>@Localizer["Product_Images"]</h2><div class="editor-image-preview"><img id="product-editor-preview" src="@Model.ImageUrl" data-saved-src="@Model.ImageUrl" alt="@Localizer["Product_Images"]" hidden="@(string.IsNullOrWhiteSpace(Model.ImageUrl))"/><span id="product-editor-empty" hidden="@(!string.IsNullOrWhiteSpace(Model.ImageUrl))">@Localizer["No_Product_Image"]</span></div><div class="editor-grid"><div class="field"><label asp-for="Uploads">@Localizer["Images_Upload"]</label><input asp-for="Uploads" type="file" multiple accept="image/jpeg,image/png,image/webp"/><small>@Localizer["Images_Help"]</small><span asp-validation-for="Uploads"></span></div><label class="editor-check wide"><input asp-for="ReplacePrimaryImage"/> @Localizer["Use_Upload_As_Main"]</label><details class="editor-advanced wide" open="@((ViewData.ModelState[nameof(Model.ImageUrl)]?.Errors.Count ?? 0)>0 || (ViewData.ModelState[nameof(Model.GalleryImages)]?.Errors.Count ?? 0)>0)"><summary>@Localizer["Image_Advanced"]</summary><div class="field"><label asp-for="ImageUrl">@Localizer["ImageUrl"]</label><input asp-for="ImageUrl"/><span asp-validation-for="ImageUrl"></span></div><div class="field"><label asp-for="GalleryImages">@Localizer["Images_Gallery"]</label><textarea asp-for="GalleryImages" rows="2"></textarea><span asp-validation-for="GalleryImages"></span></div></details></div></section>
<section class="editor-section editor-options"><h2>@Localizer["Product_Options"]</h2><p class="muted">@Localizer["Options_Help"]</p><div class="editor-grid"><div class="field"><label asp-for="Sizes">@Localizer["Options_Sizes"]</label><input asp-for="Sizes" placeholder="S, M, L"/></div><div class="field"><label asp-for="Colors">@Localizer["Options_Colors"]</label><input asp-for="Colors" placeholder="Blue, White"/></div></div></section>
<section class="editor-section editor-visibility"><h2>@Localizer["Visibility"]</h2><label class="editor-check"><input asp-for="IsActive"/> @Localizer["IsActive"]</label><label class="editor-check"><input asp-for="IsFeatured"/> @Localizer["IsFeatured"]</label></section>
</aside>
</div>
<div class="editor-actions"><button class="primary-button">@Localizer["Save"]</button><a asp-action="Dashboard">@Localizer["Cancel"]</a></div>
