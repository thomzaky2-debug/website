@model DashboardViewModel
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Admin_Navigation"]</span><h1>@Localizer["Nav_Dashboard"]</h1><p class="muted">@Localizer["Dashboard_Intro"]</p></div><a class="primary-button" asp-action="CreateProduct">+ @Localizer["CreateProduct"]</a></div><div class="admin-shortcuts"><a asp-controller="StoreAdmin" asp-action="Index"><strong>@Localizer["Operations"]</strong><small>@Localizer["Shortcut_Orders"]</small></a><a asp-controller="StoreAdmin" asp-action="Settings"><strong>@Localizer["Store_Settings"]</strong><small>@Localizer["Shortcut_Settings"]</small></a><a asp-controller="StoreAdmin" asp-action="Reports"><strong>@Localizer["Sales_Reports"]</strong><small>@Localizer["Shortcut_Reports"]</small></a></div><div class="kpis">@foreach(var k in new[]{("Revenue",Model.Revenue.ToString("N2")+" EGP"),("Orders",Model.TotalOrders.ToString()),("Products",Model.ActiveProducts.ToString()),("LowStock",Model.LowStock.ToString()),("Logs",Model.TotalLogs.ToString())}){<div class="panel"><small>@Localizer[k.Item1]</small><h2>@k.Item2</h2></div>}</div><nav class="tabs"><a href="#products">@Localizer["Products"]</a><a href="#categories">@Localizer["Categories"]</a><a href="#orders">@Localizer["Orders"]</a><a href="#logs">@Localizer["Logs"]</a></nav>
<section id="products" class="admin-section"><div class="section-head"><div><span class="eyebrow">@Localizer["Catalog_Management"]</span><h2>@Localizer["Products"]</h2><p class="muted">@Localizer["Products_Intro"]</p></div><a class="primary-button" asp-action="CreateProduct">+ @Localizer["CreateProduct"]</a></div>
<div class="admin-products"><table class="admin-products-table"><thead><tr><th scope="col">@Localizer["Products"]</th><th scope="col">@Localizer["Label_Price"]</th><th scope="col">@Localizer["StockQuantity"]</th><th scope="col">@Localizer["Status"]</th><th scope="col" class="actions-heading">@Localizer["Actions"]</th></tr></thead><tbody>
@foreach(var p in Model.Products){<tr><td data-label="@Localizer["Products"]"><div class="admin-product-identity"><img src="@(p.ImageUrl ?? "/assets/img/product-placeholder.svg")" alt="" loading="lazy"/><div><strong>@CatalogService.Name(p)</strong><small>@p.Slug</small></div></div></td><td data-label="@Localizer["Label_Price"]"><strong class="money">@p.Price.ToString("N2")</strong><small class="currency">EGP</small></td><td data-label="@Localizer["StockQuantity"]"><span class="inventory-pill @(p.StockQuantity<=5?"low-stock":"")">@p.StockQuantity @Localizer[p.StockQuantity==1?"Item":"Items"]</span></td><td data-label="@Localizer["Status"]"><span class="status-pill @(p.IsActive?"":"off")"><span aria-hidden="true">●</span> @Localizer[p.IsActive?"Active":"Inactive"]</span></td><td data-label="@Localizer["Actions"]"><div class="admin-product-actions"><a class="action-link" asp-action="EditProduct" asp-route-id="@p.Id">@Localizer["EditProduct"]</a><form asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@p.Id"/><button type="submit" class="action-link">@Localizer[p.IsActive?"Deactivate":"Activate"]</button></form><form asp-action="DeleteProduct" method="post" data-confirm><input type="hidden" name="id" value="@p.Id"/><button type="submit" class="action-link danger">@Localizer["Delete"]</button></form></div></td></tr>}
</tbody></table>@if(!Model.Products.Any()){<div class="admin-empty">@Localizer["Empty"]</div>}</div><div class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-fragment="products">← @Localizer["Previous"]</a>}@if(Model.Page<Model.TotalPages){<a asp-route-page="@(Model.Page+1)" asp-fragment="products">@Localizer["Next"] →</a>}</div></section>
<section id="categories" class="admin-section"><div class="section-head"><div><span class="eyebrow">@Localizer["Catalog_Management"]</span><h2>@Localizer["Categories"]</h2><p class="muted">@Localizer["Categories_Intro"]</p></div><a class="primary-button" asp-action="CreateCategory">+ @Localizer["CreateCategory"]</a></div><div class="admin-category-grid">@foreach(var c in Model.Categories){<article class="admin-category-card"><div class="category-symbol" aria-hidden="true">@CatalogService.Name(c).Substring(0,1)</div><div class="category-info"><h3>@CatalogService.Name(c)</h3><small>/@c.Slug</small></div><div class="category-actions"><a asp-action="EditCategory" asp-route-id="@c.Id">@Localizer["Edit"]</a><form asp-action="DeleteCategory" method="post" data-confirm><input type="hidden" name="id" value="@c.Id"/><button type="submit">@Localizer["Delete"]</button></form></div></article>}</div></section>
<section id="orders" class="admin-section"><div class="section-head"><div><span class="eyebrow">@Localizer["Operations"]</span><h2>@Localizer["Orders"]</h2><p class="muted">@Localizer["Orders_Intro"]</p></div><a asp-controller="StoreAdmin" asp-action="Index">@Localizer["View_All_Orders"] →</a></div><div tabindex="0" role="region" aria-label="@Localizer["Scrollable_Table"]" class="table-scroll admin-data-table"><table><thead><tr><th>@Localizer["Orders"]</th><th>@Localizer["CustomerName"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th><th></th></tr></thead><tbody>@foreach(var o in Model.Orders.Take(12)){<tr><td><a class="record-link" asp-controller="StoreAdmin" asp-action="Order" asp-route-id="@o.Id">@o.OrderNumber</a><small class="table-subline">@o.CreatedAt.ToString("g")</small></td><td>@o.CustomerName<small class="table-subline">@o.CustomerEmail</small></td><td class="money">@o.TotalAmount.ToString("N2") <small>EGP</small></td><td><span class="status-pill @(o.Status==OrderStatuses.Cancelled?"off":"")">@Localizer[o.Status]</span><small class="table-subline">@Localizer[o.PaymentStatus]</small></td><td><a class="action-link" asp-controller="StoreAdmin" asp-action="Order" asp-route-id="@o.Id">@Localizer["Details"] →</a></td></tr>}</tbody></table>@if(!Model.Orders.Any()){<div class="admin-empty">@Localizer["Empty"]</div>}</div></section>
<section id="logs" class="admin-section"><div class="section-head"><div><span class="eyebrow">@Localizer["Nav_Dashboard"]</span><h2>@Localizer["Logs"]</h2></div><form asp-action="ClearOldLogs" method="post" data-confirm><button>@Localizer["ClearLogs"]</button></form></div><div class="panel"><label for="audit-search">@Localizer["FilterLogs"]</label><input id="audit-search" placeholder="@Localizer["FilterLogs"]"/><div tabindex="0" role="region" aria-label="@Localizer["Scrollable_Table"]" class="table-scroll admin-data-table"><table id="audit-table"><thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Email"]</th><th>@Localizer["Actions"]</th><th>@Localizer["Details"]</th></tr></thead><tbody>@foreach(var l in Model.Logs){<tr><td>@l.Timestamp.ToString("g")</td><td>@l.UserEmail</td><td>@l.Action</td><td>@l.Details</td></tr>}</tbody></table></div></div></section>
