@model DashboardViewModel
<h1>@Localizer["Nav_Dashboard"]</h1><div class="kpis">@foreach(var k in new[]{("Revenue",Model.Revenue.ToString("N2")+" EGP"),("Orders",Model.TotalOrders.ToString()),("Products",Model.ActiveProducts.ToString()),("LowStock",Model.LowStock.ToString()),("Logs",Model.TotalLogs.ToString())}){<div class="panel"><small>@Localizer[k.Item1]</small><h2>@k.Item2</h2></div>}</div><nav class="tabs"><a href="#products">@Localizer["Products"]</a><a href="#categories">@Localizer["Categories"]</a><a href="#orders">@Localizer["Orders"]</a><a href="#logs">@Localizer["Logs"]</a></nav>
<section id="products"><div class="section-head"><h2>@Localizer["Products"]</h2><a class="primary-button" asp-action="CreateProduct">@Localizer["CreateProduct"]</a></div><div class="table-scroll"><table><thead><tr><th>@Localizer["Products"]</th><th>@Localizer["Label_Price"]</th><th>@Localizer["StockQuantity"]</th><th>@Localizer["Status"]</th><th></th></tr></thead><tbody>@foreach(var p in Model.Products){<tr><td>@CatalogService.Name(p)</td><td>@p.Price.ToString("N2")</td><td>@p.StockQuantity</td><td><form asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@p.Id"/><button>@Localizer["Toggle"] (@(p.IsActive ? "✓" : "—"))</button></form></td><td><a asp-action="EditProduct" asp-route-id="@p.Id">@Localizer["EditProduct"]</a><form asp-action="DeleteProduct" method="post" data-confirm><input type="hidden" name="id" value="@p.Id"/><button>@Localizer["Delete"]</button></form></td></tr>}</tbody></table></div><div class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)">@Localizer["Previous"]</a>}@if(Model.Page<Model.TotalPages){<a asp-route-page="@(Model.Page+1)">@Localizer["Next"]</a>}</div></section>
<section id="categories"><div class="section-head"><h2>@Localizer["Categories"]</h2><a class="primary-button" asp-action="CreateCategory">@Localizer["CreateCategory"]</a></div>@foreach(var c in Model.Categories){<div class="cart-line"><strong>@CatalogService.Name(c)</strong><a asp-action="EditCategory" asp-route-id="@c.Id">@Localizer["EditCategory"]</a><form asp-action="DeleteCategory" method="post" data-confirm><input type="hidden" name="id" value="@c.Id"/><button>@Localizer["Delete"]</button></form></div>}</section>
<section id="orders"><h2>@Localizer["Orders"]</h2><div class="table-scroll"><table><thead><tr><th>@Localizer["Orders"]</th><th>@Localizer["CustomerName"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th></tr></thead><tbody>@foreach(var o in Model.Orders){<tr><td><details><summary>@o.OrderNumber</summary><p>@o.CreatedAt.ToString("u")</p><p>@o.CustomerEmail · @o.CustomerPhone</p><p>@o.ShippingAddress</p>@foreach(var i in o.Items){<p>@i.ProductName × @i.Quantity · @i.UnitPrice.ToString("N2") EGP</p>}</details></td><td>@o.CustomerName</td><td>@o.TotalAmount.ToString("N2") EGP<br/>@Localizer[o.PaymentStatus]<br/><a asp-controller="Payment" asp-action="Return" asp-route-token="@o.PaymentAccessToken">@Localizer["Payment_Check"]</a></td><td><form asp-action="UpdateOrderStatus" method="post"><input type="hidden" name="orderId" value="@o.Id"/><select name="status" aria-label="@Localizer["Status"]">@foreach(var s in OrderStatuses.All.Where(s=>OrderStatuses.CanTransition(o.Status,s))){<option value="@s" selected="@(o.Status==s)">@Localizer[s]</option>}</select><button>@Localizer["Update"]</button></form></td></tr>}</tbody></table></div></section>
<section id="logs"><div class="section-head"><h2>@Localizer["Logs"]</h2><form asp-action="ClearOldLogs" method="post" data-confirm><button>@Localizer["ClearLogs"]</button></form></div><input id="audit-search" placeholder="@Localizer["FilterLogs"]" aria-label="@Localizer["FilterLogs"]"/><div class="table-scroll"><table id="audit-table"><tbody>@foreach(var l in Model.Logs){<tr><td>@l.Timestamp.ToString("u")</td><td>@l.UserEmail</td><td>@l.Action</td><td>@l.EntityName</td><td>@l.Details</td><td>@l.IpAddress</td></tr>}</tbody></table></div></section>
