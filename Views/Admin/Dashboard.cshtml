@model DashboardViewModel
@{ViewData["Title"]=Localizer["Nav_Dashboard"];}
<div class="section-head"><div><span class="eyebrow">Chic & Unique · @Localizer["Admin_Navigation"]</span><h1>@Localizer["Nav_Dashboard"]</h1><p class="muted">@Localizer["Dashboard_Intro"]</p></div></div>
<div class="kpis">@foreach(var k in new[]{("Revenue",Model.Revenue.ToString("N2")+" EGP"),("Orders",Model.TotalOrders.ToString()),("Products",Model.ActiveProducts.ToString()),("LowStock",Model.LowStock.ToString()),("Logs",Model.TotalLogs.ToString())}){<div class="panel"><small>@Localizer[k.Item1]</small><h2>@k.Item2</h2></div>}</div>
<div class="admin-section-directory">
@foreach(var destination in new[]{
    (Controller:"Admin",Action:"Products",Title:"Products",Help:"Products_Intro"),
    (Controller:"Admin",Action:"Categories",Title:"Categories",Help:"Categories_Intro"),
    (Controller:"StoreAdmin",Action:"Index",Title:"Orders",Help:"Shortcut_Orders"),
    (Controller:"StoreAdmin",Action:"Customers",Title:"Customers",Help:"Admin_Customers_Help"),
    (Controller:"StoreAdmin",Action:"Reviews",Title:"Review_Moderation",Help:"Admin_Reviews_Help"),
    (Controller:"StoreAdmin",Action:"Reports",Title:"Sales_Reports",Help:"Shortcut_Reports"),
    (Controller:"StoreAdmin",Action:"Settings",Title:"Store_Settings",Help:"Shortcut_Settings"),
    (Controller:"Admin",Action:"AuditLogs",Title:"Logs",Help:"Admin_Logs_Help")}){
    <a class="panel admin-section-card" asp-controller="@destination.Controller" asp-action="@destination.Action"><strong>@Localizer[destination.Title]</strong><p class="muted">@Localizer[destination.Help]</p><span aria-hidden="true">→</span></a>
}
</div>
