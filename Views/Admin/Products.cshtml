@model AdminProductsViewModel
@{ViewData["Title"]=Localizer["Products"];}
<section id="products" class="admin-section"><div class="section-head"><div><span class="eyebrow">@Localizer["Catalog_Management"]</span><h1>@Localizer["Products"]</h1><p class="muted">@Localizer["Products_Intro"]</p></div><a class="primary-button" asp-action="CreateProduct">+ @Localizer["CreateProduct"]</a></div>
<nav class="category-browse-nav admin-category-filters" aria-label="@Localizer["Categories"]">
    <a asp-action="Products" aria-current="@(!Model.CategoryId.HasValue ? "page" : null)">@Localizer["All"] <span>@Model.Categories.Sum(c => c.ProductCount)</span></a>
    @foreach(var summary in Model.Categories){<a asp-action="Products" asp-route-categoryId="@summary.Category.Id" aria-current="@(Model.CategoryId==summary.Category.Id ? "page" : null)">@CatalogService.Name(summary.Category) <span>@summary.ProductCount</span></a>}
</nav>
@foreach(var group in Model.Products.GroupBy(p => p.CategoryId)){
    var category = group.First().Category;
    var total = Model.Categories.First(c => c.Category.Id == group.Key).ProductCount;
    <section class="admin-product-category" aria-labelledby="category-@group.Key">
        <div class="admin-product-category-heading"><div><h2 id="category-@group.Key">@CatalogService.Name(category)</h2><small class="muted">@Localizer["Admin_Category_Product_Count", group.Count(), total]</small></div>@if(category.IsHidden){<span class="status-pill off">@Localizer["Category_Hidden"]</span>}</div>
<div class="admin-products"><table class="admin-products-table"><thead><tr><th scope="col">@Localizer["Products"]</th><th scope="col">@Localizer["Label_Price"]</th><th scope="col">@Localizer["StockQuantity"]</th><th scope="col">@Localizer["Status"]</th><th scope="col" class="actions-heading">@Localizer["Actions"]</th></tr></thead><tbody>
@foreach(var p in group){<tr><td data-label="@Localizer["Products"]"><div class="admin-product-identity"><img src="@(p.ImageUrl ?? "/assets/img/product-placeholder.svg")" alt="" loading="lazy"/><div><strong>@CatalogService.Name(p)</strong><small>@p.Slug</small></div></div></td><td data-label="@Localizer["Label_Price"]"><strong class="money">@p.Price.ToString("N2")</strong><small class="currency">EGP</small></td><td data-label="@Localizer["StockQuantity"]"><span class="inventory-pill @(p.StockQuantity<=5?"low-stock":"")">@p.StockQuantity @Localizer[p.StockQuantity==1?"Item":"Items"]</span></td><td data-label="@Localizer["Status"]"><span class="status-pill @(p.IsActive?"":"off")"><span aria-hidden="true">●</span> @Localizer[p.IsActive?"Active":"Inactive"]</span></td><td data-label="@Localizer["Actions"]"><div class="admin-product-actions"><a class="action-link" asp-action="EditProduct" asp-route-id="@p.Id">@Localizer["EditProduct"]</a><form asp-action="SetProductVisibility" method="post" data-async-form><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="page" value="@Model.Page"/><input type="hidden" name="categoryId" value="@Model.CategoryId"/><input type="hidden" name="hidden" value="@(p.IsActive ? "true" : "false")"/><button type="submit" class="action-link">@Localizer[p.IsActive ? "Hide_Product" : "Show_Product"]</button></form><form asp-action="DeleteProduct" method="post" data-confirm data-async-form><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="page" value="@Model.Page"/><input type="hidden" name="categoryId" value="@Model.CategoryId"/><button type="submit" class="action-link danger">@Localizer["Delete"]</button></form></div></td></tr>}
</tbody></table></div>
    </section>
}
@if(!Model.Products.Any()){<div class="panel admin-empty">@Localizer["Category_Empty"]</div>}
<div class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-categoryId="@Model.CategoryId" asp-fragment="products">← @Localizer["Previous"]</a>}@if(Model.Page<Model.TotalPages){<a asp-route-page="@(Model.Page+1)" asp-route-categoryId="@Model.CategoryId" asp-fragment="products">@Localizer["Next"] →</a>}</div></section>
