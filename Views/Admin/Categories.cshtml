@model AdminCategoriesViewModel
@{ViewData["Title"]=Localizer["Categories"];}
<section id="categories" class="admin-section"><div class="section-head"><div><span class="eyebrow">@Localizer["Catalog_Management"]</span><h1>@Localizer["Categories"]</h1><p class="muted">@Localizer["Categories_Intro"]</p></div><a class="primary-button" asp-action="CreateCategory">+ @Localizer["CreateCategory"]</a></div><div class="card-view-toggle" data-view-toggle data-target="#category-grid" role="group" aria-label="@Localizer["View_Options"]">
  <button type="button" data-view="grid" aria-pressed="true">@Localizer["Grid_View"]</button>
  <button type="button" data-view="list" aria-pressed="false">@Localizer["List_View"]</button>
</div>
<div class="admin-category-grid" id="category-grid">@foreach(var c in Model.Categories){<article class="admin-category-card"><div class="category-symbol" aria-hidden="true">@CatalogService.Name(c).Substring(0,1)</div><div class="category-info"><h3>@CatalogService.Name(c)</h3><small>/@c.Slug</small><small class="category-visibility-status" role="status">@Localizer[c.IsHidden ? "Category_Hidden" : "Category_Visible"]</small></div><div class="category-actions"><form asp-action="SetCategoryVisibility" method="post" data-category-visibility><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="hidden" value="@((!c.IsHidden).ToString().ToLowerInvariant())"/><button type="submit">@Localizer[c.IsHidden ? "Show_Category" : "Hide_Category"]</button><small class="validation" data-visibility-error role="alert" hidden>@Localizer["Category_Visibility_Error"]</small></form><a asp-action="EditCategory" asp-route-id="@c.Id">@Localizer["Edit"]</a><form asp-action="DeleteCategory" method="post" data-confirm data-async-form><input type="hidden" name="id" value="@c.Id"/><button type="submit">@Localizer["Delete"]</button></form></div></article>}</div></section>
