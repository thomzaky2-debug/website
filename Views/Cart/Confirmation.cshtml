@model Order
@{ViewData["Title"] = Localizer["Confirmation"];}
<div class="status-page"><span class="eyebrow">NileShop · @Localizer["Orders"]</span><div class="panel status-card"><div class="status-icon is-paid" aria-hidden="true">✓</div><h1>@Localizer["Confirmation"]</h1><div class="status-facts"><div><span>@Localizer["Orders"]</span><strong>@Model.OrderNumber</strong></div><div><span>@Localizer["Total"]</span><strong>@Model.TotalAmount.ToString("N2") EGP</strong></div><div><span>@Localizer["Status"]</span><strong>@Localizer[Model.Status]</strong></div></div><div class="status-actions"><a class="primary-button" asp-controller="Orders" asp-action="Track" asp-route-token="@Model.PaymentAccessToken">@Localizer["Track_Order"]</a><a class="action-link" asp-controller="Home" asp-action="Shop">@Localizer["Nav_Shop"]</a></div></div></div>
