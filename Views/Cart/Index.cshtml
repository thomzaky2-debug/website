@model CartViewModel
<h1>@Localizer["Nav_Cart"]</h1>@if(!Model.Lines.Any()){<p class="empty">@Localizer["Empty"]</p><a class="primary-button" href="/">@Localizer["Nav_Shop"]</a>}else{foreach(var line in Model.Lines){<div class="cart-line"><img src="@line.Product.ImageUrl" alt="@line.Product.Name"/><a asp-controller="Products" asp-action="Details" asp-route-slug="@line.Product.Slug">@line.Product.Name</a><span>@line.Total.ToString("N2") EGP</span><form asp-action="UpdateQuantity" method="post"><input type="hidden" name="productId" value="@line.Product.Id"/><input aria-label="@Localizer["Quantity"]" type="number" name="quantity" value="@line.Quantity" min="0" max="99"/><button>@Localizer["Update"]</button></form><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@line.Product.Id"/><button>@Localizer["Remove"]</button></form></div>}<div class="summary"><h2>@Localizer["Total"]: @Model.Total.ToString("N2") EGP</h2><a class="primary-button" asp-action="Checkout">@Localizer["Checkout"]</a></div>}