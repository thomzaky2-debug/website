@model CartViewModel
@{ViewData["Title"] = Localizer["Nav_Cart"];}
<div class="cart-page">
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">@Localizer["Nav_Home"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["Nav_Cart"]</li></ol></nav>
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Nav_Shop"]</span><h1>@Localizer["Nav_Cart"]</h1></div><a asp-controller="Home" asp-action="Shop">← @Localizer["Nav_Shop"]</a></div>
@if(!Model.Lines.Any()){<div class="panel empty"><p>@Localizer["Error_CartEmpty"]</p><a class="primary-button" href="/shop">@Localizer["Nav_Shop"]</a></div>}
else{<p id="cart-update-message" class="notice" role="status" hidden></p><div class="cart-layout"><div class="cart-items">@foreach(var line in Model.Lines){<article class="cart-item panel" data-cart-key="@line.Key"><img src="@line.Product.ImageUrl" alt=""/><div class="cart-item-info"><a asp-controller="Products" asp-action="Details" asp-route-slug="@line.Product.Slug">@line.Product.Name</a>@if(!string.IsNullOrEmpty(line.Size)||!string.IsNullOrEmpty(line.Color)){<small>@line.Size @line.Color</small>}<strong data-unit-price>@line.Product.Price.ToString("N2") EGP</strong></div><div class="cart-item-controls"><form asp-action="UpdateQuantity" method="post" data-auto-quantity><input type="hidden" name="cartKey" value="@line.Key"/><label><span>@Localizer["Quantity"]</span><span class="cart-stepper"><button type="button" data-quantity-step="-1" aria-label="@Localizer["Decrease_Quantity"]">−</button><input aria-label="@Localizer["Quantity"]" type="number" name="quantity" value="@line.Quantity" min="1" max="99"/><button type="button" data-quantity-step="1" aria-label="@Localizer["Increase_Quantity"]">+</button></span></label><button type="submit">@Localizer["Update"]</button></form><form asp-action="Remove" method="post" data-async-form><input type="hidden" name="cartKey" value="@line.Key"/><button type="submit" class="remove-button" aria-label="@Localizer["Remove"] @line.Product.Name" title="@Localizer["Remove"]"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6"/></svg></button></form><div class="cart-line-price"><span>@Localizer["Total"]</span><strong data-line-total>@line.Total.ToString("N2") EGP</strong></div></div></article>}</div><aside class="panel cart-summary"><h2>@Localizer["Order_Summary"]</h2><div class="order-total-row"><span>@Localizer["Products"]</span><strong id="cart-item-count">@Model.Lines.Sum(l=>l.Quantity)</strong></div><div class="order-total-row grand"><span>@Localizer["Total"]</span><strong id="cart-grand-total">@Model.Total.ToString("N2") EGP</strong></div><p class="muted">@Localizer["Shipping_Calculated_Checkout"]</p><a class="primary-button" id="cart-checkout" asp-action="Checkout">@Localizer["Checkout"] →</a></aside></div>}

</div>
