@model CheckoutViewModel
@{
    ViewData["Title"] = Localizer["Checkout"];
    string Money(decimal d) => MoneyText.Format(d);
    var savedAddress = ViewData["SavedAddress"] as string;
    var hasSavedAddress = !string.IsNullOrWhiteSpace(savedAddress);
    var usingSavedAddress = hasSavedAddress && string.Equals((Model.ShippingAddress ?? "").Trim(), savedAddress!.Trim(), StringComparison.Ordinal);
    var nameParts = (Model.CustomerName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var initials = nameParts.Length >= 2
        ? string.Concat(nameParts[0][0], nameParts[^1][0]).ToUpperInvariant()
        : nameParts.Length == 1 && nameParts[0].Length > 0
            ? nameParts[0][..1].ToUpperInvariant()
            : "N";
}
<div class="checkout-page">
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">@Localizer["Nav_Home"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item"><a href="/Cart">@Localizer["Nav_Cart"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["Checkout"]</li></ol></nav>
<div class="section-head"><div><span class="eyebrow"><bdi>Chic &amp; Unique</bdi> · @Localizer["Nav_Cart"]</span><h1>@Localizer["Checkout"]</h1><p class="muted">@Localizer["Checkout_Intro"]</p></div><a class="action-link" asp-action="Index">← @Localizer["Nav_Cart"]</a></div>

<div class="checkout-layout">
<form asp-action="Checkout" method="post" class="panel checkout-form" id="checkout-order-form" novalidate data-msg-name="@Localizer["Err_Name"]" data-msg-phone="@Localizer["Err_Phone"]" data-msg-phone-invalid="@Localizer["Err_PhoneInvalid"]" data-msg-email="@Localizer["Err_Email"]" data-msg-email-invalid="@Localizer["Err_EmailInvalid"]" data-msg-shipping="@Localizer["Err_Shipping"]" data-msg-address="@Localizer["Err_Address"]" data-msg-instapay="@Localizer["InstaPay_Required"]" data-msg-instapay-invalid="@Localizer["InstaPay_Invalid"]">
    <div asp-validation-summary="All" class="validation"></div>
    <input asp-for="CheckoutToken" type="hidden"/>

    <h2>@Localizer["Contact_Details"]</h2>
    @if (ViewData["SavedContact"] is true)
    {
        <div class="saved-checkout-contact">
            <div class="saved-contact-main">
                <span class="saved-contact-avatar" aria-hidden="true">@initials</span>
                <div class="saved-contact-copy">
                    <div class="saved-contact-title-row">
                        <strong>@Model.CustomerName</strong>
                        <span class="saved-address-pill">@Localizer["Member_Account"]</span>
                    </div>
                    <div class="saved-contact-meta">
                        <span class="saved-contact-chip">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                            <span>@Model.CustomerEmail</span>
                        </span>
                        <span class="saved-contact-chip" dir="ltr">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            <span>@Model.CustomerPhone</span>
                        </span>
                        @if (ViewData["SavedWhatsApp"] is string savedWhatsApp && !string.IsNullOrWhiteSpace(savedWhatsApp))
                        {
                            <span class="saved-contact-chip whatsapp-chip" dir="ltr">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.174-.008-.372-.01-.571-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                                <span>@savedWhatsApp</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
            <a class="btn-change-address" asp-controller="Account" asp-action="Index">@Localizer["Edit_Contact_Details"]</a>
        </div>
    }
    else
    {
        <div class="checkout-fields">
            <div class="field">
                <label asp-for="CustomerName">@Localizer["CustomerName"]</label>
                <input asp-for="CustomerName" required maxlength="150" autocomplete="name"/>
                <span asp-validation-for="CustomerName"></span>
            </div>
            <div class="field">
                <label asp-for="CustomerPhone">@Localizer["CustomerPhone"]</label>
                <input asp-for="CustomerPhone" type="tel" required maxlength="30" autocomplete="tel" dir="ltr"/>
                <span asp-validation-for="CustomerPhone"></span>
            </div>
            <div class="field checkout-wide">
                <label asp-for="CustomerEmail">@Localizer["CustomerEmail"]</label>
                <input asp-for="CustomerEmail" type="email" required maxlength="254" autocomplete="email"/>
                <span asp-validation-for="CustomerEmail"></span>
            </div>
        </div>
    }

    @if (Model.FreeDeliveryOfferEnabled)
    {
        @if (Model.IsFreeDeliveryQualified)
        {
            <div class="checkout-offer-banner qualified" role="region" aria-label="@Localizer["Free_Delivery_Offer"]">
                <div class="checkout-offer-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"/></svg>
                </div>
                <div class="checkout-offer-content">
                    <div class="checkout-offer-head">
                        <strong>@(string.IsNullOrWhiteSpace(Model.FreeDeliveryOfferLabel) ? Localizer["Free_Delivery_Offer_Qualified_Title"].Value : Model.FreeDeliveryOfferLabel)</strong>
                        <span class="free-delivery-badge">@Localizer["Free_Delivery_Offer_Badge"]</span>
                    </div>
                    <p>@Localizer["Free_Delivery_Offer_Qualified_Desc"]</p>
                </div>
            </div>
        }
        else
        {
            var remaining = Model.FreeDeliveryOfferThreshold - Model.Cart.Total;
            <div class="checkout-offer-banner promo" role="region" aria-label="@Localizer["Free_Delivery_Offer"]">
                <div class="checkout-offer-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div class="checkout-offer-content">
                    <div class="checkout-offer-head">
                        <strong>@Localizer["Free_Delivery_Offer_Promo_Title"]</strong>
                        <span class="free-delivery-badge-sub">@Localizer["Free_Delivery_Offer"]</span>
                    </div>
                    <p>@string.Format(Localizer["Free_Delivery_Offer_Promo_Desc"].Value, Money(remaining))</p>
                </div>
                <a class="checkout-offer-action" asp-controller="Products" asp-action="Index">@Localizer["Continue_Shopping"] →</a>
            </div>
        }
    }

    <h2>@Localizer["Delivery"]</h2>
    <div class="checkout-fields">
        <div class="field checkout-wide">
            <label asp-for="ShippingMethodId">@Localizer["Shipping_Area"]</label>
            <select asp-for="ShippingMethodId" id="shipping-method" required>
                @foreach (var method in Model.ShippingMethods)
                {
                    <option value="@method.Id" data-fee="@method.Fee.ToString(CultureInfo.InvariantCulture)" data-days="@method.MinDays–@method.MaxDays">@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"?method.NameAr:method.NameEn)</option>
                }
            </select>
            @{
                var selectedMethod = Model.ShippingMethods.FirstOrDefault(m => m.Id == Model.ShippingMethodId) ?? Model.ShippingMethods.FirstOrDefault();
            }
            @if (selectedMethod is not null)
            {
                <small class="shipping-method-meta" id="shipping-method-meta"><bdi><span id="shipping-meta-fee">@Money(selectedMethod.Fee)</span> EGP · <span id="shipping-meta-days">@selectedMethod.MinDays–@selectedMethod.MaxDays</span></bdi> @Localizer["Business_Days"]</small>
            }
        </div>
        <div class="field checkout-wide" data-checkout-address-box data-saved-address="@savedAddress">
            @if (hasSavedAddress)
            {
                <div class="saved-address-card" id="savedAddressCard" hidden="@(!usingSavedAddress ? "hidden" : null)">
                    <div class="saved-address-main">
                        <span class="saved-address-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        </span>
                        <div class="saved-address-copy">
                            <span class="saved-address-pill">@Localizer["Saved_Delivery_Address"]</span>
                            <strong>@savedAddress</strong>
                        </div>
                    </div>
                    <button type="button" class="btn-change-address" data-change-address>@Localizer["Change_Address"]</button>
                </div>
            }
            <div class="checkout-address-editor" id="checkoutAddressEditor" hidden="@(usingSavedAddress ? "hidden" : null)">
                <div class="checkout-address-label-row">
                    <label asp-for="ShippingAddress">@Localizer["ShippingAddress"]</label>
                    @if (hasSavedAddress)
                    {
                        <button type="button" class="btn-use-saved-address" data-use-saved-address>@Localizer["Use_Saved_Address"]</button>
                    }
                </div>
                <input asp-for="ShippingAddress" required maxlength="1000" autocomplete="street-address" placeholder="@Localizer["Delivery_Address_Placeholder"]"/>
                <span asp-validation-for="ShippingAddress"></span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <label class="checkout-save-address-check">
                        <input asp-for="SaveAddressToProfile" type="checkbox" checked="@(!hasSavedAddress ? "checked" : null)"/>
                        <span>@Localizer["Save_Address_Profile"]</span>
                    </label>
                }
            </div>
        </div>
    </div>

    <h2>@Localizer["Payment_Gateway"]</h2>
    @if (Model.WalletBalance > 0)
    {
        <div class="checkout-wallet-box" data-wallet-box data-wallet-balance="@Model.WalletBalance.ToString(CultureInfo.InvariantCulture)">
            <label class="checkout-wallet-toggle">
                <input asp-for="UseWallet" id="use-wallet" type="checkbox"/>
                <span class="checkout-wallet-copy">
                    <strong>@Localizer["Use_Wallet_Balance"]</strong>
                    <small>@Localizer["Wallet_Balance"]: <b><bdi>@Money(Model.WalletBalance) EGP</bdi></b></small>
                </span>
            </label>
            <p class="wallet-full-banner" id="walletFullBanner" hidden="@(Model.PayablePreview > 0 ? "hidden" : null)">@Localizer["Wallet_Full_Covered"]</p>
        </div>
    }
    <div class="field checkout-instapay-field" id="instapayFieldWrap" hidden="@(Model.WalletBalance > 0 && Model.UseWallet && Model.PayablePreview == 0 ? "hidden" : null)">
        <label asp-for="InstaPayUsername" class="instapay-label"><span class="instapay-brand" aria-hidden="true"><img src="~/assets/img/instapay-logo-@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "ar" : "en").png" alt="" height="16"/></span><span>@Localizer["InstaPay_Username"]</span></label>
        <div class="instapay-input" dir="ltr">
            <input asp-for="InstaPayUsername" placeholder="ahmed.mohammed" required="@(Model.WalletBalance > 0 && Model.UseWallet && Model.PayablePreview == 0 ? null : "required")" maxlength="100" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="instapay-help"/>
            <span aria-hidden="true">@@instapay</span>
        </div>
        <small id="instapay-help">@Localizer["InstaPay_Help"]</small>
        <span asp-validation-for="InstaPayUsername"></span>
    </div>

</form>

<aside class="panel checkout-summary" data-free-delivery-qualified="@(Model.IsFreeDeliveryQualified ? "true" : "false")">
    <h2>@Localizer["Order_Summary"]</h2>
    <div class="order-summary-table">
    <div class="order-total-row order-head-row"><span>@Localizer["Summary_Product"]</span><span class="order-qty">@Localizer["Summary_Qty"]</span><span class="order-price-head">@Localizer["Label_Price"]</span></div>
    @foreach (var line in Model.Cart.Lines)
    {
        <div class="order-total-row order-item-row"><span>@line.Product.Name <small><bdi>@line.Size @line.Color</bdi></small></span><span class="order-qty"><bdi>@line.Quantity</bdi></span><strong class="order-amount"><bdi>@Money(line.Total) EGP</bdi></strong></div>
    }
    <div class="order-total-row">
        <span>@Localizer["Shipping_Fee"]</span>
        <strong class="order-amounts">
            @if (Model.IsFreeDeliveryQualified)
            {
                <span class="free-badge">@Localizer["Free"]</span>
                <del class="muted shipping-orig-del"><bdi><span id="shipping-orig-fee">@Money(Model.StandardShippingFee)</span> EGP</bdi></del>
                <span class="free-shipping-zero"><bdi><span id="shipping-fee">0.00</span> EGP</bdi></span>
            }
            else
            {
                <bdi><span id="shipping-fee">@Money(Model.ShippingFee)</span> EGP</bdi>
            }
        </strong>
    </div>
    <div class="order-total-row wallet-summary-row" id="wallet-credit-row" hidden="@(Model.WalletAppliedPreview <= 0 ? "hidden" : null)"><span>@Localizer["Wallet_Credit_Applied"]</span><strong class="order-amount"><bdi>−<span id="wallet-applied">@Money(Model.WalletAppliedPreview)</span> EGP</bdi></strong></div>
    <div class="order-total-row grand"><span>@Localizer["Total"]</span><strong class="order-amount"><bdi><span id="checkout-total" data-subtotal="@Model.Cart.Total.ToString(CultureInfo.InvariantCulture)">@Money(Model.TotalWithShipping)</span> EGP</bdi></strong></div>
    <div class="order-total-row payable-summary-row" id="checkout-payable-row" hidden="@(Model.WalletAppliedPreview <= 0 ? "hidden" : null)"><span>@Localizer["Remaining_To_Pay"]</span><strong class="order-amount"><bdi><span id="checkout-payable">@Money(Model.PayablePreview)</span> EGP</bdi></strong></div>
    </div>
    <p class="muted">@Localizer["Delivery_EstimateNote"]</p>
</aside>
<div class="checkout-actions-row">
    <button type="submit" form="checkout-order-form" class="primary-button checkout-submit" data-label-nilepay="@Localizer["PlaceOrder"] →" data-label-wallet="@Localizer["PlaceOrder_Wallet"] →">@(Model.WalletBalance > 0 && Model.UseWallet && Model.PayablePreview == 0 ? Localizer["PlaceOrder_Wallet"].Value : Localizer["PlaceOrder"].Value) →</button>
</div>
</div>
</div>

<div class="checkout-overlay"><div class="checkout-spinner"></div></div>
