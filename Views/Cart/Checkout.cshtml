@model CheckoutViewModel
<h1>@Localizer["Checkout"]</h1><div class="detail"><form asp-action="Checkout" method="post" class="panel"><div asp-validation-summary="All" class="validation"></div><input asp-for="CheckoutToken" type="hidden"/><label asp-for="CustomerName">@Localizer["CustomerName"]</label><input asp-for="CustomerName" required/><span asp-validation-for="CustomerName"></span><label asp-for="CustomerEmail">@Localizer["CustomerEmail"]</label><input asp-for="CustomerEmail" required/><span asp-validation-for="CustomerEmail"></span><label asp-for="CustomerPhone">@Localizer["CustomerPhone"]</label><input asp-for="CustomerPhone" required/><span asp-validation-for="CustomerPhone"></span><label asp-for="ShippingAddress">@Localizer["ShippingAddress"]</label><input asp-for="ShippingAddress" required/><span asp-validation-for="ShippingAddress"></span><button class="primary-button">@Localizer["PlaceOrder"]</button></form><aside class="panel">@foreach(var line in Model.Cart.Lines){<p>@line.Product.Name × @line.Quantity <strong>@line.Total.ToString("N2") EGP</strong></p>}<h2>@Localizer["Total"] @Model.Cart.Total.ToString("N2") EGP</h2></aside></div>