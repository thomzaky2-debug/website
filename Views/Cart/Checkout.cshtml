@model CheckoutViewModel
@{ViewData["Title"] = Localizer["Checkout"];}
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">@Localizer["Nav_Home"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item"><a href="/Cart">@Localizer["Nav_Cart"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["Checkout"]</li></ol></nav>
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Nav_Cart"]</span><h1>@Localizer["Checkout"]</h1><p class="muted">@Localizer["Checkout_Intro"]</p></div><a asp-action="Index">← @Localizer["Nav_Cart"]</a></div>
<div class="checkout-layout"><form asp-action="Checkout" method="post" class="panel checkout-form"><div asp-validation-summary="All" class="validation"></div><input asp-for="CheckoutToken" type="hidden"/>
<h2>@Localizer["Contact"]</h2>@if(ViewData["SavedContact"] is true){<div class="saved-checkout-contact"><strong>@Model.CustomerName</strong><p>@Model.CustomerEmail · @Model.CustomerPhone</p><a asp-controller="Account" asp-action="Index">@Localizer["Edit_Contact_Details"]</a></div>}else{<div class="checkout-fields"><div class="field"><label asp-for="CustomerName">@Localizer["CustomerName"]</label><input asp-for="CustomerName" required autocomplete="name"/><span asp-validation-for="CustomerName"></span></div><div class="field"><label asp-for="CustomerEmail">@Localizer["CustomerEmail"]</label><input asp-for="CustomerEmail" type="email" required autocomplete="email"/><span asp-validation-for="CustomerEmail"></span></div><div class="field"><label asp-for="CustomerPhone">@Localizer["CustomerPhone"]</label><input asp-for="CustomerPhone" type="tel" required autocomplete="tel"/><span asp-validation-for="CustomerPhone"></span></div></div>
}
<h2>@Localizer["Delivery"]</h2><div class="checkout-fields"><div class="field"><label asp-for="ShippingMethodId">@Localizer["Shipping_Area"]</label><select asp-for="ShippingMethodId" id="shipping-method" required>@foreach(var method in Model.ShippingMethods){<option value="@method.Id" data-fee="@method.Fee.ToString(CultureInfo.InvariantCulture)">@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"?method.NameAr:method.NameEn) — @method.Fee.ToString("N2") EGP · @method.MinDays–@method.MaxDays @Localizer["Business_Days"]</option>}</select></div><div class="field"><label asp-for="ShippingAddress">@Localizer["ShippingAddress"]</label><input asp-for="ShippingAddress" required autocomplete="street-address"/><span asp-validation-for="ShippingAddress"></span></div></div>
<h2>@Localizer["Payment_Gateway"]</h2><div class="field"><label asp-for="InstaPayUsername">@Localizer["InstaPay_Username"]</label><div class="instapay-input" dir="ltr"><input asp-for="InstaPayUsername" placeholder="ahmed.mohammed" required maxlength="100" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="instapay-help"/><span aria-hidden="true">@@instapay</span></div><small id="instapay-help">@Localizer["InstaPay_Help"]</small><span asp-validation-for="InstaPayUsername"></span></div><button class="primary-button checkout-submit">@Localizer["PlaceOrder"] →</button></form>
<aside class="panel checkout-summary"><h2>@Localizer["Order_Summary"]</h2>@foreach(var line in Model.Cart.Lines){<div class="order-total-row"><span>@line.Product.Name <small>@line.Size @line.Color × @line.Quantity</small></span><strong>@line.Total.ToString("N2") EGP</strong></div>}<div class="order-total-row"><span>@Localizer["Shipping_Fee"]</span><strong><span id="shipping-fee">@Model.ShippingFee.ToString("N2")</span> EGP</strong></div><div class="order-total-row grand"><span>@Localizer["Total"]</span><strong><span id="checkout-total" data-subtotal="@Model.Cart.Total.ToString(CultureInfo.InvariantCulture)">@Model.TotalWithShipping.ToString("N2")</span> EGP</strong></div><p class="muted">@Localizer["Delivery_EstimateNote"]</p></aside></div>

<div class="checkout-overlay"><div class="checkout-spinner"></div></div>
