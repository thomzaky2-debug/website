@model CustomerRegisterViewModel
@{ViewData["Title"]=Localizer["Customer_Signup"];}
<div class="login-page auth-page"><partial name="_AuthStory"/><section class="login panel"><h1>@Localizer["Create_Account"]</h1><p class="muted">@Localizer["Signup_Intro"]</p><form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="FullName">@Localizer["CustomerName"]</label><input asp-for="FullName" required maxlength="100" autocomplete="name"/><label asp-for="Phone">@Localizer["CustomerPhone"]</label><input asp-for="Phone" type="tel" required maxlength="30" autocomplete="tel"/><label asp-for="Email">@Localizer["Email"]</label><input asp-for="Email" type="email" required maxlength="254" autocomplete="username"/><label asp-for="PreferredLanguage">@Localizer["Preferred_Language"]</label><select asp-for="PreferredLanguage"><option value="en">English</option><option value="ar">العربية</option></select><span asp-validation-for="PreferredLanguage"></span><label asp-for="Password">@Localizer["Password"]</label><input asp-for="Password" type="password" required minlength="12" maxlength="128" autocomplete="new-password" aria-describedby="password-help"/><small class="muted" id="password-help">@Localizer["Customer_Password_Help"]</small><label asp-for="ConfirmPassword">@Localizer["Confirm_Password"]</label><input asp-for="ConfirmPassword" type="password" required maxlength="128" autocomplete="new-password"/><button class="primary-button">@Localizer["Create_Account"]</button></form><p class="account-switch">@Localizer["Already_Account"] <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Customer_Login"]</a></p></section></div>
