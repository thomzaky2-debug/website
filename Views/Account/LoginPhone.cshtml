@model CustomerPhoneLoginViewModel
@{ViewData["Title"]=Localizer["Phone_Login_Title"];}
<div class="login-page auth-page"><partial name="_AuthStory"/><section class="login panel"><h1>@Localizer["Phone_Login_Title"]</h1><p class="muted">@Localizer["Phone_Login_Intro"]</p><form asp-action="LoginPhone" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="Phone">@Localizer["CustomerPhone"]</label><input asp-for="Phone" type="tel" required maxlength="30" autocomplete="tel"/><button class="primary-button">@Localizer["Customer_Login"]</button></form><p class="account-switch"><a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Customer_Login"]</a> &middot; @Localizer["New_To_NileShop"] <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Customer_Signup"]</a></p></section></div>
