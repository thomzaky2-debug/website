@model IReadOnlyList<Order>
@{ViewData["Title"]=Localizer["My_Orders"];var page=(int)(ViewData["Page"]??1);var pages=(int)(ViewData["Pages"]??1);}
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">@Localizer["Nav_Home"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item"><a asp-controller="Account" asp-action="Index">@Localizer["Your_Account"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["My_Orders"]</li></ol></nav>
<div class="section-head"><div><span class="eyebrow">Chic & Unique · @Localizer["Your_Account"]</span><h1>@Localizer["My_Orders"]</h1><p class="muted">@Localizer["My_Orders_Help"]</p></div><a asp-action="Index">@Localizer["Your_Account"] →</a></div>
<div class="account-orders">@foreach(var order in Model){<article class="panel account-order"><div><strong>@order.OrderNumber</strong><small>@CairoTime.Fmt(order.CreatedAt, "g")</small></div><div><span class="status-pill @(OrderStatusPresentation.IsWarning(order)?"off":"")">@Localizer[OrderStatusPresentation.Key(order)]</span><small>@Localizer[order.PaymentStatus]</small></div><strong>@order.TotalAmount.ToString("N2") EGP</strong><a class="action-link" asp-controller="Orders" asp-action="Track" asp-route-token="@order.PaymentAccessToken">@Localizer["Track_Order"] →</a></article>}@if(!Model.Any()){<partial name="_StoreEmpty" model='@(new StoreEmptyState("delivery", Localizer["No_Account_Orders"], Localizer["Studio_No_Orders_Help"], "Home", "Shop", Localizer["Nav_Shop"]))'/>}</div><div class="pagination">@if(page>1){<a asp-route-page="@(page-1)">@Localizer["Previous"]</a>}@if(page<pages){<a asp-route-page="@(page+1)">@Localizer["Next"]</a>}</div>
