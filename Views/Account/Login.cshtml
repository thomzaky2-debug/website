@model CustomerLoginViewModel
@{ViewData["Title"]=Localizer["Customer_Login"];}
<div class="login-page auth-page"><partial name="_AuthStory"/><section class="login panel"><h1>@Localizer["Welcome_Back"]</h1><p class="muted">@Localizer["Customer_Login_Help"]</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="Email">@Localizer["Email"]</label><input asp-for="Email" type="email" required maxlength="254" autocomplete="username"/><label asp-for="Password">@Localizer["Password"]</label><input asp-for="Password" type="password" required maxlength="128" autocomplete="current-password"/><button class="primary-button">@Localizer["Customer_Login"]</button></form>@if (ViewBag.PhoneLoginAvailable == true)
{<p class="account-switch"><a asp-action="LoginPhone" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Login_With_Phone"]</a></p>}<p class="account-switch"><a asp-area="" asp-controller="PasswordRecovery" asp-action="Forgot">@Localizer["Recovery_Forgot"]</a></p><p class="account-switch">@Localizer["New_To_NileShop"] <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Customer_Signup"]</a></p></section></div>
