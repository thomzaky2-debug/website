@model CustomerProfileViewModel
@{ViewData["Title"]=Localizer["Your_Account"];var initial=string.IsNullOrWhiteSpace(Model.FullName)?"N":Model.FullName.Trim()[..1];}
<div class="customer-account-page">
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">Home</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["Your_Account"]</li></ol></nav>
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Your_Account"]</span><h1>@Localizer["Your_Account"]</h1><p class="muted">@Localizer["Profile_Intro"]</p></div><a class="action-link" asp-controller="Home" asp-action="Index">← @Localizer["Nav_Home"]</a></div>
<div class="customer-account-layout"><aside class="account-sidebar panel"><div class="account-person"><span class="account-avatar" aria-hidden="true">@initial</span><strong>@Model.FullName</strong><small>@Model.Email</small></div><partial name="_AccountNavigation"/><form asp-action="Logout" method="post"><button class="account-logout">@Localizer["Nav_Logout"]</button></form></aside>
<section class="account-profile-panel panel"><header><h2>@Localizer["Contact_Details"]</h2><p class="muted">@Localizer["Profile_Checkout_Help"]</p></header><form asp-action="Profile" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><div class="profile-fields"><div class="field"><label asp-for="FullName">@Localizer["CustomerName"]</label><input asp-for="FullName" required maxlength="100" autocomplete="name"/><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Phone">@Localizer["CustomerPhone"]</label><input asp-for="Phone" type="tel" required maxlength="30" autocomplete="tel"/><span asp-validation-for="Phone"></span></div><div class="field profile-email"><span class="profile-label">@Localizer["Email"]</span><p>@Model.Email</p></div></div><div class="profile-form-actions"><button class="primary-button">@Localizer["Save_And_Home"]</button><a asp-controller="Home" asp-action="Index">@Localizer["Cancel"]</a></div></form></section></div></div>
