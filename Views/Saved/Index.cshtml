@model IReadOnlyList<ProductCard>
@{ViewData["Title"]=Localizer["Saved_Items"];}
<partial name="_AccountNavigation"/>
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">@Localizer["Nav_Home"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["Saved_Items"]</li></ol></nav>
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Your_Account"]</span><h1>@Localizer["Saved_Items"]</h1><p class="muted">@Localizer["Saved_Help"]</p></div><a asp-controller="Home" asp-action="Shop">@Localizer["Nav_Shop"] →</a></div>
@if(!Model.Any()){<div class="panel empty"><h2>@Localizer["Saved_Empty"]</h2><p>@Localizer["Saved_Help"]</p><a class="primary-button" asp-controller="Home" asp-action="Shop">@Localizer["Nav_Shop"]</a></div>}else{<div class="product-grid">@foreach(var product in Model){<div><partial name="_ProductCard" model="product"/><form asp-action="Remove" method="post" class="saved-remove" data-async-form><input type="hidden" name="productId" value="@product.Id"/><button>@Localizer["Remove"]</button></form></div>}</div>}
