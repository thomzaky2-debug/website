@{ ViewData["Title"] = Localizer["Product_Unavailable_Title"]; }
<div class="product-unavailable-page">
    <section class="panel product-unavailable-card" aria-labelledby="unavailable-title">
        <span class="eyebrow">Chic & Unique · @Localizer["Nav_Shop"]</span>
        <div class="product-unavailable-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14l1 13H4L5 7Z"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/><path d="M9 13h6"/></svg>
        </div>
        <h1 id="unavailable-title">@Localizer["Product_Unavailable_Title"]</h1>
        <p class="muted">@Localizer["Product_Unavailable_Help"]</p>
        <div class="status-actions">
            <a class="primary-button" asp-controller="Home" asp-action="Shop">@Localizer["Explore_Collection"] →</a>
            <a class="action-link" asp-controller="Home" asp-action="Index">@Localizer["Nav_Home"]</a>
        </div>
    </section>
    <section class="recently-viewed-section" id="recentlyViewed" style="display:none"></section>
</div>
