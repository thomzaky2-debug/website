@model ProductDetailsViewModel
@{ViewData["Title"]=Model.Product.Name;var photos=Model.Gallery??new[]{Model.Product.ImageUrl};var available=Model.Product.StockQuantity>0;var discount=Model.Product.OldPrice>Model.Product.Price?(int)((1-Model.Product.Price/Model.Product.OldPrice.Value)*100):0;var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";}
<div class="product-detail-page">
<nav class="product-breadcrumb" aria-label="@Localizer["Nav_Shop"]"><a asp-controller="Home" asp-action="Shop">@Localizer["Nav_Shop"]</a><span aria-hidden="true">/</span><a asp-controller="Home" asp-action="Shop" asp-route-category="@Model.CategorySlug">@Model.Product.Category</a><span aria-hidden="true">/</span><span>@Model.Product.Name</span></nav>
<section class="product-detail-layout">
<div class="product-gallery"><div class="product-main-image">@if(discount>0){<span class="product-discount">−@discount%</span>}<a href="@Model.Product.ImageUrl" class="product-zoom-link" data-product-zoom aria-label="@Localizer["View_Product_Image"]"><img class="detail-image" src="@Model.Product.ImageUrl" alt="@Model.Product.Name" fetchpriority="high"/><span>@Localizer["View_Product_Image"] ↗</span></a></div>@if(photos.Length>1){<div class="gallery-thumbs" aria-label="@Localizer["Product_Images"]">@for(var i=0;i<photos.Length;i++){<button type="button" class="thumbnail" data-preview="@photos[i]" aria-pressed="@(i==0?"true":"false")" aria-label="@Localizer["Product_Images"] @(i+1)"><img src="@photos[i]" alt="" loading="lazy"/></button>}</div>}</div>
<div class="product-purchase"><a class="eyebrow" asp-controller="Home" asp-action="Shop" asp-route-category="@Model.CategorySlug">@Model.Product.Category</a><h1>@Model.Product.Name</h1><div class="product-price-row"><strong>@Model.Product.Price.ToString("N2") <small>EGP</small></strong>@if(discount>0){<del>@Model.Product.OldPrice!.Value.ToString("N2") EGP</del><span>@Localizer["Save"] @discount%</span>}</div><div class="product-availability"><span class="availability-dot @(available?"":"sold-out")" aria-hidden="true"></span><span>@Localizer[available?"Label_InStock":"Label_OutOfStock"]</span>@if(available&&Model.Product.StockQuantity<=5){<small>@Model.Product.StockQuantity @Localizer["Items"]</small>}</div><p class="product-intro">@Model.ShortDescription</p>
<form asp-controller="Cart" asp-action="Add" method="post" class="product-buy-form" data-unit-amount="@Model.Product.Price.ToString(CultureInfo.InvariantCulture)"><input type="hidden" name="productId" value="@Model.Product.Id"/>
@if(Model.Sizes?.Length>0){<div class="field"><label for="size">@Localizer["Options_Size"]</label><select id="size" name="size" required><option value="">@Localizer["Choose"]</option>@foreach(var size in Model.Sizes){<option>@size</option>}</select></div>}
@if(Model.Colors?.Length>0){<div class="field"><label for="color">@Localizer["Options_Color"]</label><select id="color" name="color" required><option value="">@Localizer["Choose"]</option>@foreach(var color in Model.Colors){<option>@color</option>}</select></div>}
<div class="product-quantity-row"><div class="field"><label for="quantity">@Localizer["Quantity"]</label><div class="product-stepper"><button type="button" data-quantity-step="-1" aria-label="@Localizer["Decrease_Quantity"]" disabled="@(!available)">−</button><input id="quantity" name="quantity" type="number" min="1" max="@Math.Max(1,Math.Min(99,Model.Product.StockQuantity))" value="1" disabled="@(!available)"/><button type="button" data-quantity-step="1" aria-label="@Localizer["Increase_Quantity"]" disabled="@(!available)">+</button></div></div><div class="product-subtotal"><small>@Localizer["Total"]</small><strong id="product-subtotal" aria-live="polite">@Model.Product.Price.ToString("N2") EGP</strong></div></div><button type="submit" class="primary-button product-add-button" disabled="@(!available)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16l-1 14H5L4 7ZM8 7V5a4 4 0 0 1 8 0v2"/></svg>@Localizer[available?"Btn_AddToCart":"Label_OutOfStock"]</button><a class="product-cart-link" asp-controller="Cart" asp-action="Index">@Localizer["Nav_Cart"] →</a></form>
<form asp-controller="Saved" asp-action="Save" method="post" class="product-save-detail"><input type="hidden" name="productId" value="@Model.Product.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><button class="action-link">♡ @Localizer["Save_Item"]</button></form>
<div class="product-information"><details open><summary>@Localizer["Description"]</summary><p class="description">@Model.FullDescription</p></details><details><summary>@Localizer["Delivery"]</summary><p>@Localizer["Delivery_EstimateNote"]</p>@foreach(var method in Model.Shipping??[]){<div class="product-delivery-line"><strong>@(ar?method.NameAr:method.NameEn)</strong><span>@method.Fee.ToString("N2") EGP · @method.MinDays–@method.MaxDays @Localizer["Business_Days"]</span></div>}<a asp-controller="Info" asp-action="Delivery">@Localizer["Delivery"] →</a></details><details><summary>@Localizer["Returns"]</summary><p>@Localizer["Returns_Window"]: @Model.ReturnDays @Localizer["Days"]</p><a asp-controller="Info" asp-action="Returns">@Localizer["Returns"] →</a></details></div>
</div></section>
<partial name="_Reviews" model="Model"/>
@if(Model.Related.Any()){<section class="product-related"><div class="section-head"><div><span class="eyebrow">@Model.Product.Category</span><h2>@Localizer["Related"]</h2></div><a asp-controller="Home" asp-action="Shop" asp-route-category="@Model.CategorySlug">@Localizer["View_Category"] →</a></div><div class="product-grid">@foreach(var product in Model.Related){<partial name="_ProductCard" model="product"/>}</div></section>}
<dialog class="product-image-dialog" aria-label="@Localizer["View_Product_Image"]"><button type="button" data-close-zoom aria-label="@Localizer["Close"]">×</button><img alt="@Model.Product.Name"/></dialog>
</div>
