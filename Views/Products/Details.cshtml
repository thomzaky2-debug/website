@model ProductDetailsViewModel
@{ViewData["Title"]=Model.Product.Name;var photos=Model.Gallery??new[]{Model.Product.ImageUrl};var available=Model.Product.StockQuantity>0;var discount=Model.Product.OldPrice>Model.Product.Price?(int)((1-Model.Product.Price/Model.Product.OldPrice.Value)*100):0;var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";
var product=Model.Product;
var ratings = ViewBag.Ratings as Dictionary<int, (double Average, int Count)>;
var hasRating = ratings != null && ratings.ContainsKey(product.Id);
var productUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/products/{product.Slug}";
}
<div class="product-detail-page" data-product-id="@product.Id" data-product-name="@product.Name" data-product-slug="@product.Slug" data-product-image="@product.ImageUrl" data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)">
<nav class="product-breadcrumb" aria-label="@Localizer["Nav_Shop"]"><a asp-controller="Home" asp-action="Shop">@Localizer["Nav_Shop"]</a><span aria-hidden="true">/</span><a asp-controller="Home" asp-action="Shop" asp-route-category="@Model.CategorySlug">@Model.Product.Category</a><span aria-hidden="true">/</span><span>@Model.Product.Name</span></nav>
<section class="product-detail-layout">
<div class="product-gallery"><div class="product-main-image">@if(discount>0){<span class="product-discount">−@discount%</span>}<a href="@Model.Product.ImageUrl" class="product-zoom-link" data-product-zoom aria-label="@Localizer["View_Product_Image"]"><img class="detail-image" src="@Model.Product.ImageUrl" alt="@Model.Product.Name" fetchpriority="high"/><span>@Localizer["View_Product_Image"] ↗</span></a></div>@if(photos.Length>1){<div class="gallery-thumbs" aria-label="@Localizer["Product_Images"]">@for(var i=0;i<photos.Length;i++){<button type="button" class="thumbnail" data-preview="@photos[i]" aria-pressed="@(i==0?"true":"false")" aria-label="@Localizer["Product_Images"] @(i+1)"><img src="@photos[i]" alt="" loading="lazy"/></button>}</div>}</div>
<div class="product-purchase"><a class="eyebrow" asp-controller="Home" asp-action="Shop" asp-route-category="@Model.CategorySlug">@Model.Product.Category</a><h1>@Model.Product.Name</h1>
@if(hasRating){var r = ratings![product.Id];<div class="rating-summary"><span class="rating-avg">@r.Average.ToString("0.0")</span><span class="rating-stars">@for(int i=1;i<=5;i++){<span class="star @(i<=Math.Round(r.Average)?"filled":"")">★</span>}</span><span class="rating-count">(@r.Count reviews)</span><a class="rating-link" href="#product-reviews">See reviews</a></div>}
<div class="social-share">
<span>Share:</span>
<a class="share-btn whatsapp" href="https://wa.me/?text=@Uri.EscapeDataString(product.Name + " — " + productUrl)" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.174-.008-.372-.01-.571-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a>
<a class="share-btn facebook" href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(productUrl)" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg></a>
<a class="share-btn twitter" href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(productUrl)&text=@Uri.EscapeDataString(product.Name)" target="_blank" rel="noopener" aria-label="Share on X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
<button class="share-btn copy-link" data-url="@productUrl" aria-label="Copy link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg></button>
</div>
<div class="product-price-row"><strong>@Model.Product.Price.ToString("N2") <small>EGP</small></strong>@if(discount>0){<del>@Model.Product.OldPrice!.Value.ToString("N2") EGP</del><span>@Localizer["Save"] @discount%</span>}</div><div class="product-availability"><span class="availability-dot @(available?"":"sold-out")" aria-hidden="true"></span><span>@Localizer[available?"Label_InStock":"Label_OutOfStock"]</span>@if(available&&Model.Product.StockQuantity<=5){<small>@Model.Product.StockQuantity @Localizer["Items"]</small>}</div><p class="product-intro">@Model.ShortDescription</p>
<form asp-controller="Cart" asp-action="Add" method="post" class="product-buy-form" data-unit-amount="@Model.Product.Price.ToString(CultureInfo.InvariantCulture)" data-ajax-cart="true"><input type="hidden" name="productId" value="@Model.Product.Id"/>
@if(Model.Sizes?.Length>0){<div class="field"><label for="size">@Localizer["Options_Size"]</label><select id="size" name="size" required><option value="">@Localizer["Choose"]</option>@foreach(var size in Model.Sizes){<option>@size</option>}</select></div>}
@if(Model.Colors?.Length>0){<div class="field"><label for="color">@Localizer["Options_Color"]</label><select id="color" name="color" required><option value="">@Localizer["Choose"]</option>@foreach(var color in Model.Colors){<option>@color</option>}</select></div>}
<div class="product-quantity-row"><div class="field"><label for="quantity">@Localizer["Quantity"]</label><div class="product-stepper"><button type="button" data-quantity-step="-1" aria-label="@Localizer["Decrease_Quantity"]" disabled="@(!available)">−</button><input id="quantity" name="quantity" type="number" min="1" max="@Math.Max(1,Math.Min(99,Model.Product.StockQuantity))" value="1" disabled="@(!available)"/><button type="button" data-quantity-step="1" aria-label="@Localizer["Increase_Quantity"]" disabled="@(!available)">+</button></div></div><div class="product-subtotal"><small>@Localizer["Total"]</small><strong id="product-subtotal" aria-live="polite">@Model.Product.Price.ToString("N2") EGP</strong></div></div><button type="submit" class="primary-button product-add-button" disabled="@(!available)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16l-1 14H5L4 7ZM8 7V5a4 4 0 0 1 8 0v2"/></svg>@Localizer[available?"Btn_AddToCart":"Label_OutOfStock"]</button><a class="product-cart-link" asp-controller="Cart" asp-action="Index">@Localizer["Nav_Cart"] →</a></form>
@{
    var isDetailSaved = (ViewBag.SavedProductIds as HashSet<int>)?.Contains(Model.Product.Id) == true;
}
<form asp-controller="Saved" asp-action="Save" method="post" class="product-save-detail" data-silent-save="true"><input type="hidden" name="productId" value="@Model.Product.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><button type="submit" class="action-link @(isDetailSaved ? "is-saved" : "")" aria-pressed="@(isDetailSaved ? "true" : "false")" data-label="@Localizer["Save_Item"]">@(isDetailSaved ? "♥ " : "♡ ")@Localizer["Save_Item"]</button></form>
<div class="product-information"><details open><summary>@Localizer["Description"]</summary><p class="description">@Model.FullDescription</p></details><details><summary>@Localizer["Delivery"]</summary><p>@Localizer["Delivery_EstimateNote"]</p>@foreach(var method in Model.Shipping??[]){<div class="product-delivery-line"><strong>@(ar?method.NameAr:method.NameEn)</strong><span>@method.Fee.ToString("N2") EGP · @method.MinDays–@method.MaxDays @Localizer["Business_Days"]</span></div>}<a asp-controller="Info" asp-action="Delivery">@Localizer["Delivery"] →</a></details><details><summary>@Localizer["Returns"]</summary><p>@Localizer["Returns_Window"]: @Model.ReturnDays @Localizer["Days"]</p><a asp-controller="Info" asp-action="Returns">@Localizer["Returns"] →</a></details></div>
</div></section>
<section class="product-reviews" id="product-reviews">
@{ await Html.RenderPartialAsync("_Reviews", Model); }
</section>
@if(Model.Related.Any()){<section class="product-related"><div class="section-head"><div><span class="eyebrow">@Model.Product.Category</span><h2>@Localizer["Related"]</h2></div><a asp-controller="Home" asp-action="Shop" asp-route-category="@Model.CategorySlug">@Localizer["View_Category"] →</a></div><div class="product-grid">@foreach(var p in Model.Related){<partial name="_ProductCard" model="p"/>}</div></section>}
<dialog class="product-image-dialog" aria-label="@Localizer["View_Product_Image"]"><button type="button" data-close-zoom aria-label="@Localizer["Close"]"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button><img alt="@Model.Product.Name"/></dialog>
</div>
