@model ProductDetailsViewModel
@{ViewData["Title"]=Model.Product.Name;}
<p class="breadcrumb"><a href="/">@Localizer["Nav_Shop"]</a> / @Model.Product.Category / @Model.Product.Name</p><section class="detail"><div><img class="detail-image" src="@Model.Product.ImageUrl" alt="@Model.Product.Name"/><button class="thumbnail" data-preview="@Model.Product.ImageUrl" aria-label="@Model.Product.Name"><img src="@Model.Product.ImageUrl" alt="@Model.Product.Name"/></button></div><div><small>@Model.Product.Category</small><h1>@Model.Product.Name</h1><p class="price">@Model.Product.Price.ToString("N2") EGP @if(Model.Product.OldPrice.HasValue){<del>@Model.Product.OldPrice.Value.ToString("N2")</del>}</p><p class="stock">@Localizer[Model.Product.StockQuantity > 0 ? "Label_InStock" : "Label_OutOfStock"]</p><p>@Model.ShortDescription</p><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Product.Id"/><label for="quantity">@Localizer["Quantity"]</label><input id="quantity" name="quantity" type="number" min="1" max="@Math.Min(99,Model.Product.StockQuantity)" value="1"/><button class="primary-button" disabled="@(Model.Product.StockQuantity==0)">@Localizer["Btn_AddToCart"]</button></form><h3>@Localizer["Description"]</h3><p class="description">@Model.FullDescription</p></div></section><h2>@Localizer["Related"]</h2><div class="product-grid">@foreach(var p in Model.Related){<partial name="_ProductCard" model="p"/>}</div>