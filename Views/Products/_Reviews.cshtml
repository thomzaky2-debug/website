@model ProductDetailsViewModel
@{var reviews=ViewData["Reviews"] as IReadOnlyList<ProductReview>??[];}
<section class="product-reviews"><div class="section-head"><div><span class="eyebrow">@Localizer["Verified_Purchase"]</span><h2>@Localizer["Customer_Reviews"]</h2></div></div><p class="muted">@Localizer["Review_Help"]</p><div class="review-grid">@foreach(var review in reviews){<article class="panel"><div class="review-heading"><strong aria-label="@review.Rating / 5">@(new string('★',review.Rating))@(new string('☆',5-review.Rating))</strong><small>@Localizer["Verified_Purchase"]</small></div><p class="description">@review.Text</p><small class="muted">@review.DisplayName · @review.CreatedAt.ToString("d")</small></article>}</div>@if(!reviews.Any()){<p class="panel muted">@Localizer["No_Reviews"]</p>}
@if(ViewData["CanReview"] is true){<form asp-controller="Reviews" asp-action="Create" method="post" class="panel review-form"><h3>@Localizer["Write_Review"]</h3><input type="hidden" name="productId" value="@Model.Product.Id"/><label for="review-rating">@Localizer["Rating"]</label><select id="review-rating" name="rating" required><option value="">@Localizer["Choose"]</option>@for(var i=5;i>=1;i--){<option value="@i">@i / 5</option>}</select><label for="review-text">@Localizer["Your_Review"]</label><textarea id="review-text" name="text" required maxlength="1000" rows="4"></textarea><button class="primary-button">@Localizer["Submit_Review"]</button></form>}
</section>
