@model StoreSettings
@functions {
    // Replaces {{DELIVERY_AREAS}} in the editable policy with a live list built from the active delivery areas.
    static string RenderPolicy(string? policy, IEnumerable<ShippingMethod> methods, bool ar)
    {
        var text = policy ?? "";
        if (!text.Contains("{{DELIVERY_AREAS}}", StringComparison.OrdinalIgnoreCase)) return text;
        string Fee(decimal fee) => (fee == decimal.Truncate(fee) ? fee.ToString("N0", CultureInfo.InvariantCulture) : fee.ToString("N2", CultureInfo.InvariantCulture));
        var lines = methods.OrderBy(m => m.Fee).ThenBy(m => m.Id).Select(m => {
            var days = m.MinDays == m.MaxDays ? m.MinDays.ToString() : null;
            return ar
                ? $"• {m.NameAr}: {(days != null ? $"{days} أيام عمل" : $"من {m.MinDays} إلى {m.MaxDays} أيام عمل")} ({Fee(m.Fee)} جنيهًا مصريًا)."
                : $"• {m.NameEn}: {(days != null ? $"{days} business days" : $"{m.MinDays}–{m.MaxDays} business days")} (EGP {Fee(m.Fee)}).";
        }).ToList();
        var replacement = lines.Count > 0 ? string.Join("\n", lines) : (ar ? "• لا توجد مناطق توصيل متاحة حاليًا." : "• No delivery areas are currently available.");
        return System.Text.RegularExpressions.Regex.Replace(text, @"\{\{\s*DELIVERY_AREAS\s*\}\}", replacement.Replace("$", "$$"), System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }
}
@{ViewData["Title"] = Localizer["Delivery"]; var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";var methods=(IEnumerable<ShippingMethod>)ViewData["Methods"]!;}
<div class="info-page">
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">@Localizer["Nav_Home"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["Delivery"]</li></ol></nav>
<span class="eyebrow">NileShop · @Localizer["Footer_Info"]</span><h1>@Localizer["Delivery"]</h1><p class="muted">@Localizer["Delivery_EstimateNote"]</p><div class="info-grid">@foreach(var method in methods){<article class="panel info-card"><small>@Localizer["Shipping_Area"]</small><h2>@(ar?method.NameAr:method.NameEn)</h2><p><strong>@method.Fee.ToString("N2") EGP</strong> · @method.MinDays–@method.MaxDays @Localizer["Business_Days"]</p></article>}</div><div class="panel policy-copy"><h2>@Localizer["Delivery"]</h2><p>@RenderPolicy(ar?Model.DeliveryPolicyAr:Model.DeliveryPolicyEn, methods, ar)</p></div></div>
