@model StoreSettings
@{ViewData["Title"] = Localizer["Delivery"]; var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";var methods=(IEnumerable<ShippingMethod>)ViewData["Methods"]!;}
<div class="info-page"><span class="eyebrow">NileShop · @Localizer["Footer_Info"]</span><h1>@Localizer["Delivery"]</h1><p class="muted">@Localizer["Delivery_EstimateNote"]</p><div class="info-grid">@foreach(var method in methods){<article class="panel info-card"><small>@Localizer["Shipping_Area"]</small><h2>@(ar?method.NameAr:method.NameEn)</h2><p><strong>@method.Fee.ToString("N2") EGP</strong> · @method.MinDays–@method.MaxDays @Localizer["Business_Days"]</p></article>}</div><div class="panel policy-copy"><h2>@Localizer["Delivery"]</h2><p>@(ar?Model.DeliveryPolicyAr:Model.DeliveryPolicyEn)</p></div></div>
