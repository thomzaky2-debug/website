@model StoreSettings
@{ViewData["Title"] = Localizer["Returns"]; var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";}
<div class="info-page">
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list"><li class="breadcrumb-item"><a href="/">@Localizer["Nav_Home"]</a></li><li class="breadcrumb-separator" aria-hidden="true">›</li><li class="breadcrumb-item" aria-current="page">@Localizer["Returns"]</li></ol></nav>
<span class="eyebrow">Chic & Unique · @Localizer["Footer_Info"]</span><h1>@Localizer["Returns"]</h1><div class="panel policy-copy"><span class="status-pill">@Model.ReturnDays @Localizer["Days"]</span><h2>@Localizer["Returns_Window"]</h2><p>@(ar?Model.ReturnsPolicyAr:Model.ReturnsPolicyEn)</p><a class="primary-button" asp-action="Contact">@Localizer["Contact"]</a></div></div>
