@model StoreSettings
@{ViewData["Title"] = Localizer["Returns"]; var ar=CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";}
<div class="info-page"><span class="eyebrow">NileShop · @Localizer["Footer_Info"]</span><h1>@Localizer["Returns"]</h1><div class="panel policy-copy"><span class="status-pill">@Model.ReturnDays @Localizer["Days"]</span><h2>@Localizer["Returns_Window"]</h2><p>@(ar?Model.ReturnsPolicyAr:Model.ReturnsPolicyEn)</p><a class="primary-button" asp-action="Contact">@Localizer["Contact"]</a></div></div>
