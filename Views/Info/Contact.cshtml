@model StoreSettings
@{ViewData["Title"] = Localizer["Contact"];}
<div class="info-page"><span class="eyebrow">NileShop · @Localizer["Footer_Help"]</span><h1>@Localizer["Contact"]</h1><div class="info-grid">@if(!string.IsNullOrWhiteSpace(Model.ContactEmail)){<div class="panel info-card"><small>@Localizer["Email"]</small><a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a></div>}@if(!string.IsNullOrWhiteSpace(Model.ContactPhone)){<div class="panel info-card"><small>@Localizer["CustomerPhone"]</small><a href="tel:@Model.ContactPhone">@Model.ContactPhone</a></div>}@if(string.IsNullOrWhiteSpace(Model.ContactEmail)&&string.IsNullOrWhiteSpace(Model.ContactPhone)){<div class="panel info-card">@Localizer["Contact_Pending"]</div>}</div>@if(!string.IsNullOrWhiteSpace(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"?Model.AddressAr:Model.AddressEn)){<p class="panel">@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar"?Model.AddressAr:Model.AddressEn)</p>}</div>
