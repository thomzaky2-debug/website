@model (bool Pending, bool Remote)
@{ ViewData["Title"] = Localizer["Otp_Title"]; }
<div class="login-page">
    <section class="login panel">
        <h1>@(Model.Remote ? Localizer["Otp_Title_WhatsApp"].Value : Localizer["Otp_Title"].Value)</h1>
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        @if (Model.Pending)
        {
            <p class="muted">@Localizer["Otp_Intro"]</p>
            <form asp-action="Index" method="post" data-email-otp>
                <label id="otp-code-label">@Localizer["Otp_Code"]</label>
                <div class="otp-boxes" dir="ltr" role="group" aria-labelledby="otp-code-label">
                    @for (var i = 0; i < 6; i++)
                    {
                        <input class="otp-digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6"
                               autocomplete="@(i == 0 ? "one-time-code" : "off")"
                               aria-label="@Localizer["Otp_Digit", i + 1]" />
                    }
                </div>
                <input id="otp-code" name="code" type="hidden" />
                <noscript>
                    <style>.otp-boxes{display:none}</style>
                    <label for="otp-code-noscript">@Localizer["Otp_Code"]</label>
                    <input id="otp-code-noscript" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
                           dir="ltr" minlength="6" maxlength="6" pattern="[0-9]{6}" />
                    <button type="submit" class="primary-button">@Localizer["Otp_Verify"]</button>
                </noscript>
            </form>
        }
        else
        {
            <p role="status">@Localizer["Otp_Expired"]</p>
        }
        <p class="account-switch"><a asp-controller="Account" asp-action="Login">@Localizer["Customer_Login"]</a></p>
    </section>
</div>
