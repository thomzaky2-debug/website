@using NileShop.Services
@using NileShop.Models
@model NileShop.Controllers.OfferFormViewModel
@{ViewData["Title"]=Localizer[Model.Id==0?"Offer_New":"Offer_Edit"];}
<div class="section-head"><div><span class="eyebrow">Chic & Unique · @Localizer["Admin_Navigation"]</span><h1>@ViewData["Title"]</h1></div></div>
@if(Model.Error is not null){<div class="alert error" role="alert">@Localizer[Model.Error]</div>}
<form asp-action="Save" method="post" class="panel offer-form">
<input type="hidden" asp-for="Id"/>
<label>@Localizer["Offer_TitleAr"]<input asp-for="TitleAr" maxlength="150" required dir="rtl"/></label>
<label>@Localizer["Offer_TitleEn"]<input asp-for="TitleEn" maxlength="150" required dir="ltr"/></label>
<label>@Localizer["Offer_BadgeAr"]<input asp-for="BadgeAr" maxlength="40" dir="rtl"/></label>
<label>@Localizer["Offer_BadgeEn"]<input asp-for="BadgeEn" maxlength="40" dir="ltr"/></label>
<label>@Localizer["Offer_Type"]<select asp-for="Kind"><option value="Percent">@Localizer["Offer_Kind_Percent"]</option><option value="Fixed">@Localizer["Offer_Kind_Fixed"]</option><option value="FreeDelivery">@Localizer["Offer_Kind_FreeDelivery"]</option><option value="OrderPercent">@Localizer["Offer_Kind_OrderPercent"]</option><option value="OrderFixed">@Localizer["Offer_Kind_OrderFixed"]</option></select></label>
<label>@Localizer["Offer_Value"]<input asp-for="Value" inputmode="decimal" dir="ltr"/></label>
<label>@Localizer["Offer_MinSubtotal"]<input asp-for="MinSubtotal" inputmode="decimal" dir="ltr"/></label>
<label>@Localizer["Offer_Scope"]<select asp-for="Scope"><option value="All">@Localizer["Offer_Scope_All"]</option><option value="Category">@Localizer["Offer_Scope_Category"]</option><option value="Products">@Localizer["Offer_Scope_Products"]</option></select></label>
<label>@Localizer["Categories"]<select asp-for="CategoryId"><option value="">-</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>}</select></label>
<details class="admin-collapsible"><summary>@Localizer["Offer_PickProducts"]</summary><div class="offer-products">@foreach(var p in Model.Products){<label class="check"><input type="checkbox" name="ProductIds" value="@p.Id" checked="@Model.ProductIds.Contains(p.Id)"/> <span>@p.Name</span></label>}</div></details>
<label>@Localizer["Offer_Starts"]<input asp-for="StartsAt" type="datetime-local" dir="ltr"/></label>
<label>@Localizer["Offer_Ends"]<input asp-for="EndsAt" type="datetime-local" dir="ltr"/></label>
<label class="check"><input asp-for="IsActive" type="checkbox"/> <span>@Localizer["Offer_Active"]</span></label>
<p class="muted">@Localizer["Offer_Help"]</p>
<button class="primary-button">@Localizer["Save"]</button> <a class="offer-btn" asp-action="Index">@Localizer["Cancel"]</a>
</form>
