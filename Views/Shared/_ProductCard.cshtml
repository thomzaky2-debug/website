@model ProductCard
<article class="product"><form asp-controller="Saved" asp-action="Save" method="post" class="save-product-form"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@(Context.Request.Path+Context.Request.QueryString)"/><button type="submit" title="@Localizer["Save_Item"]" aria-label="@Localizer["Save_Item"] @Model.Name"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button></form><a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug"><div class="product-image"><img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy"/>@if(Model.OldPrice > Model.Price){<span class="badge">−@((int)((1-Model.Price/Model.OldPrice.Value)*100))%</span>}</div><small>@Model.Category</small><h3>@Model.Name</h3></a><div class="price">@Model.Price.ToString("N2") EGP @if(Model.OldPrice.HasValue){<del>@Model.OldPrice.Value.ToString("N2")</del>}</div>@if(Model.HasOptions){<a class="primary-button" asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug">@Localizer["Choose_Options"]</a>}else{<form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id"/><button class="primary-button" disabled="@(Model.StockQuantity == 0)">@Localizer[Model.StockQuantity == 0 ? "Label_OutOfStock" : "Btn_AddToCart"]</button></form>}</article>