@model ProductCard
@{
    var ratings = ViewBag.Ratings as Dictionary<int, (double Average, int Count)>;
    var hasRating = ratings != null && ratings.ContainsKey(Model.Id);
    var bestsellerIds = ViewBag.BestsellerIds as HashSet<int>;
    var isBestseller = bestsellerIds != null && bestsellerIds.Contains(Model.Id);
    var isLowStock = Model.StockQuantity > 0 && Model.StockQuantity <= 5;
    var hasDiscount = Model.HasDiscount;
    var discountPct = Model.DiscountPercentage;
    var savedIds = ViewBag.SavedProductIds as HashSet<int>;
    var isSaved = savedIds != null && savedIds.Contains(Model.Id);
}
<article class="product"><form asp-controller="Saved" asp-action="Save" method="post" class="save-product-form" data-silent-save="true"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@(Context.Request.Path+Context.Request.QueryString)"/><button type="submit" class="@(isSaved ? "is-saved" : "")" aria-pressed="@(isSaved ? "true" : "false")" title="@Localizer["Save_Item"]" aria-label="@Localizer["Save_Item"] @Model.Name"><svg viewBox="0 0 24 24" width="19" height="19" fill="@(isSaved ? "#e11d48" : "none")" stroke="@(isSaved ? "#e11d48" : "currentColor")" stroke-width="1.7" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button></form><a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug"><div class="product-image"><img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy"/><div class="product-badges">@if(hasDiscount){<span class="badge-tag badge-sale">-@discountPct%</span>}@if(isBestseller){<span class="badge-tag badge-bestseller">@Localizer["Studio_Bestseller"]</span>}@if(Model.IsNew){<span class="badge-tag badge-new">@Localizer["Studio_New"]</span>}@if(isLowStock){<span class="badge-tag badge-low-stock">@Localizer["Studio_Low_Stock"]</span>}</div></div><small>@Model.Category</small><h3>@Model.Name</h3></a><div class="price">@Model.Price.ToString("N2") EGP @if(Model.OldPrice.HasValue){<del>@Model.OldPrice.Value.ToString("N2")</del>}</div>@if(hasRating){var r = ratings![Model.Id];<div class="rating-summary"><span class="rating-stars">@for(int i=1;i<=5;i++){<span class="star @(i<=Math.Round(r.Average)?"filled":"")">★</span>}</span><span class="rating-count">(@r.Count)</span></div>}<div class="quick-add">
@if (Model.StockQuantity <= 0)
{
    <span class="quick-add-stock">@Localizer["Label_OutOfStock"]</span>
}
else if (Model.Sizes.Count > 0 || Model.Colors.Count > 0)
{
    <details>
        <summary class="quick-add-trigger" aria-label="@Localizer["Choose_Options"] · @Model.Name" title="@Localizer["Choose_Options"]"><span aria-hidden="true">+</span></summary>
        <partial name="_QuickAddForm" model="Model"/>
    </details>
}
else
{
    <partial name="_QuickAddForm" model="Model"/>
}
</div></article>
