@model ProductCard
<article class="product"><a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug"><div class="product-image"><img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy"/>@if(Model.OldPrice > Model.Price){<span class="badge">−@((int)((1-Model.Price/Model.OldPrice.Value)*100))%</span>}</div><small>@Model.Category</small><h3>@Model.Name</h3></a><div class="price">@Model.Price.ToString("N2") EGP @if(Model.OldPrice.HasValue){<del>@Model.OldPrice.Value.ToString("N2")</del>}</div><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id"/><button class="primary-button" disabled="@(Model.StockQuantity == 0)">@Localizer[Model.StockQuantity == 0 ? "Label_OutOfStock" : "Btn_AddToCart"]</button></form></article>