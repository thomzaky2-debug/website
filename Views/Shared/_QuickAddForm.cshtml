@model ProductCard
@{ var needsOptions = Model.Sizes.Count > 0 || Model.Colors.Count > 0; }
<form asp-controller="Cart" asp-action="Add" method="post" data-ajax-cart="true" class="quick-add-form">
    <input type="hidden" name="productId" value="@Model.Id"/>
    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)"/>
    @if (Model.Sizes.Count > 0)
    {
        <label>
            @Localizer["Options_Size"]
            <select name="size" required>
                <option value="">@Localizer["Choose"]</option>
                @foreach (var size in Model.Sizes) { <option value="@size">@size</option> }
            </select>
        </label>
    }
    @if (Model.Colors.Count > 0)
    {
        <label>
            @Localizer["Options_Color"]
            <select name="color" required>
                <option value="">@Localizer["Choose"]</option>
                @foreach (var color in Model.Colors) { <option value="@color">@color</option> }
            </select>
        </label>
    }
    @if (needsOptions)
    {
        <button type="submit" class="primary-button">@Localizer["Btn_AddToCart"]</button>
    }
    else
    {
        <button type="submit" class="quick-add-trigger" aria-label="@Localizer["Btn_AddToCart"] · @Model.Name" title="@Localizer["Btn_AddToCart"]"><span aria-hidden="true">+</span></button>
    }
</form>
