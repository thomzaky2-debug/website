@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var ordersCount = ViewBag.AccountOrdersCount as int?;
    var savedCount = ViewBag.AccountSavedCount as int?;
}
<nav class="account-navigation" aria-label="@Localizer["Your_Account"]">
    <a asp-controller="Account" asp-action="Index" aria-current="@(controller=="Account"&&action!="Orders"?"page":null)">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.8-3.6 5-5.5 8-5.5s6.2 1.9 8 5.5"/></svg>
        <span>@Localizer["Your_Account"]</span>
    </a>
    <a asp-controller="Account" asp-action="Orders" aria-current="@(controller=="Account"&&action=="Orders"?"page":null)">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>@Localizer["My_Orders"]</span>
        @if (ordersCount.HasValue) { <em class="account-nav-badge">@ordersCount.Value</em> }
    </a>
    <a asp-controller="Saved" asp-action="Index" aria-current="@(controller=="Saved"?"page":null)">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg>
        <span>@Localizer["Saved_Items"]</span>
        @if (savedCount.HasValue) { <em class="account-nav-badge">@savedCount.Value</em> }
    </a>
    <a asp-controller="Orders" asp-action="Track" aria-current="@(controller=="Orders"?"page":null)">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>@Localizer["Track_Order"]</span>
    </a>
</nav>
