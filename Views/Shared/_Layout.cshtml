@inject CartService Cart
@inject NileShop.Data.ApplicationDbContext LayoutDb
@{var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; var admin = User.IsInRole("Admin"); var currentAction=ViewContext.RouteData.Values["action"]?.ToString(); var currentController=ViewContext.RouteData.Values["controller"]?.ToString(); var socialLinks = LayoutDb.StoreSettings.OrderBy(s => s.Id).Select(s => new { s.FacebookUrl, s.InstagramUrl, s.TwitterUrl, s.WhatsAppUrl }).FirstOrDefault();}
<!doctype html>
<html class="no-js" lang="@lang" dir="@(lang == "ar" ? "rtl" : "ltr")">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  @if (ViewData["Robots"] is string robots) {<meta name="robots" content="@robots"/>}
  <meta name="theme-color" content="#073349"/>@if (LanguagePreferences.IsAdminContext(Context)) {<link rel="manifest" href="~/manifest-admin.webmanifest"/><meta name="mobile-web-app-capable" content="yes"/>}<meta name="description" content="Chic & Unique · @Localizer["Hero_Tag"]"/>
  <title>@ViewData["Title"] · Chic &amp; Unique</title>
  <script nonce="@Context.Items["CspNonce"]">try{var _dm=localStorage.getItem('darkMode');if(_dm==='true'||(_dm===null&&window.matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark-mode');}catch(e){}</script>
  <link rel="icon" type="image/png" href="~/assets/favicon/favicon.png"/>
  <link rel="shortcut icon" href="~/assets/favicon/favicon.ico"/>
  <link rel="apple-touch-icon" href="~/assets/favicon/icon-192.png"/>
  <link rel="stylesheet" href="~/assets/css/style.css"/><link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/rtl-overrides.css"/><link rel="stylesheet" href="~/assets/css/polish.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/responsive.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/enhancements.css" asp-append-version="true"/>
  <link rel="stylesheet" href="~/assets/css/device-layout.css" asp-append-version="true"/>
  <link rel="stylesheet" href="~/assets/css/product-editor.css" asp-append-version="true"/>
  <link rel="stylesheet" href="~/assets/css/storefront-studio.css" asp-append-version="true"/>
  <meta property="og:title" content="@(ViewData["og:title"] ?? "Chic & Unique — Clothes | Perfume | Shoes")" />
  <meta property="og:description" content="@(ViewData["og:description"] ?? "Discover fashion, perfumes, and shoes at Chic & Unique")" />
  <meta property="og:image" content="@(ViewData["og:image"] ?? "/assets/img/logo.png")" />
  <meta property="og:type" content="@(ViewData["og:type"] ?? "website")" />
  <meta property="og:url" content="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
  <meta name="twitter:card" content="summary_large_image" />
  <script nonce="@Context.Items["CspNonce"]" type="application/ld+json">{ "@@context": "https://schema.org", "@@type": "WebSite", "name": "Chic & Unique", "url": "@Context.Request.Scheme://@Context.Request.Host" }</script>
  @if (ViewData["JsonLd"] != null) {<script nonce="@Context.Items["CspNonce"]" type="application/ld+json">@Html.Raw(ViewData["JsonLd"])</script>}
<link rel="stylesheet" href="~/assets/css/notifications.css" asp-append-version="true"/>
<script src="~/assets/js/notifications.js" asp-append-version="true" defer></script>
</head>
<body class="@(LanguagePreferences.IsAdminContext(Context)?"admin-site":"storefront-site")" data-async-error="@Localizer["Async_Update_Error"]" data-async-session="@Localizer["Async_Session_Expired"]" data-show-password="@Localizer["Show_Password"]" data-hide-password="@Localizer["Hide_Password"]" data-cart-added="@Localizer["Cart_Added"]" data-link-copied="@Localizer["Studio_Link_Copied"]" data-copy-error="@Localizer["Studio_Copy_Error"]">
<a class="skip" href="#main">@Localizer["Skip_Content"]</a>
<header class="site-header @(admin ? "admin-header" : "")"><div class="container nav">
  <a class="brand" href="@(admin ? "/Admin/Dashboard" : "/")" aria-label="Chic &amp; Unique"><img src="~/assets/img/logo.png" alt="Chic &amp; Unique" class="brand-logo-img"/><span>Chic &amp; Unique</span></a>
  @if (IsSectionDefined("HeaderSearch"))
  {
      @await RenderSectionAsync("HeaderSearch")
  }
  else if (!admin && !LanguagePreferences.IsAdminContext(Context))
  {
      <details class="header-search" id="header-search-details" open>
          <summary aria-label="@Localizer["Search"]"><partial name="_StoreIcon" model='@("search")'/></summary>
          <form class="header-search-form" asp-controller="Home" asp-action="Shop" method="get" role="search">
              <label class="sr-only" for="header-search-query">@Localizer["Search"]</label>
              <input id="header-search-query" name="q" type="search" maxlength="100" required placeholder="@Localizer["Search"]"/>
              <button type="submit" aria-label="@Localizer["Search"]"><partial name="_StoreIcon" model='@("search")'/></button>
          </form>
      </details>
  }
  <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="@Localizer["Menu"]" data-open-label="@Localizer["Menu"]" data-close-label="@Localizer["Close_Menu"]"><span></span><span></span><span></span></button>
  <nav id="site-nav" class="site-nav" aria-label="@Localizer["Menu"]">
    @if(!admin){
    <a href="/" aria-current="@(currentController=="Home" && currentAction=="Index"?"page":null)">@Localizer["Nav_Home"]</a><a asp-controller="Home" asp-action="Shop" aria-current="@(currentController=="Home" && currentAction=="Shop"?"page":null)">@Localizer["Nav_Shop"]</a><a asp-controller="Orders" asp-action="Track" aria-current="@(currentController=="Orders"?"page":null)">@Localizer["Track_Order"]</a>
    <a asp-controller="Saved" asp-action="Index" aria-current="@(currentController=="Saved"?"page":null)">@Localizer["Saved_Items"]</a>
    <a class="cart-link" asp-controller="Cart" asp-action="Index" aria-current="@(currentController=="Cart"?"page":null)">@Localizer["Nav_Cart"] <span class="cart-count">@Cart.Count</span></a>
    }
    @if(!admin && User.Identity?.IsAuthenticated == true){<a href="/Account/Notifications">@Localizer["Notifications"] <span class="notification-badge" data-notification-count aria-live="polite" hidden></span></a>}
    @if(admin){<partial name="_AdminNavigation"/><form asp-area="Identity" asp-page="/Account/Logout" method="post"><button>@Localizer["Nav_Logout"]</button></form>}
    @if(!admin){if(User.Identity?.IsAuthenticated==true){<a asp-controller="Account" asp-action="Orders" aria-current="@(currentController=="Account" && currentAction=="Orders"?"page":null)">@Localizer["My_Orders"]</a><a asp-controller="Account" asp-action="Wallet" aria-current="@(currentController=="Account" && currentAction=="Wallet"?"page":null)">@Localizer["Wallet"]</a><a asp-controller="Account" asp-action="Index" aria-current="@(currentController=="Account" && currentAction=="Index"?"page":null)">@Localizer["Your_Account"]</a><form asp-controller="Account" asp-action="Logout" method="post"><button>@Localizer["Nav_Logout"]</button></form>}else{<a asp-controller="Account" asp-action="Login">@Localizer["Customer_Login"]</a><a class="customer-signup" asp-controller="Account" asp-action="Register">@Localizer["Customer_Signup"]</a>}}
    <button class="dark-mode-toggle" type="button" aria-label="@Localizer["Studio_Theme"]"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button>
    <form asp-controller="Home" asp-action="SetLanguage" method="post"><input type="hidden" name="culture" value="@(lang == "ar" ? "en" : "ar")"/><input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"/><button class="language-switch" lang="@(lang == "ar" ? "en" : "ar")">@(lang == "ar" ? "English" : "العربية")</button></form>
  </nav>
</div></header>

<main id="main" class="container">@foreach(var key in new[]{"Success","Error"}){if(TempData[key] is string message){<div class="notice" role="@(key == "Error" ? "alert" : "status")" data-page-toast="@key.ToLowerInvariant()">@Localizer[message]</div>}}@RenderBody()</main>
<div class="mini-cart-overlay" id="miniCartOverlay" hidden data-loading-text="@Localizer["Studio_Cart_Loading"]" data-error-text="@Localizer["Studio_Cart_Error"]" data-empty-text="@Localizer["Error_CartEmpty"]" data-shop-text="@Localizer["Explore_Collection"]" data-qty-text="@Localizer["Quantity"]"><div class="mini-cart-drawer" id="miniCartDrawer" role="dialog" aria-modal="true" aria-labelledby="mini-cart-title"><div class="mini-cart-header"><h3 id="mini-cart-title">@Localizer["Nav_Cart"]</h3><button type="button" class="mini-cart-close" aria-label="@Localizer["Close"]"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div><div class="mini-cart-items" id="miniCartItems"></div><div class="mini-cart-footer" id="miniCartFooter"><div class="mini-cart-total"><span>@Localizer["Total"]:</span> <strong id="miniCartTotal">0.00 EGP</strong></div><div class="mini-cart-actions"><a href="/Cart" class="btn btn-outline">@Localizer["Nav_Cart"]</a><a href="/Cart/Checkout" class="btn btn-primary">@Localizer["Checkout"]</a></div></div></div></div>
@if(!admin){<a class="floating-cart" asp-controller="Cart" asp-action="Index" aria-label="@Localizer["Nav_Cart"]"><partial name="_StoreIcon" model='@("cart")'/><span class="cart-count" aria-hidden="true">@Cart.Count</span></a>}
<div class="cookie-consent" id="cookieConsent"><div class="cookie-consent-text">@Localizer["Studio_Cookies"]</div><button class="cookie-consent-btn" id="acceptCookies">@Localizer["Studio_Got_It"]</button></div>
<script src="~/assets/js/async-updates.js" asp-append-version="true"></script>
<script src="~/assets/js/app.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)
@if (LanguagePreferences.IsAdminContext(Context)) {<script nonce="@Context.Items["CspNonce"]">if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js');});}</script>}
</body></html>
