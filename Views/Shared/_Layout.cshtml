@inject CartService Cart
@{var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; var admin = User.IsInRole("Admin"); var currentAction=ViewContext.RouteData.Values["action"]?.ToString(); var currentController=ViewContext.RouteData.Values["controller"]?.ToString();}
<!doctype html>
<html class="no-js" lang="@lang" dir="@(lang == "ar" ? "rtl" : "ltr")">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#073349"/><meta name="description" content="NileShop · @Localizer["Hero_Tag"]"/>
  <title>@ViewData["Title"] · NileShop</title>
  <link rel="icon" type="image/svg+xml" href="~/assets/favicon/nileshop.svg"/>
  <link rel="stylesheet" href="~/assets/css/style.css"/><link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/rtl-overrides.css"/><link rel="stylesheet" href="~/assets/css/polish.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/responsive.css" asp-append-version="true"/>
</head>
<body>
<a class="skip" href="#main">@Localizer["Skip_Content"]</a>
<div class="announcement"><div class="container"><span>@Localizer["Announcement"]</span><a asp-controller="Info" asp-action="Delivery">@Localizer["Delivery"] →</a></div></div>
<header class="site-header"><div class="container nav">
  <a class="brand" href="/" aria-label="NileShop"><img src="~/assets/favicon/nileshop.svg" alt=""/><span>NileShop</span></a>
  <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="@Localizer["Menu"]" data-open-label="@Localizer["Menu"]" data-close-label="@Localizer["Close_Menu"]"><span></span><span></span><span></span></button>
  <nav id="site-nav" class="site-nav" aria-label="@Localizer["Menu"]">
    <a href="/" aria-current="@(currentController=="Home" && currentAction=="Index"?"page":null)">@Localizer["Nav_Home"]</a><a asp-controller="Home" asp-action="Shop" aria-current="@(currentController=="Home" && currentAction=="Shop"?"page":null)">@Localizer["Nav_Shop"]</a><a asp-controller="Orders" asp-action="Track">@Localizer["Track_Order"]</a>
    <a asp-controller="Saved" asp-action="Index">@Localizer["Saved_Items"]</a>
    <a class="cart-link" asp-controller="Cart" asp-action="Index">@Localizer["Nav_Cart"] <span class="cart-count">@Cart.Count</span></a>
    @if(admin){<a class="admin-link" asp-controller="Admin" asp-action="Dashboard">@Localizer["Nav_Dashboard"]</a><form asp-area="Identity" asp-page="/Account/Logout" method="post"><button>@Localizer["Nav_Logout"]</button></form>}
    @if(!admin){if(User.Identity?.IsAuthenticated==true){<a asp-controller="Account" asp-action="Index">@Localizer["Your_Account"]</a><form asp-controller="Account" asp-action="Logout" method="post"><button>@Localizer["Nav_Logout"]</button></form>}else{<a asp-controller="Account" asp-action="Login">@Localizer["Customer_Login"]</a><a class="customer-signup" asp-controller="Account" asp-action="Register">@Localizer["Customer_Signup"]</a>}}
    <form asp-controller="Home" asp-action="SetLanguage" method="post"><input type="hidden" name="culture" value="@(lang == "ar" ? "en" : "ar")"/><input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"/><button class="language-switch" lang="@(lang == "ar" ? "en" : "ar")">@(lang == "ar" ? "English" : "العربية")</button></form>
  </nav>
</div></header>
@if(admin){<div class="admin-bar"><nav class="container" aria-label="@Localizer["Admin_Navigation"]"><a asp-controller="Admin" asp-action="Dashboard">@Localizer["Nav_Dashboard"]</a><a asp-controller="StoreAdmin" asp-action="Index">@Localizer["Operations"]</a><a asp-controller="StoreAdmin" asp-action="Settings">@Localizer["Store_Settings"]</a><a asp-controller="StoreAdmin" asp-action="Customers">@Localizer["Customers"]</a><a asp-controller="StoreAdmin" asp-action="Reviews">@Localizer["Review_Moderation"]</a><a asp-controller="StoreAdmin" asp-action="Reports">@Localizer["Sales_Reports"]</a><a asp-controller="Admin" asp-action="CreateProduct">@Localizer["CreateProduct"]</a></nav></div>}
<main id="main" class="container">@foreach(var key in new[]{"Success","Error"}){if(TempData[key] is string message){<div class="notice" role="status">@Localizer[message]</div>}}@RenderBody()</main>
<footer class="site-footer"><div class="container footer-grid"><div><a class="brand" href="/"><img src="~/assets/favicon/nileshop.svg" alt=""/><span>NileShop</span></a><p>@Localizer["Hero_Tag"]</p></div><div><strong>@Localizer["Footer_Help"]</strong><a asp-controller="Account" asp-action="Index">@Localizer["Your_Account"]</a><a asp-controller="Account" asp-action="Orders">@Localizer["My_Orders"]</a><a asp-controller="Saved" asp-action="Index">@Localizer["Saved_Items"]</a><a asp-controller="Orders" asp-action="Track">@Localizer["Track_Order"]</a><a asp-controller="Info" asp-action="Contact">@Localizer["Contact"]</a></div><div><strong>@Localizer["Footer_Info"]</strong><a asp-controller="Info" asp-action="Delivery">@Localizer["Delivery"]</a><a asp-controller="Info" asp-action="Returns">@Localizer["Returns"]</a></div></div><div class="container footer-bottom">© @DateTime.UtcNow.Year NileShop · @Localizer["Footer_Rights"]</div></footer>
<script src="~/assets/js/app.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)
</body></html>
