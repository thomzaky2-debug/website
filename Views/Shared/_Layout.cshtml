@inject CartService Cart
@{var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;}
<!doctype html><html lang="@lang" dir="@(lang == "ar" ? "rtl" : "ltr")"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · BubbleThemeShop</title><link rel="icon" href="~/assets/favicon/favicon.ico"/><link rel="stylesheet" href="~/assets/css/style.css"/><link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/rtl-overrides.css"/></head><body><a class="skip" href="#main">@Localizer["Nav_Shop"]</a><header><div class="topbar"><div class="container">BubbleThemeShop <span>@Localizer["Hero_Tag"]</span></div></div><div class="container nav"><a class="brand" href="/">◉ BubbleShop</a><nav><a href="/">@Localizer["Nav_Home"]</a><a href="/#collection">@Localizer["Nav_Shop"]</a><a asp-controller="Cart" asp-action="Index">@Localizer["Nav_Cart"] (@Cart.Count)</a>@if(User.IsInRole("Admin")){<a asp-controller="Admin" asp-action="Dashboard">@Localizer["Nav_Dashboard"]</a><form asp-area="Identity" asp-page="/Account/Logout" method="post"><button>@Localizer["Nav_Logout"]</button></form>}else{<a href="/Identity/Account/Login">@Localizer["Nav_Login"]</a>}<form asp-controller="Home" asp-action="SetLanguage" method="post"><input type="hidden" name="culture" value="@(lang == "ar" ? "en" : "ar")"/><input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"/><button lang="@(lang == "ar" ? "en" : "ar")">@(lang == "ar" ? "English" : "العربية")</button></form></nav></div></header><main id="main" class="container">@foreach(var key in new[]{"Success","Error"}){if(TempData[key] is string message){<div class="notice" role="status">@Localizer[message]</div>}}@RenderBody()</main><footer><div class="container"><a class="brand" href="/">◉ BubbleShop</a><p>@Localizer["Hero_Tag"]</p><small>© @DateTime.UtcNow.Year BubbleThemeShop. @Localizer["Footer_Rights"]</small></div></footer><script src="~/assets/js/app.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>