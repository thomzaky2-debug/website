@inject CartService Cart
@{var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; var admin = User.IsInRole("Admin"); var currentAction=ViewContext.RouteData.Values["action"]?.ToString(); var currentController=ViewContext.RouteData.Values["controller"]?.ToString();}
<!doctype html>
<html class="no-js" lang="@lang" dir="@(lang == "ar" ? "rtl" : "ltr")">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#073349"/><meta name="description" content="NileShop · @Localizer["Hero_Tag"]"/>
  <title>@ViewData["Title"] · NileShop</title>
  <script>try{var _dm=localStorage.getItem('darkMode');if(_dm==='true'||(_dm===null&&window.matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark-mode');}catch(e){}</script>
  <link rel="icon" type="image/svg+xml" href="~/assets/favicon/nileshop.svg"/>
  <link rel="stylesheet" href="~/assets/css/style.css"/><link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/rtl-overrides.css"/><link rel="stylesheet" href="~/assets/css/polish.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/responsive.css" asp-append-version="true"/><link rel="stylesheet" href="~/assets/css/enhancements.css" asp-append-version="true"/>
  <meta property="og:title" content="@(ViewData["og:title"] ?? "NileShop — Your everyday store")" />
  <meta property="og:description" content="@(ViewData["og:description"] ?? "Discover everyday essentials at NileShop")" />
  <meta property="og:image" content="@(ViewData["og:image"] ?? "/assets/img/og-default.jpg")" />
  <meta property="og:type" content="@(ViewData["og:type"] ?? "website")" />
  <meta property="og:url" content="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json">{ "@@context": "https://schema.org", "@@type": "WebSite", "name": "NileShop", "url": "@Context.Request.Scheme://@Context.Request.Host" }</script>
  @if (ViewData["JsonLd"] != null) {<script type="application/ld+json">@Html.Raw(ViewData["JsonLd"])</script>}
</head>
<body>
<a class="skip" href="#main">@Localizer["Skip_Content"]</a>
<div class="announcement"><div class="container"><span>@Localizer["Announcement"]</span><a asp-controller="Info" asp-action="Delivery">@Localizer["Delivery"] →</a></div></div>
<header class="site-header"><div class="container nav">
  <a class="brand" href="/" aria-label="NileShop"><img src="~/assets/favicon/nileshop.svg" alt=""/><span>NileShop</span></a>
  <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="@Localizer["Menu"]" data-open-label="@Localizer["Menu"]" data-close-label="@Localizer["Close_Menu"]"><span></span><span></span><span></span></button>
  <nav id="site-nav" class="site-nav" aria-label="@Localizer["Menu"]">
    <a href="/" aria-current="@(currentController=="Home" && currentAction=="Index"?"page":null)">@Localizer["Nav_Home"]</a><a asp-controller="Home" asp-action="Shop" aria-current="@(currentController=="Home" && currentAction=="Shop"?"page":null)">@Localizer["Nav_Shop"]</a><a asp-controller="Orders" asp-action="Track">@Localizer["Track_Order"]</a>
    <a asp-controller="Saved" asp-action="Index">@Localizer["Saved_Items"]</a>
    <a class="cart-link" asp-controller="Cart" asp-action="Index">@Localizer["Nav_Cart"] <span class="cart-count">@Cart.Count</span></a>
    @if(admin){<a class="admin-link" asp-controller="Admin" asp-action="Dashboard">@Localizer["Nav_Dashboard"]</a><form asp-area="Identity" asp-page="/Account/Logout" method="post"><button>@Localizer["Nav_Logout"]</button></form>}
    @if(!admin){if(User.Identity?.IsAuthenticated==true){<a asp-controller="Account" asp-action="Index">@Localizer["Your_Account"]</a><form asp-controller="Account" asp-action="Logout" method="post"><button>@Localizer["Nav_Logout"]</button></form>}else{<a asp-controller="Account" asp-action="Login">@Localizer["Customer_Login"]</a><a class="customer-signup" asp-controller="Account" asp-action="Register">@Localizer["Customer_Signup"]</a>}}
    <button class="dark-mode-toggle" type="button" aria-label="Toggle dark mode"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button>
    <form asp-controller="Home" asp-action="SetLanguage" method="post"><input type="hidden" name="culture" value="@(lang == "ar" ? "en" : "ar")"/><input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"/><button class="language-switch" lang="@(lang == "ar" ? "en" : "ar")">@(lang == "ar" ? "English" : "العربية")</button></form>
  </nav>
</div></header>
@if(admin){<div class="admin-bar"><nav class="container" aria-label="@Localizer["Admin_Navigation"]"><a asp-controller="Admin" asp-action="Dashboard">@Localizer["Nav_Dashboard"]</a><a asp-controller="StoreAdmin" asp-action="Index">@Localizer["Operations"]</a><a asp-controller="StoreAdmin" asp-action="Settings">@Localizer["Store_Settings"]</a><a asp-controller="StoreAdmin" asp-action="Customers">@Localizer["Customers"]</a><a asp-controller="StoreAdmin" asp-action="Reviews">@Localizer["Review_Moderation"]</a><a asp-controller="StoreAdmin" asp-action="Reports">@Localizer["Sales_Reports"]</a><a asp-controller="Admin" asp-action="CreateProduct">@Localizer["CreateProduct"]</a></nav></div>}
<main id="main" class="container">@foreach(var key in new[]{"Success","Error"}){if(TempData[key] is string message){<div class="notice" role="status">@Localizer[message]</div>}}@RenderBody()</main>
<footer class="site-footer"><div class="container footer-grid"><div><a class="brand" href="/"><img src="~/assets/favicon/nileshop.svg" alt=""/><span>NileShop</span></a><p>@Localizer["Hero_Tag"]</p><div class="footer-social"><a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg></a><a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg></a><a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a><a href="#" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.174-.008-.372-.01-.571-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a></div></div><div><strong>@Localizer["Footer_Help"]</strong><a asp-controller="Account" asp-action="Index">@Localizer["Your_Account"]</a><a asp-controller="Account" asp-action="Orders">@Localizer["My_Orders"]</a><a asp-controller="Saved" asp-action="Index">@Localizer["Saved_Items"]</a><a asp-controller="Orders" asp-action="Track">@Localizer["Track_Order"]</a><a asp-controller="Info" asp-action="Contact">@Localizer["Contact"]</a></div><div><strong>@Localizer["Footer_Info"]</strong><a asp-controller="Info" asp-action="Delivery">@Localizer["Delivery"]</a><a asp-controller="Info" asp-action="Returns">@Localizer["Returns"]</a></div><div><strong>Newsletter</strong><p class="muted" style="font-size:.82rem;margin:0">Get updates and exclusive offers.</p><div class="footer-newsletter"><input type="email" placeholder="Your email" aria-label="Newsletter email"/><button type="button" id="newsletterSubscribe">Subscribe</button></div></div></div><div class="container footer-bottom">© @DateTime.UtcNow.Year NileShop · @Localizer["Footer_Rights"]</div></footer>
<div class="mini-cart-overlay" id="miniCartOverlay"><div class="mini-cart-drawer" id="miniCartDrawer"><div class="mini-cart-header"><h3>Your Cart</h3><button class="mini-cart-close" aria-label="Close cart">&times;</button></div><div class="mini-cart-items" id="miniCartItems"></div><div class="mini-cart-footer" id="miniCartFooter"><div class="mini-cart-total">Subtotal: <strong id="miniCartTotal">EGP 0</strong></div><div class="mini-cart-actions"><a href="/Cart" class="btn btn-outline">View Cart</a><a href="/Cart/Checkout" class="btn btn-primary">Checkout</a></div></div></div></div>
<div class="cookie-consent" id="cookieConsent"><div class="cookie-consent-text">We use cookies for your shopping experience. By continuing, you accept our use of cookies.</div><button class="cookie-consent-btn" id="acceptCookies">Accept</button></div>
<script src="~/assets/js/app.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)
</body></html>
