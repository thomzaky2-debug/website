@model CustomersAdminViewModel
@{ViewData["Title"]=Localizer["Customers"];}
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Admin_Navigation"]</span><h1>@Localizer["Customers"]</h1></div></div><form method="get" class="panel operation-filters"><div class="field"><label for="customer-search">@Localizer["Customer_Search"]</label><input id="customer-search" name="q" value="@Model.Search" maxlength="100"/></div><button class="primary-button">@Localizer["Search"]</button></form><div tabindex="0" role="region" aria-label="@Localizer["Scrollable_Table"]" class="table-scroll admin-data-table"><table><thead><tr><th>@Localizer["CustomerName"]</th><th>@Localizer["Email"]</th><th>@Localizer["CustomerPhone"]</th><th>@Localizer["Orders"]</th></tr></thead><tbody>@foreach(var customer in Model.Customers){<tr><td>@customer.Name</td><td>@customer.Email</td><td>@customer.Phone</td><td>@customer.Orders</td></tr>}</tbody></table>@if(!Model.Customers.Any()){<div class="admin-empty">@Localizer["Empty"]</div>}</div><div class="pagination">@if(Model.Page>1){<a asp-route-q="@Model.Search" asp-route-page="@(Model.Page-1)">@Localizer["Previous"]</a>}@if(Model.Page<Model.Pages){<a asp-route-q="@Model.Search" asp-route-page="@(Model.Page+1)">@Localizer["Next"]</a>}</div>
