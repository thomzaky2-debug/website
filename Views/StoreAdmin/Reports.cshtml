@model ReportViewModel
@{ViewData["Title"] = Localizer["Sales_Reports"];}
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Admin_Navigation"]</span><h1>@Localizer["Sales_Reports"]</h1><p class="muted">@Localizer["Shortcut_Reports"]</p></div><a class="action-link" asp-controller="Admin" asp-action="Dashboard">← @Localizer["Nav_Dashboard"]</a></div>
<form method="get" class="panel operation-filters" data-async-form><div class="field"><label for="report-from">@Localizer["From"]</label><input id="report-from" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"/></div><div class="field"><label for="report-to">@Localizer["To"]</label><input id="report-to" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"/></div><button class="primary-button">@Localizer["Search"]</button><a class="action-link" asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">@Localizer["Export_CSV"]</a></form>
<div class="kpis reports-kpis"><div class="panel"><small>@Localizer["Revenue"]</small><h2>@Model.Days.Sum(d=>d.Collected).ToString("N2") <small>EGP</small></h2></div><div class="panel"><small>@Localizer["Orders"]</small><h2>@Model.Days.Sum(d=>d.Orders)</h2></div><div class="panel"><small>@Localizer["Refunded"]</small><h2>@Model.Refunds.ToString("N2") <small>EGP</small></h2></div></div>
<section><h2>@Localizer["Sales_By_Day"]</h2><div tabindex="0" role="region" aria-label="@Localizer["Scrollable_Table"]" class="table-scroll admin-data-table"><table><thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Orders"]</th><th>@Localizer["Revenue"]</th></tr></thead><tbody>@foreach(var day in Model.Days){<tr><td>@day.Date.ToString("yyyy-MM-dd")</td><td>@day.Orders</td><td class="money">@day.Collected.ToString("N2") EGP</td></tr>}</tbody></table>@if(!Model.Days.Any()){<div class="admin-empty">@Localizer["No_Sales_Period"]</div>}</div></section>
