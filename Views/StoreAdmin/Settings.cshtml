@model StoreSettings
@{
    ViewData["Title"] = Localizer["Store_Settings"];
    var methods = (ViewData["Shipping"] as IEnumerable<ShippingMethod> ?? []).ToList();
    var activeZones = methods.Count(m => m.IsActive);
    var mail = ViewData["Mail"] as MailSettingsViewModel ?? new();
    var gatewayReady = (bool)(ViewData["GatewayReady"] ?? false);
    var gatewayOrigin = ViewData["GatewayOrigin"] as string ?? "";
    var publicUrl = (ViewData["PublicUrl"] as string ?? "").TrimEnd('/');
    var webhookUrl = string.IsNullOrWhiteSpace(publicUrl) ? "/webhooks/nilepay" : $"{publicUrl}/webhooks/nilepay";
}
<div class="settings-page">
  <div class="section-head settings-hero-head">
    <div>
      <span class="eyebrow">Chic & Unique · @Localizer["Nav_Dashboard"]</span>
      <h1>@Localizer["Store_Settings"]</h1>
      <p class="muted">@Localizer["Settings_Intro"]</p>
    </div>
    <a class="action-link" asp-controller="StoreAdmin" asp-action="Index">← @Localizer["Operations"]</a>
  </div>

  <div class="settings-status-strip">
    <a class="settings-kpi panel" href="#shipping">
      <span class="settings-kpi-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </span>
      <div>
        <small>@Localizer["Shipping_Area"]</small>
        <strong>@activeZones / @methods.Count @Localizer["Active"]</strong>
      </div>
    </a>
    <a class="settings-kpi panel" href="#returns">
      <span class="settings-kpi-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
      </span>
      <div>
        <small>@Localizer["Returns_Window"]</small>
        <strong>@Model.ReturnDays @Localizer["Days"]</strong>
      </div>
    </a>
    <a class="settings-kpi panel" href="#email">
      <span class="settings-kpi-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
      </span>
      <div>
        <small>@Localizer["Email_Settings"]</small>
        <span class="status-pill @(mail.Enabled?"":"off")">@Localizer[mail.Enabled?"Active":"Inactive"]</span>
      </div>
    </a>
    <a class="settings-kpi panel" href="#payment">
      <span class="settings-kpi-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
      </span>
      <div>
        <small>@Localizer["Payment_Gateway"]</small>
        <span class="status-pill @(gatewayReady?"":"off")">@Localizer[gatewayReady?"Gateway_Ready":"Gateway_Setup"]</span>
      </div>
    </a>
  </div>

  <div class="settings-shell">
    <nav class="settings-nav" aria-label="@Localizer["Store_Settings"]">
      <a href="#appearance" class="is-active">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        <span>@Localizer["Appearance"]</span>
      </a>
      <a href="#contact">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>@Localizer["Contact"]</span>
      </a>
      <a href="#social">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
        <span>@Localizer["Social_Media"]</span>
      </a>
      <a href="#delivery">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8M16 17H8"/></svg>
        <span>@Localizer["Delivery"]</span>
      </a>
      <a href="#returns">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
        <span>@Localizer["Returns"]</span>
      </a>
      <a href="#shipping">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>@Localizer["Shipping_Area"]</span>
      </a>
      <a href="#email">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        <span>@Localizer["Email_Settings"]</span>
      </a>
      <a href="#payment">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        <span>@Localizer["Payment_Gateway"]</span>
      </a>
    </nav>

    <div class="settings-main">
      <!-- 1. Appearance / Homepage Hero Image -->
      <section id="appearance" class="settings-section panel settings-card">
        <header class="settings-card-head">
          <span class="settings-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
          </span>
          <div>
            <h2>@Localizer["Homepage_Image"]</h2>
            <p class="muted">@Localizer["Hero_Image_Help"]</p>
          </div>
        </header>
        <div class="hero-image-settings">
          <div class="hero-image-frame">
            <img src="@(Model.HeroImageUrl ?? "/assets/img/slider/slider0.jpg")" alt="@Localizer["Homepage_Image"]" class="hero-image-preview"/>
          </div>
          <div class="hero-image-controls">
            <form asp-action="HeroImage" method="post" enctype="multipart/form-data" data-async-form class="hero-upload-form">
              <div class="settings-field">
                <label for="heroImage">@Localizer["Choose_Hero_Image"]</label>
                <input id="heroImage" name="heroImage" type="file" accept="image/jpeg,image/png,image/webp" required aria-describedby="hero-image-help"/>
                <small id="hero-image-help" class="muted">@Localizer["Hero_Image_Format"]</small>
              </div>
              <div class="settings-inline-actions">
                <button type="submit" class="primary-button">@Localizer["Save_Hero_Image"]</button>
              </div>
            </form>
            <form asp-action="HeroImage" method="post" data-async-form class="hero-reset-form">
              <input type="hidden" name="reset" value="true"/>
              <button type="submit" class="btn-account-secondary">@Localizer["Restore_Default_Image"]</button>
            </form>
          </div>
        </div>
      </section>

      <!-- 2. Store Details Form: Contact, Delivery Policy & Returns Policy -->
      <form asp-action="Settings" method="post" data-async-form class="settings-store-form">
        <div asp-validation-summary="All" class="validation"></div>

        <section id="contact" class="settings-section panel settings-card">
          <header class="settings-card-head">
            <span class="settings-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div>
              <h2>@Localizer["Contact"]</h2>
              <p class="muted">@Localizer["Settings_Contact_Help"]</p>
            </div>
          </header>
          <div class="settings-grid">
            <div class="settings-field">
              <label asp-for="ContactEmail">@Localizer["Email"]</label>
              <input asp-for="ContactEmail" type="email" autocomplete="email" placeholder="support@chicandunique.example" dir="ltr"/>
              <span asp-validation-for="ContactEmail"></span>
            </div>
            <div class="settings-field">
              <label asp-for="ContactPhone">@Localizer["CustomerPhone"]</label>
              <input asp-for="ContactPhone" type="tel" autocomplete="tel" placeholder="+20 10 0000 0000" dir="ltr"/>
              <span asp-validation-for="ContactPhone"></span>
            </div>
            <div class="settings-field">
              <label asp-for="AddressEn">@Localizer["Address_En"]</label>
              <input asp-for="AddressEn" dir="ltr"/>
            </div>
            <div class="settings-field">
              <label asp-for="AddressAr">@Localizer["Address_Ar"]</label>
              <input asp-for="AddressAr" dir="rtl"/>
            </div>
          </div>
        </section>

        <section id="social" class="settings-section panel settings-card">
          <header class="settings-card-head">
            <span class="settings-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
            </span>
            <div>
              <h2>@Localizer["Social_Media"]</h2>
              <p class="muted">@Localizer["Settings_Social_Help"]</p>
            </div>
          </header>
          <div class="settings-grid">
            <div class="settings-field">
              <label asp-for="FacebookUrl" class="social-field-label">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
                <span>@Localizer["Social_Facebook"]</span>
              </label>
              <input asp-for="FacebookUrl" type="url" maxlength="500" placeholder="https://facebook.com/yourpage" dir="ltr"/>
              <span asp-validation-for="FacebookUrl"></span>
            </div>
            <div class="settings-field">
              <label asp-for="InstagramUrl" class="social-field-label">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
                <span>@Localizer["Social_Instagram"]</span>
              </label>
              <input asp-for="InstagramUrl" type="url" maxlength="500" placeholder="https://instagram.com/yourhandle" dir="ltr"/>
              <span asp-validation-for="InstagramUrl"></span>
            </div>
            <div class="settings-field">
              <label asp-for="TwitterUrl" class="social-field-label">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                <span>@Localizer["Social_Twitter"]</span>
              </label>
              <input asp-for="TwitterUrl" type="url" maxlength="500" placeholder="https://x.com/yourhandle" dir="ltr"/>
              <span asp-validation-for="TwitterUrl"></span>
            </div>
            <div class="settings-field">
              <label asp-for="WhatsAppUrl" class="social-field-label social-whatsapp">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.174-.008-.372-.01-.571-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                <span>@Localizer["Social_WhatsApp"]</span>
              </label>
              <input asp-for="WhatsAppUrl" type="text" maxlength="500" placeholder="https://wa.me/201012345678 or 01012345678" dir="ltr"/>
              <span asp-validation-for="WhatsAppUrl"></span>
            </div>
          </div>
        </section>

        <section id="delivery" class="settings-section panel settings-card">
          <header class="settings-card-head">
            <span class="settings-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8M16 17H8"/></svg>
            </span>
            <div>
              <h2>@Localizer["Delivery"]</h2>
              <p class="muted">@Localizer["Settings_Delivery_Help"]</p>
            </div>
          </header>
          <div class="settings-grid">
            <div class="settings-field">
              <label asp-for="DeliveryPolicyEn">@Localizer["Delivery_Policy_En"]</label>
              <textarea asp-for="DeliveryPolicyEn" dir="ltr"></textarea>
            </div>
            <div class="settings-field">
              <label asp-for="DeliveryPolicyAr">@Localizer["Delivery_Policy_Ar"]</label>
              <textarea asp-for="DeliveryPolicyAr" dir="rtl"></textarea>
            </div>
          </div>
          <p class="settings-info-note muted">@Localizer["Delivery_Policy_Token_Help"] <code dir="ltr">{{DELIVERY_AREAS}}</code></p>
        </section>

        <section id="returns" class="settings-section panel settings-card">
          <header class="settings-card-head">
            <span class="settings-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
            </span>
            <div>
              <h2>@Localizer["Returns"]</h2>
              <p class="muted">@Localizer["Settings_Returns_Help"]</p>
            </div>
          </header>
          <div class="settings-grid">
            <div class="settings-field wide settings-compact-field">
              <label asp-for="ReturnDays">@Localizer["Returns_Window"] (@Localizer["Days"])</label>
              <input asp-for="ReturnDays" type="number" min="1" max="90"/>
            </div>
            <div class="settings-field wide settings-compact-field">
              <label asp-for="CheckoutSessionLifetimeMinutes">@Localizer["Checkout_Lifetime"] (@Localizer["Minutes"])</label>
              <input asp-for="CheckoutSessionLifetimeMinutes" type="number" min="1" max="1440"/>
              <small class="muted">@Localizer["Checkout_Lifetime_Help"]</small>
            </div>
            <div class="settings-field">
              <label asp-for="ReturnsPolicyEn">@Localizer["Returns_Policy_En"]</label>
              <textarea asp-for="ReturnsPolicyEn" dir="ltr" data-return-window-pattern="@ReturnPolicyWindow.EnglishPattern"></textarea>
            </div>
            <div class="settings-field">
              <label asp-for="ReturnsPolicyAr">@Localizer["Returns_Policy_Ar"]</label>
              <textarea asp-for="ReturnsPolicyAr" dir="rtl" data-return-window-pattern="@ReturnPolicyWindow.ArabicPattern"></textarea>
            </div>
          </div>
          <div class="settings-actions">
            <button type="submit" class="primary-button">@Localizer["Save_Store_Settings"]</button>
          </div>
        </section>
      </form>

      <!-- 3. Shipping / Delivery Areas -->
      <section id="shipping" class="settings-section panel settings-card">
        <header class="settings-card-head">
          <span class="settings-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </span>
          <div>
            <h2>@Localizer["Shipping_Area"]</h2>
            <p class="muted">@Localizer["Settings_Zone_Help"]</p>
          </div>
        </header>

        <div class="shipping-zones-list">
          @foreach (var method in methods)
          {
            <form asp-action="Shipping" method="post" class="shipping-zone-card" data-async-form>
              <input type="hidden" name="Id" value="@method.Id"/>
              <header class="shipping-zone-head">
                <div>
                  <h3>@method.NameEn <span class="muted">· @method.NameAr</span></h3>
                  <small class="muted">@method.Fee.ToString("N2") EGP · @method.MinDays–@method.MaxDays @Localizer["Business_Days"]</small>
                </div>
                <span class="status-pill @(method.IsActive?"":"off")">@Localizer[method.IsActive?"Active":"Inactive"]</span>
              </header>
              <div class="settings-grid">
                <div class="settings-field">
                  <label>@Localizer["Name_En"]</label>
                  <input name="NameEn" value="@method.NameEn" required maxlength="100" dir="ltr"/>
                </div>
                <div class="settings-field">
                  <label>@Localizer["Name_Ar"]</label>
                  <input name="NameAr" value="@method.NameAr" required maxlength="100" dir="rtl"/>
                </div>
              </div>
              <div class="settings-grid settings-grid-3">
                <div class="settings-field">
                  <label>@Localizer["Shipping_Fee"] (EGP)</label>
                  <input name="Fee" type="number" step="0.01" min="0" max="10000" value="@method.Fee.ToString(CultureInfo.InvariantCulture)" required/>
                </div>
                <div class="settings-field">
                  <label>@Localizer["Days_Min"]</label>
                  <input name="MinDays" type="number" min="1" max="60" value="@method.MinDays" required/>
                </div>
                <div class="settings-field">
                  <label>@Localizer["Days_Max"]</label>
                  <input name="MaxDays" type="number" min="1" max="60" value="@method.MaxDays" required/>
                </div>
              </div>
              <div class="shipping-zone-footer">
                <label class="settings-toggle-check">
                  <input name="IsActive" type="checkbox" value="true" checked="@method.IsActive"/>
                  <span>@Localizer["Active"]</span>
                </label>
                <button type="submit" class="btn-account-secondary">@Localizer["Update"]</button>
              </div>
            </form>
          }
        </div>

        <details class="shipping-add-accordion">
          <summary>
            <span>+ @Localizer["Add_Shipping"]</span>
            <span class="security-chevron" aria-hidden="true">⌄</span>
          </summary>
          <form asp-action="Shipping" method="post" class="shipping-add-form" data-async-form>
            <div class="settings-grid">
              <div class="settings-field">
                <label>@Localizer["Name_En"]</label>
                <input name="NameEn" required maxlength="100" dir="ltr"/>
              </div>
              <div class="settings-field">
                <label>@Localizer["Name_Ar"]</label>
                <input name="NameAr" dir="rtl" required maxlength="100"/>
              </div>
            </div>
            <div class="settings-grid settings-grid-3">
              <div class="settings-field">
                <label>@Localizer["Shipping_Fee"] (EGP)</label>
                <input name="Fee" type="number" step="0.01" min="0" max="10000" required/>
              </div>
              <div class="settings-field">
                <label>@Localizer["Days_Min"]</label>
                <input name="MinDays" type="number" min="1" max="60" required/>
              </div>
              <div class="settings-field">
                <label>@Localizer["Days_Max"]</label>
                <input name="MaxDays" type="number" min="1" max="60" required/>
              </div>
            </div>
            <input type="hidden" name="IsActive" value="true"/>
            <div class="settings-card-footer">
              <button type="submit" class="primary-button">@Localizer["Add_Shipping"]</button>
            </div>
          </form>
        </details>
      </section>

      <!-- 4. Order Emails / SMTP -->
      <section id="email" class="settings-section panel settings-card">
        <header class="settings-card-head settings-card-head-split">
          <div class="settings-card-title-group">
            <span class="settings-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            </span>
            <div>
              <h2>@Localizer["Email_Settings"]</h2>
              <p class="muted">@Localizer["Settings_Email_Help"]</p>
            </div>
          </div>
          <span class="status-pill @(mail.Enabled?"":"off")">@Localizer[mail.Enabled?"Active":"Inactive"]</span>
        </header>

        <form asp-action="Mail" method="post" data-async-form>
          <div class="settings-toggle-banner">
            <label class="settings-toggle-check">
              <input name="Enabled" type="checkbox" value="true" checked="@mail.Enabled"/>
              <span>@Localizer["Enable_Email"]</span>
            </label>
            <label class="settings-toggle-check">
              <input name="EnableSsl" type="checkbox" value="true" checked="@mail.EnableSsl"/>
              <span>@Localizer["SMTP_TLS"]</span>
            </label>
          </div>
          <div class="settings-grid">
            <div class="settings-field">
              <label>@Localizer["SMTP_Host"]</label>
              <input name="Host" value="@mail.Host" maxlength="255" autocomplete="off" placeholder="smtp.example.com" dir="ltr"/>
            </div>
            <div class="settings-field">
              <label>@Localizer["SMTP_Port"]</label>
              <input name="Port" type="number" min="1" max="65535" value="@mail.Port" dir="ltr"/>
            </div>
            <div class="settings-field">
              <label>@Localizer["SMTP_Username"]</label>
              <input name="Username" value="@mail.Username" maxlength="255" autocomplete="off" dir="ltr"/>
            </div>
            <div class="settings-field">
              <label>@Localizer["SMTP_Password"]</label>
              <input name="NewPassword" type="password" maxlength="500" autocomplete="new-password" placeholder="@(mail.HasPassword?Localizer["Password_Saved"].Value:"")"/>
              <small class="account-field-hint muted">@Localizer["Password_Leave_Blank"]</small>
            </div>
            <div class="settings-field wide">
              <label>@Localizer["SMTP_From"]</label>
              <input name="From" type="email" value="@mail.From" maxlength="254" placeholder="orders@example.com" dir="ltr"/>
            </div>
          </div>
          <div class="settings-card-footer">
            <button type="submit" class="primary-button">@Localizer["Save_Email_Settings"]</button>
          </div>
        </form>
      </section>

      <!-- 5. Payment Gateway (NilePay) -->
      <section id="payment" class="settings-section panel settings-card">
        <header class="settings-card-head settings-card-head-split">
          <div class="settings-card-title-group">
            <span class="settings-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            </span>
            <div>
              <h2>@Localizer["Payment_Gateway"]</h2>
              <p class="muted">@Localizer["Settings_Payment_Help"]</p>
            </div>
          </div>
          <span class="status-pill @(gatewayReady?"":"off")">@Localizer[gatewayReady?"Gateway_Ready":"Gateway_Setup"]</span>
        </header>

        <dl class="gateway-details-list">
          <div class="gateway-detail-row">
            <dt>@Localizer["API_Origin"]</dt>
            <dd><code dir="ltr">@(string.IsNullOrWhiteSpace(gatewayOrigin) ? "—" : gatewayOrigin)</code></dd>
          </div>
          <div class="gateway-detail-row">
            <dt>@Localizer["Public_URL"]</dt>
            <dd><code dir="ltr">@(string.IsNullOrWhiteSpace(publicUrl) ? "—" : publicUrl)</code></dd>
          </div>
          <div class="gateway-detail-row">
            <dt>@Localizer["Webhook_URL"]</dt>
            <dd class="gateway-copy-wrap">
              <code dir="ltr">@webhookUrl</code>
              <button type="button" class="btn-copy-phone" data-copy-text="@webhookUrl" aria-label="Copy webhook URL">Copy</button>
            </dd>
          </div>
        </dl>
        <p class="settings-info-note muted">@Localizer["Gateway_Secrets_Help"]</p>
      </section>
    </div>
  </div>
</div>
