@model StoreSettings
@{ViewData["Title"] = Localizer["Store_Settings"]; var methods=ViewData["Shipping"] as IEnumerable<ShippingMethod> ?? []; var mail=ViewData["Mail"] as MailSettingsViewModel ?? new();}
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Nav_Dashboard"]</span><h1>@Localizer["Store_Settings"]</h1><p class="muted">@Localizer["Settings_Intro"]</p></div><a asp-controller="StoreAdmin" asp-action="Index">← @Localizer["Operations"]</a></div>
<div class="settings-shell">
  <nav class="settings-nav" aria-label="@Localizer["Store_Settings"]"><a href="#contact">@Localizer["Contact"]</a><a href="#delivery">@Localizer["Delivery"]</a><a href="#returns">@Localizer["Returns"]</a><a href="#email">@Localizer["Email_Settings"]</a><a href="#payment">@Localizer["Payment_Gateway"]</a></nav>
  <div class="settings-main">
    <form asp-action="Settings" method="post">
      <div asp-validation-summary="All" class="validation"></div>
      <section id="contact" class="settings-section"><h2>@Localizer["Contact"]</h2><p>@Localizer["Settings_Contact_Help"]</p><div class="panel settings-grid"><div><label asp-for="ContactEmail">@Localizer["Email"]</label><input asp-for="ContactEmail" type="email" autocomplete="email"/><span asp-validation-for="ContactEmail"></span></div><div><label asp-for="ContactPhone">@Localizer["CustomerPhone"]</label><input asp-for="ContactPhone" type="tel" autocomplete="tel"/><span asp-validation-for="ContactPhone"></span></div><div><label asp-for="AddressEn">@Localizer["Address_En"]</label><input asp-for="AddressEn"/></div><div><label asp-for="AddressAr">@Localizer["Address_Ar"]</label><input asp-for="AddressAr" dir="rtl"/></div></div></section>
      <section id="delivery" class="settings-section"><h2>@Localizer["Delivery"]</h2><p>@Localizer["Settings_Delivery_Help"]</p><div class="panel settings-grid"><div><label asp-for="DeliveryPolicyEn">@Localizer["Delivery_Policy_En"]</label><textarea asp-for="DeliveryPolicyEn"></textarea></div><div><label asp-for="DeliveryPolicyAr">@Localizer["Delivery_Policy_Ar"]</label><textarea asp-for="DeliveryPolicyAr" dir="rtl"></textarea></div></div></section>
      <section id="returns" class="settings-section"><h2>@Localizer["Returns"]</h2><p>@Localizer["Settings_Returns_Help"]</p><div class="panel settings-grid"><div><label asp-for="ReturnDays">@Localizer["Returns_Window"] (@Localizer["Days"])</label><input asp-for="ReturnDays" type="number" min="1" max="90"/></div><div></div><div><label asp-for="ReturnsPolicyEn">@Localizer["Returns_Policy_En"]</label><textarea asp-for="ReturnsPolicyEn"></textarea></div><div><label asp-for="ReturnsPolicyAr">@Localizer["Returns_Policy_Ar"]</label><textarea asp-for="ReturnsPolicyAr" dir="rtl"></textarea></div></div></section>
      <div class="settings-actions"><button class="primary-button">@Localizer["Save_Store_Settings"]</button></div>
    </form>
    <section class="settings-section"><h2>@Localizer["Shipping_Area"]</h2><p>@Localizer["Settings_Zone_Help"]</p>
      @foreach(var method in methods){<form asp-action="Shipping" method="post" class="panel setting-card"><input type="hidden" name="Id" value="@method.Id"/><header><h3>@method.NameEn / @method.NameAr</h3><span class="status-pill @(method.IsActive?"":"off")">@Localizer[method.IsActive?"Active":"Inactive"]</span></header><div class="settings-grid"><div><label>@Localizer["Name_En"]</label><input name="NameEn" value="@method.NameEn" required maxlength="100"/></div><div><label>@Localizer["Name_Ar"]</label><input name="NameAr" value="@method.NameAr" required maxlength="100" dir="rtl"/></div><div><label>@Localizer["Shipping_Fee"] (EGP)</label><input name="Fee" type="number" step="0.01" min="0" max="10000" value="@method.Fee.ToString(CultureInfo.InvariantCulture)" required/></div><div class="settings-grid"><div><label>@Localizer["Days_Min"]</label><input name="MinDays" type="number" min="1" max="60" value="@method.MinDays" required/></div><div><label>@Localizer["Days_Max"]</label><input name="MaxDays" type="number" min="1" max="60" value="@method.MaxDays" required/></div></div><label class="wide"><input name="IsActive" type="checkbox" value="true" checked="@method.IsActive"/> @Localizer["Active"]</label></div><button>@Localizer["Update"]</button></form>}
      <details class="panel"><summary><strong>+ @Localizer["Add_Shipping"]</strong></summary><form asp-action="Shipping" method="post" class="settings-grid"><div><label>@Localizer["Name_En"]</label><input name="NameEn" required maxlength="100"/></div><div><label>@Localizer["Name_Ar"]</label><input name="NameAr" dir="rtl" required maxlength="100"/></div><div><label>@Localizer["Shipping_Fee"] (EGP)</label><input name="Fee" type="number" step="0.01" min="0" max="10000" required/></div><div class="settings-grid"><div><label>@Localizer["Days_Min"]</label><input name="MinDays" type="number" min="1" max="60" required/></div><div><label>@Localizer["Days_Max"]</label><input name="MaxDays" type="number" min="1" max="60" required/></div></div><input type="hidden" name="IsActive" value="true"/><button class="primary-button wide">@Localizer["Add_Shipping"]</button></form></details>
    </section>
    <section id="email" class="settings-section"><h2>@Localizer["Email_Settings"]</h2><p>@Localizer["Settings_Email_Help"]</p><form asp-action="Mail" method="post" class="panel"><div class="settings-grid"><label class="wide"><input name="Enabled" type="checkbox" value="true" checked="@mail.Enabled"/> @Localizer["Enable_Email"]</label><div><label>@Localizer["SMTP_Host"]</label><input name="Host" value="@mail.Host" maxlength="255" autocomplete="off" placeholder="smtp.example.com"/></div><div><label>@Localizer["SMTP_Port"]</label><input name="Port" type="number" min="1" max="65535" value="@mail.Port"/></div><div><label>@Localizer["SMTP_Username"]</label><input name="Username" value="@mail.Username" maxlength="255" autocomplete="off"/></div><div><label>@Localizer["SMTP_Password"]</label><input name="NewPassword" type="password" maxlength="500" autocomplete="new-password" placeholder="@(mail.HasPassword?Localizer["Password_Saved"].Value:"")"/><small class="muted">@Localizer["Password_Leave_Blank"]</small></div><div><label>@Localizer["SMTP_From"]</label><input name="From" type="email" value="@mail.From" maxlength="254" placeholder="orders@example.com"/></div><label><input name="EnableSsl" type="checkbox" value="true" checked="@mail.EnableSsl"/> @Localizer["SMTP_TLS"]</label></div><button class="primary-button">@Localizer["Save_Email_Settings"]</button></form></section>
    <section id="payment" class="settings-section"><h2>@Localizer["Payment_Gateway"]</h2><p>@Localizer["Settings_Payment_Help"]</p><div class="panel"><p><span class="status-pill @((bool)(ViewData["GatewayReady"]??false)?"":"off")">@Localizer[(bool)(ViewData["GatewayReady"]??false)?"Gateway_Ready":"Gateway_Setup"]</span></p><p><strong>@Localizer["API_Origin"]:</strong> @ViewData["GatewayOrigin"]</p><p><strong>@Localizer["Public_URL"]:</strong> @ViewData["PublicUrl"]</p><p><strong>@Localizer["Webhook_URL"]:</strong> @ViewData["PublicUrl"]/webhooks/nilepay</p><p class="muted">@Localizer["Gateway_Secrets_Help"]</p></div></section>
  </div>
</div>
