@model IReadOnlyList<ProductReview>
@{ViewData["Title"]=Localizer["Review_Moderation"];var page=(int)(ViewData["Page"]??1);var pages=(int)(ViewData["Pages"]??1);}
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Admin_Navigation"]</span><h1>@Localizer["Review_Moderation"]</h1></div></div>
@foreach(var review in Model){<article class="panel review-admin-card"><header><strong>@CatalogService.Name(review.Product)</strong><span class="status-pill @(review.IsApproved?"":"off")">@Localizer[review.IsApproved?"Review_Published":"Review_Pending"]</span></header><p>★ @review.Rating / 5 · @review.DisplayName · @review.CreatedAt.ToString("g")</p><p class="description">@review.Text</p><form asp-action="ModerateReview" method="post" data-async-form><input type="hidden" name="id" value="@review.Id"/><input type="hidden" name="approved" value="@(review.IsApproved?"false":"true")"/><button>@Localizer[review.IsApproved?"Review_Hide":"Review_Approve"]</button></form></article>}
@if(!Model.Any()){<div class="panel empty">@Localizer["No_Reviews"]</div>}<div class="pagination">@if(page>1){<a asp-route-page="@(page-1)">@Localizer["Previous"]</a>}@if(page<pages){<a asp-route-page="@(page+1)">@Localizer["Next"]</a>}</div>
