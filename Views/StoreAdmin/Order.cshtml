@model Order
@{
    ViewData["Title"] = Model.OrderNumber;
    var attempt = ViewData["Attempt"] as PaymentAttempt;
    var emails = ViewData["Emails"] as IEnumerable<OrderEmail> ?? [];
    var isPaid = Model.PaymentStatus is "Paid" or "Overpaid";
    var isUnpaidWarn = Model.PaymentStatus is "Unpaid" or "Underpaid";
}

<section class="panel admin-order-hero">
    <div class="admin-order-hero-top">
        <div class="admin-order-hero-info">
            <span class="eyebrow">Chic &amp; Unique · @Localizer["Operations"]</span>
            <div class="admin-order-title-row">
                <h1 dir="ltr">@Model.OrderNumber</h1>
                <div class="admin-order-badges">
                    <span class="status-pill @(OrderStatusPresentation.IsWarning(Model) ? "off" : "")">@Localizer[OrderStatusPresentation.Key(Model)]</span>
                    <span class="status-pill @(isUnpaidWarn ? "off" : "")">@Localizer[Model.PaymentStatus]</span>
                </div>
            </div>
            <p class="muted admin-order-date">@Model.CreatedAt.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture)</p>
        </div>
        <div class="admin-order-hero-actions">
            <a class="action-link" asp-controller="Orders" asp-action="Track" asp-route-token="@Model.PaymentAccessToken" target="_blank" rel="noopener">
                @Localizer["Track_Order"] →
            </a>
            <a class="action-link" asp-action="Index">← @Localizer["Orders"]</a>
        </div>
    </div>
</section>

<div class="admin-order-layout">
    <div class="admin-order-main">
        <section class="panel">
            <div class="admin-card-head">
                <span class="admin-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <h2>@Localizer["Customer_Details"]</h2>
            </div>
            <div class="admin-facts-grid">
                <div class="admin-fact-tile">
                    <small>@Localizer["CustomerName"]</small>
                    <strong>@Model.CustomerName</strong>
                </div>
                <div class="admin-fact-tile">
                    <small>@Localizer["Email"]</small>
                    <strong dir="ltr">@Model.CustomerEmail</strong>
                </div>
                <div class="admin-fact-tile">
                    <small>@Localizer["CustomerPhone"]</small>
                    <strong dir="ltr">@Model.CustomerPhone</strong>
                </div>
                <div class="admin-fact-tile">
                    <small>@Localizer["InstaPay_Username"]</small>
                    <strong dir="ltr">@(string.IsNullOrWhiteSpace(Model.InstaPaySenderHandle) ? "—" : Model.InstaPaySenderHandle)</strong>
                </div>
                <div class="admin-fact-tile">
                    <small>@Localizer["Shipping_Area"]</small>
                    <strong>@Model.ShippingMethodName</strong>
                </div>
                <div class="admin-fact-tile">
                    <small>@Localizer["ShippingAddress"]</small>
                    <strong>@Model.ShippingAddress</strong>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="admin-card-head">
                <span class="admin-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </span>
                <h2>@Localizer["Products"]</h2>
            </div>
            <div class="admin-order-items">
                @foreach (var item in Model.Items)
                {
                    <div class="admin-order-item-row">
                        <div class="admin-order-item-info">
                            <strong>@item.ProductName</strong>
                            <div class="admin-item-meta">
                                @if (!string.IsNullOrWhiteSpace(item.SelectedSize))
                                {
                                    <span class="admin-meta-pill">@item.SelectedSize</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.SelectedColor))
                                {
                                    <span class="admin-meta-pill">@item.SelectedColor</span>
                                }
                                <span class="admin-meta-pill">×@item.Quantity</span>
                            </div>
                        </div>
                        <strong class="admin-item-price" dir="ltr">@((item.UnitPrice * item.Quantity).ToString("N2")) EGP</strong>
                    </div>
                }
            </div>
            <div class="admin-order-summary">
                <div class="admin-summary-row">
                    <span>@Localizer["Shipping_Fee"]</span>
                    <strong dir="ltr">@Model.ShippingFee.ToString("N2") EGP</strong>
                </div>
                @if (Model.WalletAmountUsed > 0)
                {
                    <div class="admin-summary-row">
                        <span>@Localizer["Wallet_Credit_Applied"]</span>
                        <strong dir="ltr">−@Model.WalletAmountUsed.ToString("N2") EGP</strong>
                    </div>
                }
                @if (Model.DetectedAmountEgp.HasValue)
                {
                    <div class="admin-summary-row">
                        <span>@Localizer["Detected_Transfer"]</span>
                        <strong dir="ltr">@Model.DetectedAmountEgp.Value.ToString("N2") EGP</strong>
                    </div>
                }
                <div class="admin-summary-row admin-order-grand">
                    <span>@Localizer["Total"]</span>
                    <strong dir="ltr">@Model.TotalAmount.ToString("N2") EGP</strong>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="admin-card-head">
                <span class="admin-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
                <h2>@Localizer["Order_Timeline"]</h2>
            </div>
            <ol class="timeline">
                @foreach (var update in Model.Updates.OrderBy(u => u.CreatedAt))
                {
                    <li>
                        <strong>@Localizer[update.Status]</strong>
                        <time dir="ltr">@update.CreatedAt.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture)</time>
                    </li>
                }
            </ol>
        </section>
    </div>

    <aside class="order-action-stack">
        @if (isPaid && !Model.NeedsPaymentReview && Model.Status == OrderStatuses.Shipped)
        {
            <section class="panel admin-action-card is-highlight">
                <div class="admin-card-head">
                    <span class="admin-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <h2>@Localizer["Mark_Delivered"]</h2>
                </div>
                <form asp-action="Deliver" method="post" data-async-form>
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="primary-button admin-btn-full">@Localizer["Mark_Delivered"]</button>
                </form>
            </section>
        }

        <section class="panel admin-action-card">
            <div class="admin-card-head">
                <span class="admin-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </span>
                <h2>@Localizer["Payment_Review"]</h2>
            </div>
            <div class="admin-gateway-row">
                <span class="muted">@Localizer["Gateway_Status"]</span>
                <span class="status-pill" dir="ltr">@(attempt?.GatewayStatus ?? "—")</span>
            </div>
            <form asp-action="Reconcile" method="post" data-async-form>
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="action-link admin-btn-full">@Localizer["Payment_Check"]</button>
            </form>
        </section>

        @if (isPaid && !Model.NeedsPaymentReview && (Model.Status is OrderStatuses.Processing or OrderStatuses.Shipped))
        {
            <section class="panel admin-action-card">
                <div class="admin-card-head">
                    <span class="admin-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    </span>
                    <h2>@Localizer["Dispatch"]</h2>
                </div>
                <form asp-action="Dispatch" method="post" data-async-form>
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>@Localizer["Carrier"]</label>
                    <input name="carrier" value="@Model.Carrier" required maxlength="100" />
                    <label>@Localizer["Tracking_Number"]</label>
                    <input name="trackingNumber" value="@Model.TrackingNumber" required maxlength="100" dir="ltr" />
                    <label>@Localizer["Carrier_Tracking"]</label>
                    <input name="trackingUrl" value="@Model.TrackingUrl" type="url" dir="ltr" />
                    <button class="primary-button admin-btn-full">@Localizer["Dispatch"]</button>
                </form>
            </section>
        }

        @if (Model.PaymentStatus == "Unpaid" && Model.Status != OrderStatuses.Cancelled)
        {
            <section class="panel admin-action-card is-danger">
                <div class="admin-card-head">
                    <span class="admin-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    </span>
                    <h2>@Localizer["Cancel_Restock"]</h2>
                </div>
                <form asp-action="Cancel" method="post" data-async-form>
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>@Localizer["Review_Reason"]</label>
                    <input name="reason" maxlength="200" required />
                    <label class="check-line">
                        <input type="checkbox" name="reviewed" value="true" required />
                        <span>@Localizer["Review_Confirmed"]</span>
                    </label>
                    <button class="action-link danger admin-btn-full">@Localizer["Cancel_Restock"]</button>
                </form>
            </section>
        }

        @if (isPaid)
        {
            <section class="panel admin-action-card is-danger">
                <div class="admin-card-head">
                    <span class="admin-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                    </span>
                    <h2>@Localizer["Record_Refund"]</h2>
                </div>
                <form asp-action="Refund" method="post" data-async-form>
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>@Localizer["Refund_Reference"]</label>
                    <input name="reference" maxlength="200" required />
                    <label class="check-line">
                        <input type="checkbox" name="restock" value="true" />
                        <span>@Localizer["Restock"]</span>
                    </label>
                    <label class="check-line">
                        <input type="checkbox" name="confirmed" value="true" required />
                        <span>@Localizer["Refund_Confirmed"]</span>
                    </label>
                    <button class="action-link danger admin-btn-full">@Localizer["Record_Refund"]</button>
                </form>
            </section>
        }

        <section class="panel admin-action-card">
            <div class="admin-card-head">
                <span class="admin-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </span>
                <h2>@Localizer["Order_Emails"]</h2>
            </div>
            <div class="admin-email-list">
                @foreach (var email in emails)
                {
                    <div class="admin-email-row">
                        <div class="admin-email-info">
                            <span class="admin-email-dot @(email.SentAt.HasValue ? "is-sent" : "is-pending")" aria-hidden="true"></span>
                            <div>
                                <strong>@Localizer[email.Kind]</strong>
                                <small dir="ltr">@(email.SentAt?.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture) ?? email.LastError ?? "Pending")</small>
                            </div>
                        </div>
                        @if (email.SentAt is null)
                        {
                            <form asp-action="RetryEmail" method="post" data-async-form>
                                <input type="hidden" name="id" value="@email.Id" />
                                <button class="action-link">@Localizer["Retry"]</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </section>
    </aside>
</div>
