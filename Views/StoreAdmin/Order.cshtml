@model Order
@{ViewData["Title"] = Model.OrderNumber; var attempt=ViewData["Attempt"] as PaymentAttempt; var emails=ViewData["Emails"] as IEnumerable<OrderEmail> ?? [];}
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Operations"]</span><h1>@Model.OrderNumber</h1><p class="muted">@Model.CreatedAt.ToString("f")</p></div><a class="action-link" asp-action="Index">← @Localizer["Orders"]</a></div>
<div class="order-state-strip"><span class="status-pill @(Model.Status==OrderStatuses.Cancelled?"off":"")">@Localizer[Model.Status]</span><span class="status-pill @(Model.PaymentStatus=="Unpaid"?"off":"")">@Localizer[Model.PaymentStatus]</span>@if(Model.NeedsPaymentReview){<strong class="status-pill off">@Localizer["Payment_Review"]</strong>}</div>
<div class="admin-order-layout"><div>
<section class="panel"><h2>@Localizer["CustomerName"]</h2><div class="order-facts"><div><small>@Localizer["CustomerName"]</small><strong>@Model.CustomerName</strong></div><div><small>@Localizer["Email"]</small><strong>@Model.CustomerEmail</strong></div><div><small>@Localizer["CustomerPhone"]</small><strong dir="ltr">@Model.CustomerPhone</strong></div><div><small>@Localizer["ShippingAddress"]</small><strong>@Model.ShippingAddress</strong></div><div><small>@Localizer["Shipping_Area"]</small><strong>@Model.ShippingMethodName</strong></div><div><small>@Localizer["InstaPay_Username"]</small><strong dir="ltr">@Model.InstaPaySenderHandle</strong></div></div></section>
<section class="panel"><h2>@Localizer["Products"]</h2><div class="order-items">@foreach(var item in Model.Items){<div><span>@item.ProductName <small>@item.SelectedSize @item.SelectedColor · ×@item.Quantity</small></span><strong>@((item.UnitPrice*item.Quantity).ToString("N2")) EGP</strong></div>}</div><div class="order-total-row"><span>@Localizer["Shipping_Fee"]</span><strong>@Model.ShippingFee.ToString("N2") EGP</strong></div><div class="order-total-row grand"><span>@Localizer["Total"]</span><strong>@Model.TotalAmount.ToString("N2") EGP</strong></div></section>
<section class="panel"><h2>@Localizer["Order_Timeline"]</h2><ol class="timeline">@foreach(var update in Model.Updates.OrderBy(u=>u.CreatedAt)){<li><strong>@Localizer[update.Status]</strong><time>@update.CreatedAt.ToString("g")</time></li>}</ol><a asp-controller="Orders" asp-action="Track" asp-route-token="@Model.PaymentAccessToken">@Localizer["Track_Order"] →</a></section>
</div><aside class="order-action-stack"><section class="panel"><h2>@Localizer["Payment_Review"]</h2><p class="muted">@Localizer["Gateway_Status"]: <strong>@(attempt?.GatewayStatus ?? "—")</strong></p><form asp-action="Reconcile" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="action-link">@Localizer["Payment_Check"]</button></form></section>
@if(Model.PaymentStatus=="Paid"&&!Model.NeedsPaymentReview&&(Model.Status is OrderStatuses.Processing or OrderStatuses.Shipped)){<section class="panel"><h2>@Localizer["Dispatch"]</h2><form asp-action="Dispatch" method="post"><input type="hidden" name="id" value="@Model.Id"/><label>@Localizer["Carrier"]</label><input name="carrier" value="@Model.Carrier" required maxlength="100"/><label>@Localizer["Tracking_Number"]</label><input name="trackingNumber" value="@Model.TrackingNumber" required maxlength="100"/><label>@Localizer["Carrier_Tracking"]</label><input name="trackingUrl" value="@Model.TrackingUrl" type="url"/><button class="primary-button">@Localizer["Dispatch"]</button></form></section>}
@if(Model.PaymentStatus=="Unpaid"&&Model.Status!=OrderStatuses.Cancelled){<section class="panel"><h2>@Localizer["Cancel_Restock"]</h2><form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@Model.Id"/><label>@Localizer["Review_Reason"]</label><input name="reason" maxlength="200" required/><label class="check-line"><input type="checkbox" name="reviewed" value="true" required/>@Localizer["Review_Confirmed"]</label><button class="action-link danger">@Localizer["Cancel_Restock"]</button></form></section>}
@if(Model.PaymentStatus=="Paid"){<section class="panel"><h2>@Localizer["Record_Refund"]</h2><form asp-action="Refund" method="post"><input type="hidden" name="id" value="@Model.Id"/><label>@Localizer["Refund_Reference"]</label><input name="reference" maxlength="200" required/><label class="check-line"><input type="checkbox" name="restock" value="true"/>@Localizer["Restock"]</label><label class="check-line"><input type="checkbox" name="confirmed" value="true" required/>@Localizer["Refund_Confirmed"]</label><button class="action-link danger">@Localizer["Record_Refund"]</button></form></section>}
<section class="panel"><h2>@Localizer["Order_Emails"]</h2>@foreach(var email in emails){<div class="email-record"><span><strong>@Localizer[email.Kind]</strong><small>@(email.SentAt?.ToString("g")??email.LastError??"Pending")</small></span>@if(email.SentAt is null){<form asp-action="RetryEmail" method="post"><input type="hidden" name="id" value="@email.Id"/><button class="action-link">@Localizer["Retry"]</button></form>}</div>}</section></aside></div>
