@model OperationsViewModel
@{ViewData["Title"] = Localizer["Operations"];}
<div class="section-head"><div><span class="eyebrow">NileShop · @Localizer["Admin_Navigation"]</span><h1>@Localizer["Operations"]</h1><p class="muted">@Localizer["Shortcut_Orders"]</p></div><a class="action-link" asp-controller="Admin" asp-action="Dashboard">← @Localizer["Nav_Dashboard"]</a></div>
<div class="kpis operations-kpis"><div class="panel"><small>@Localizer["Pending_Emails"]</small><h2>@Model.PendingEmails</h2></div><div class="panel"><small>@Localizer["Failed_Emails"]</small><h2>@Model.FailedEmails</h2></div><div class="panel"><small>@Localizer["Email_Settings"]</small><h2 class="kpi-state">@Localizer[Model.EmailConfigured?"SMTP_Ready":"SMTP_Missing"]</h2></div></div>
<section><div class="section-head"><div><h2>@Localizer["Orders"]</h2><p class="muted">@Localizer["Orders_Intro"]</p></div></div><form method="get" class="panel operation-filters" data-async-form><div class="field"><label for="order-search">@Localizer["Search_Orders"]</label><input id="order-search" name="q" value="@Model.Search" maxlength="100" placeholder="@Localizer["Search_Orders"]"/></div><div class="field"><label for="order-status">@Localizer["Status"]</label><select id="order-status" name="status"><option value="">@Localizer["All_Order_States"]</option>@foreach(var status in new[]{"review","Paid","Overpaid","Underpaid","Unpaid","Refunded","AwaitingPayment","Incomplete","Expired","PaymentFailed","PaymentCancelled","Processing","Shipped","Cancelled"}){<option value="@status" selected="@(Model.Status==status)">@Localizer[status=="Expired"?"Order_Payment_Expired":status=="PaymentFailed"?"Order_Payment_Failed":status=="PaymentCancelled"?"Order_Payment_Cancelled":status=="Incomplete"?"Order_Checkout_Incomplete":status=="AwaitingPayment"?"Order_Awaiting_Payment":status]</option>}</select></div><button class="primary-button">@Localizer["Filter_Orders"]</button></form><div tabindex="0" role="region" aria-label="@Localizer["Scrollable_Table"]" class="table-scroll admin-data-table"><table><thead><tr><th>@Localizer["Orders"]</th><th>@Localizer["CustomerName"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th><th></th></tr></thead><tbody>@foreach(var order in Model.Orders){<tr><td><a class="record-link" asp-action="Order" asp-route-id="@order.Id">@order.OrderNumber</a><small class="table-subline">@order.CreatedAt.ToString("g")</small></td><td>@order.CustomerName<small class="table-subline">@order.CustomerEmail</small></td><td class="money">@order.TotalAmount.ToString("N2") <small>EGP</small></td><td><span class="status-pill @(OrderStatusPresentation.IsWarning(order)?"off":"")">@Localizer[OrderStatusPresentation.Key(order)]</span><small class="table-subline">@Localizer[order.PaymentStatus]</small></td><td><a class="action-link" asp-action="Order" asp-route-id="@order.Id">@Localizer["Details"] →</a></td></tr>}</tbody></table>@if(!Model.Orders.Any()){<div class="admin-empty">@Localizer["Empty"]</div>}</div><div class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Search" asp-route-status="@Model.Status">@Localizer["Previous"]</a>}@if(Model.Page<Model.TotalPages){<a asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Search" asp-route-status="@Model.Status">@Localizer["Next"]</a>}</div></section>
<section><div class="section-head"><div><h2>@Localizer["LowStock"]</h2><p class="muted">@Localizer["LowStock_Intro"]</p></div></div><div class="low-stock-grid">@foreach(var product in Model.LowStock){<a class="low-stock-card" asp-controller="Admin" asp-action="EditProduct" asp-route-id="@product.Id"><img src="@(product.ImageUrl??"/assets/img/product-placeholder.svg")" alt=""/><strong>@CatalogService.Name(product)</strong><span class="inventory-pill low-stock">@product.StockQuantity @Localizer[product.StockQuantity==1?"Item":"Items"]</span></a>}@if(!Model.LowStock.Any()){<p class="panel muted">@Localizer["No_Low_Stock"]</p>}</div></section>
