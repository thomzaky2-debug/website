@page
@model BubbleThemeShop.Areas.Identity.Pages.Account.LoginModel
<div class="login panel"><h1>@Localizer["Nav_Login"]</h1><form method="post"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="ReturnUrl"/><label asp-for="Email">@Localizer["CustomerEmail"]</label><input asp-for="Email" autocomplete="username"/><label asp-for="Password">@Localizer["Password"]</label><input asp-for="Password" autocomplete="current-password"/><button class="primary-button">@Localizer["Login"]</button></form></div>
