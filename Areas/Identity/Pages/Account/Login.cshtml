@page
@model NileShop.Areas.Identity.Pages.Account.LoginModel
<div class="login-page"><span class="eyebrow">NileShop · @Localizer["Admin_Navigation"]</span><div class="login panel"><h1>@Localizer["Nav_Login"]</h1><p class="muted">@Localizer["Admin_Login_Intro"]</p><form method="post"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="ReturnUrl"/><label asp-for="Email">@Localizer["CustomerEmail"]</label><input asp-for="Email" autocomplete="username"/><label asp-for="Password">@Localizer["Password"]</label><input asp-for="Password" autocomplete="current-password"/><button class="primary-button">@Localizer["Login"]</button></form><p class="account-switch"><a asp-area="" asp-controller="PasswordRecovery" asp-action="Forgot">@Localizer["Recovery_Forgot"]</a></p></div></div>
